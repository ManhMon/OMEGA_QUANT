at]]],\n1300:         method: str = \"validation_ic\",\n1301:     ) -> Optional[pd.Series]:\n1302:         \"\"\"Blend signals from multiple horizons using quality-based weights.\n1303:         \n1304:         P10: Combines horizon-specific signals into a single blended signal.\n1305:         \n1306:         Parameters\n1307:         ----------\n1308:         horizon_results : dict\n1309:             Mapping of horizon -> (signal, quality_metrics).\n1310:             signal is a pd.Series, quality_metrics is a dict with 'train_ic', 'validation_ic', etc.\n1311:         method : str\n1312:             Weight computation method ('validation_ic' or 'train_ic')\n1313:             \n1314:         Returns\n1315:         -------\n1316:         pd.Series or None\n1317:             Blended signal (same index as input signals), or None if all horizons have\n1318:             non-positive quality (triggering fallback to baseline)\n1319:             \n1320:         Notes\n1321:         -----\n1322:         PIT Safety: quality_metrics must be computed from train/validation only,\n1323:         never from test period. Caller is responsible for ensuring this.\n1324:         \n1325:         FIX 4: Negative or zero quality => weight 0 (no abs() weighting).\n1326:         If all horizons have non-positive quality, returns None to trigger fallback.\n1327:         If only one horizon succeeds, returns that signal directly.\n1328:         \"\"\"\n1329:         logger.info(f\"[P10] Blending {len(horizon_results)} horizon signals using method={method}\")\n1330:         \n1331:         # Validate method parameter\n1332:         valid_methods = ['validation_ic', 'train_ic']\n1333:         if method not in valid_methods:\n1334:             logger.warning(f\"[P10] Invalid blend_weight_method='{method}', defaulting to 'validation_ic'\")\n1335:             method = 'validation_ic'\n1336:         \n1337:         # Filter out failed horizons (None signal or missing quality metrics)\n1338:         valid_horizons = {}\n1339:         for h, (sig, qual_dict) in horizon_results.items():\n1340:             if sig is None or qual_dict is None:\n1341:                 continue\n1342:             if not isinstance(qual_dict, dict):\n1343:                 logger.warning(f\"[P10] Horizon {h} has invalid quality_metrics type, skipping\")\n1344:                 continue\n1345:             valid_horizons[h] = (sig, qual_dict)\n1346:         \n1347:         if len(valid_horizons) == 0:\n1348:             logger.error(\"[P10] All horizons failed, returning None to trigger fallback\")\n1349:             return None\n1350:         \n1351:         # FIX P10 Role21 Re-Audit: Single horizon must also pass non-positive quality check\n1352:         if len(valid_horizons) == 1:\n1353:             h, (sig, qual_dict) = list(valid_horizons.items())[0]\n1354:             quality_val = qual_dict.get(method, 0.0)\n1355:             if quality_val <= 0:\n1356:                 logger.warning(\n1357:                     f\"[P10] Only horizon {h} succeeded but {method}={quality_val:.4f} is non-positive, \"\n1358:                     \"returning None to trigger fallback to baseline\"\n1359:                 )\n1360:                 return None\n1361:             logger.info(f\"[P10] Only horizon {h} succeeded, using it directly ({method}={quality_val:.4f})\")\n1362:             return sig\n1363:         \n1364:         # FIX 1 & 4: Extract quality metrics using specified method\n1365:         # Use signed quality - negative IC => weight 0\n1366:         qualities = []\n1367:         for h, (sig, qual_dict) in valid_horizons.items():\n1368:             quality_val = qual_dict.get(method, 0.0)\n1369:             # FIX 4: Negative or zero quality => 0 weight (no abs())\n1370:             if quality_val <= 0:\n1371:                 quality_val = 0.0\n1372:                 logger.info(f\"[P10] Horizon {h}: {method}={qual_dict.get(method, 0.0):.4f} (non-positive, weight=0)\")\n1373:             qualities.append(quality_val)\n1374:         \n1375:         qualities = np.array(qualities)\n1376:         \n1377:         # FIX 4: If all qualities are non-positive, return None to trigger fallback\n1378:         if qualities.sum() <= 1e-9:\n1379:             logger.warning(\n1380:                 f\"[P10] All quality metrics non-positive using method={method}, \"\n1381:                 \"returning None to trigger fallback to baseline\"\n1382:             )\n1383:             return None\n1384:         \n1385:         # Normalize weights to sum to 1 (only positive qualities remain)\n1386:         weights = qualities / qualities.sum()\n1387:         \n1388:         # Blend signals\n1389:         signals = [sig for _, (sig, _) in valid_horizons.items()]\n1390:         horizons_list = list(valid_horizons.keys())\n1391:         \n1392:         # Align all signals to same index (use first signal's index as reference)\n1393:         ref_index = signals[0].index\n1394:         blended = pd.Series(0.0, index=ref_index)\n1395:         \n1396:         for i, (h, weight) in enumerate(zip(horizons_list, weights)):\n1397:             sig = signals[i].reindex(ref_index, fill_value=0.0)\n1398:             blended += weight * sig\n1399:             qual_dict = valid_horizons[h][1]\n1400:             logger.info(\n1401:                 f\"[P10] Horizon {h}: weight={weight:.4f}, \"\n1402:                 f\"{method}={qual_dict.get(method, 0.0):.4f}\"\n1403:             )\n1404:         \n1405:         logger.info(f\"[P10] Blend complete: {len([w for w in weights if w > 0])} horizons combined\")\n1406:         return blended\n1407: \n1408:     def run_fold(\n1409:         self,\n1410:         fold_id: int,\n1411:         train_df: pd.DataFrame,\n1412:         test_df: pd.DataFrame,\n1413:         alpha_cols: List[str],\n1414:         return_col: str = 'fwd_ret_5',\n1415:         cost_aware: bool | None = None,\n1416:     ) -> FoldMetrics:\n1417:         \"\"\"Run single walk-forward fold.\n1418:         \n1419:         Parameters\n1420:         ----------\n1421:         fold_id : int\n1422:             Fold identifier\n1423:         train_df : pd.DataFrame\n1424:             Training data\n1425:         test_df : pd.DataFrame\n1426:             Testing data\n1427:         alpha_cols : list of str\n1428:             Alpha column names\n1429:         return_col : str\n1430:             Forward return column name\n1431:         cost_aware : bool, optional\n1432:             If True, cost-aware alpha selection is enabled for this fold.\n1433:             If None, uses self.cost_aware.\n1434:         \n1435:         Returns\n1436:         -------\n1437:         FoldMetrics\n1438:             Fold results\n1439:         \n1440:         Notes\n1441:         -----\n1442:         Embargo logic (PIT Safety): For a return_col of the form 'fwd_ret_N',\n1443:         the last N rows per symbol are dropped from train_df before IC\n1444:         computation and alpha selection. This prevents label leakage where\n1445:         the forward return window of the final training rows overlaps with\n1446:         the test period. Alpha computation (feature generation) uses the\n1447:         full train_df so that indicators at the boundary are not distorted.\n1448:         \"\"\"\n1449:         logger.info(f\"Running fold {fold_id}\")\n1450: \n1451:         if cost_aware is None:\n1452:             cost_aware = self.cost_aware\n1453:         \n1454:         # Compute alphas on train (full train_df — no embargo yet)\n1455:         train_df = self.compute_alphas(train_df)\n1456: \n1457:         # --- Cold-start fix: prepend train tail to test_df for alpha computation ---\n1458:         # Phase34 uses rolling windows (5, 10, 20 bars). Without train history,\n1459:         # the first ~20 test days get NaN/zero-fill distortion.\n1460:         # PIT safe: we only prepend already-embargoed train data, then strip it back.\n1461:         warmup_n = 30  # rows per symbol to prepend (covers max rolling window)\n1462:         train_tail = (\n1463:             train_df\n1464:             .groupby('ticker', group_keys=False)\n1465:             .tail(warmup_n)\n1466:             .copy()\n1467:         )\n1468:         # Mark original test rows so we can strip warmup back after alpha computation\n1469:         is_test_mask = pd.Series(True, index=test_df.index)\n1470:         test_df = test_df.copy()\n1471:         test_df['_is_test'] = True\n1472:         test_with_warmup = pd.concat([train_tail, test_df], ignore_index=True)\n1473:         test_with_warmup = test_with_warmup.sort_values(\n1474:             ['ticker', 'date'], ignore_index=True\n1475:         )\n1476:         test_with_warmup = self.compute_alphas(test_with_warmup)\n1477:         # Strip warmup rows — keep only original test rows\n1478:         keep_mask = test_with_warmup['_is_test'].fillna(False).astype(bool)\n1479:         test_df = (\n1480:             test_with_warmup.loc[keep_mask]\n1481:             .drop(columns=['_is_test'], errors='ignore')\n1482:             .reset_index(drop=True)\n1483:         )\n1484:         \n1485:         # ==============================================================================\n1486:         # P10: Multi-Horizon Blending Path (opt-in)\n1487:         # ==============================================================================\n1488:         if self.multi_horizon_blend:\n1489:             logger.info(\n1490:                 f\"[P10] Fold {fold_id}: Multi-horizon blending enabled, \"\n1491:                 f\"horizons={self.blend_horizons}, method={self.blend_weight_method}\"\n1492:             )\n1493:             \n1494:             horizon_results = {}\n1495:             horizon_details = {}\n1496:             \n1497:             # Compute signal for each horizon independently\n1498:             for horizon in self.blend_horizons:\n1499:                 horizon_return_col = f'fwd_ret_{horizon}'\n1500:                 \n1501:                 # FIX 1, 2, 5: Updated signature with quality_metrics dict and final_objective_return_col\n1502:                 signal, quality_metrics, gated, gate_res = self._compute_horizon_signal(\n1503:                     fold_id=fold_id,\n1504:                     train_df=train_df,\n1505:                     test_df=test_df,\n1506:                     alpha_cols=alpha_cols,\n1507:                     return_col=horizon_return_col,\n1508:                     horizon=horizon,\n1509:                     cost_aware=cost_aware,\n1510:                     final_objective_return_col=return_col,  # FIX 5: final objective alignment\n1511:                 )\n1512:                 \n1513:                 if signal is not None:\n1514:                     horizon_results[horizon] = (signal, quality_metrics)\n1515:                     # FIX 6: Store comprehensive diagnostics\n1516:                     horizon_details[horizon] = {\n1517:                         'gated_alphas': gated,\n1518:                         'gate_results': gate_res,\n1519:                         'quality_metrics': quality_metrics,\n1520:                         'horizon_return_col': horizon_return_col,\n1521:                         'included': True,\n1522:                     }\n1523:                 else:\n1524:                     # FIX 6: Track excluded horizons in diagnostics\n1525:                     horizon_details[horizon] = {\n1526:                         'gated_alphas': [],\n1527:                         'gate_results': gate_res,\n1528:                         'quality_metrics': quality_metrics,\n1529:                         'horizon_return_col': horizon_return_col,\n1530:                         'included': False,\n1531:                         'exclusion_reason': 'gate_failed_or_missing_data',\n1532:                     }\n1533:             \n1534:             # FIX 3: All-horizon failure fallback to single-horizon baseline\n1535:             portfolio_signal = None\n1536:             fallback_used = False\n1537:             fallback_reason = None\n1538:             \n1539:             if len(horizon_results) == 0:\n1540:                 fallback_reason = \"all_horizons_failed_or_missing\"\n1541:                 logger.warning(\n1542:                     f\"[P10] Fold {fold_id}: All requested horizons failed/missing. \"\n1543:                     f\"Falling back to single-horizon baseline using return_col={return_col}\"\n1544:                 )\n1545:                 fallback_used = True\n1546:             else:\n1547:                 # Attempt to blend\n1548:                 portfolio_signal = self._blend_horizon_signals(\n1549:                     horizon_results, method=self.blend_weight_method\n1550:                 )\n1551:                 \n1552:                 # FIX 3 & 4: If blend returns None (all non-positive quality), fallback\n1553:                 if portfolio_signal is None:\n1554:                     fallback_reason = \"all_quality_non_positive\"\n1555:                     logger.warning(\n1556:                         f\"[P10] Fold {fold_id}: Blend returned None (all quality non-positive). \"\n1557:                         f\"Falling back to single-horizon baseline using return_col={return_col}\"\n1558:                     )\n1559:                     fallback_used = True\n1560:             \n1561:             # FIX 3: Execute fallback to approved single-horizon baseline\n1562:             if fallback_used:\n1563:                 logger.info(\n1564:                     f\"[P10] Fold {fold_id}: Executing fallback to single-horizon baseline \"\n1565:                     f\"(return_col={return_col})\"\n1566:                 )\n1567:                 # Fall through to the standard single-horizon path below\n1568:                 # by setting multi_horizon_blend to False temporarily\n1569:                 self.multi_horizon_blend = False\n1570:                 # Recursively call run_fold with single-horizon mode\n1571:                 # (This ensures we use the exact same baseline logic)\n1572:                 result = self.run_fold(\n1573:                     fold_id=fold_id,\n1574:                     train_df=train_df,\n1575:                     test_df=test_df,\n1576:                     alpha_cols=alpha_cols,\n1577:                     return_col=return_col,\n1578:                     cost_aware=cost_aware,\n1579:                 )\n1580:                 # Restore multi_horizon_blend flag\n1581:                 self.multi_horizon_blend = True\n1582:                 # Add fallback diagnostic to result\n1583:                 # (FoldMetrics doesn't have a diagnostics field, so log it)\n1584:                 logger.info(\n1585:                     f\"[P10] Fold {fold_id}: Fallback complete. \"\n1586:                     f\"Reason: {fallback_reason}, \"\n1587:                     f\"Requested horizons: {self.blend_horizons}, \"\n1588:                     f\"Successful horizons: {list(horizon_results.keys())}\"\n1589:                 )\n1590:                 return result\n1591:             \n1592:             # Normal multi-horizon path (blend succeeded)\n1593:             # For FoldMetrics reporting: use first successful horizon's details\n1594:             # (FoldMetrics doesn't yet support per-horizon reporting)\n1595:             first_horizon = list(horizon_details.keys())[0]\n1596:             gated_alphas = horizon_details[first_horizon]['gated_alphas']\n1597:             gate_results = horizon_details[first_horizon]['gate_results']\n1598:             \n1599:             # Compute raw signal IC using default return_col (for P9 comparison)\n1600:             raw_signal_ic = self.compute_ic(portfolio_signal, test_df[return_col])\n1601:             test_df_with_signal = test_df.copy()\n1602:             test_df_with_signal['_raw_signal'] = portfolio_signal\n1603:             raw_signal_daily_cs_ic = self.compute_daily_cs_ic(\n1604:                 test_df_with_signal, '_raw_signal', return_col\n1605:             )\n1606:             \n1607:             # FIX 6: Log comprehensive diagnostics\n1608:             logger.info(\n1609:                 f\"[P10] Fold {fold_id} multi-horizon diagnostics:\\n\"\n1610:                 f\"  Requested horizons: {self.blend_horizons}\\n\"\n1611:                 f\"  Included horizons: {[h for h, d in horizon_details.items() if d.get('included', False)]}\\n\"\n1612:                 f\"  Excluded horizons: {[h for h, d in horizon_details.items() if not d.get('included', True)]}\\n\"\n1613:                 f\"  Blend method: {self.blend_weight_method}\\n\"\n1614:                 f\"  Fallback used: {fallback_used}\"\n1615:             )\n1616:             for h, details in horizon_details.items():\n1617:                 if details.get('included', False):\n1618:                     qm = details['quality_metrics']\n1619:                     gate_passed = sum(1 for res in details['gate_results'].values() if _is_gate_verdict_pass(res.get('verdict')))\n1620:                     gate_total = len(details['gate_results'])\n1621:                     logger.info(\n1622:                         f\"  Horizon {h}: train_ic={qm.get('train_ic', 0):.4f}, \"\n1623:                         f\"val_ic={qm.get('validation_ic', 0):.4f}, \"\n1624:                         f\"final_obj_val_ic={qm.get('final_objective_validation_ic', 0):.4f}, \"\n1625:                         f\"gate={gate_passed}/{gate_total}\"\n1626:                     )\n1627:             \n1628:             logger.info(\n1629:                 f\"[P10] Fold {fold_id} multi-horizon raw signal: \"\n1630:                 f\"IC={raw_signal_ic:.4f}, daily_cs_ic={raw_signal_daily_cs_ic:.4f}\"\n1631:             )\n1632:             \n1633:             # Note: XGBoost and evolved signal are disabled in multi-horizon mode\n1634:             # to keep P10 implementation focused and avoid complexity\n1635:             \n1636:             # For metrics reporting: use train_df as train_df_clean\n1637:             # (embargo is applied per-horizon inside _compute_horizon_signal)\n1638:             train_df_clean = train_df\n1639:         \n1640:         else:\n1641:             # ==============================================================================\n1642:             # Original Single-Horizon Path (default behavior, unchanged)\n1643:             # ==============================================================================\n1644:         \n1645:             # --- Embargo: drop last h rows per symbol from IC/selection window ---\n1646:             # Extract horizon h from return_col name (e.g. 'fwd_ret_5' -> h=5).\n1647:             # Falls back to h=1 for unrecognised patterns.\n1648:             try:\n1649:                 h = int(return_col.split('_')[-1])\n1650:             except (ValueError, IndexError):\n1651:                 h = 1\n1652:                 logger.warning(\n1653:                     f\"Could not parse horizon from return_col='{return_col}'; \"\n1654:                     f\"defaulting embargo h={h}\"\n1655:                 )\n1656:             \n1657:             # Vectorized embargo: cumcount(ascending=False)==0 is the last row per symbol.\n1658:             # Keep only rows where tail_rank >= h (i.e. not in the last h rows).\n1659:             # This preserves all columns and is compatible with pandas 3.x.\n1660:             _tail_rank = train_df.groupby('ticker').cumcount(ascending=False)\n1661:             train_df_clean = train_df[_tail_rank >= h].reset_index(drop=True)\n1662:             logger.info(\n1663:                 f\"Fold {fold_id} embargo: h={h}, \"\n1664:                 f\"train rows before={len(train_df)}, after={len(train_df_clean)}\"\n1665:             )\n1666:             # Split train_df_clean into Train Actual and Validation dynamically (e.g. 2:1 ratio by unique dates)\n1667:             unique_dates = sorted(train_df_clean['date'].unique())\n1668:             if len(unique_dates) >= 3:\n1669:                 split_idx = int(len(unique_dates) * 2 / 3)\n1670:                 val_start_date = unique_dates[split_idx]\n1671:                 train_actual = train_df_clean[train_df_clean['date'] < val_start_date].reset_index(drop=True)\n1672:                 val_actual = train_df_clean[train_df_clean['date'] >= val_start_date].reset_index(drop=True)\n1673:             else:\n1674:                 train_actual = train_df_clean\n1675:                 val_actual = train_df_clean\n1676:                 \n1677:             logger.info(\n1678:                 f\"Fold {fold_id} validation split: \"\n1679:                 f\"train_actual={len(train_actual)} rows, val_actual={len(val_actual)} rows\"\n1680:             )\n1681:             \n1682:             # Compute IC on actual training set (no label leakage)\n1683:             train_ics = self.compute_alpha_ics(train_actual, alpha_cols, return_col)\n1684:             \n1685:             # Strategy filter: momentum only keeps positive IC alphas\n1686:             if hasattr(self, \"strategy\") and self.strategy == \"momentum\":\n1687:                 train_ics = {k: v for k, v in train_ics.items() if v > 0.0}\n1688:                 \n1689:             logger.info(f\"Fold {fold_id} train ICs (strategy={self.strategy}): {train_ics}\")\n1690: \n1691:             # Stage 6.2: Cost-aware alpha selection\n1692:             if cost_aware:\n1693:                 adjusted_ics = self.adjust_alphas_for_cost(\n1694:                     train_actual, alpha_cols, train_ics\n1695:                 )\n1696:                 top_alphas = self.select_top_alphas(adjusted_ics)\n1697:             else:\n1698:                 # Select top alphas based on train IC\n1699:                 top_alphas = self.select_top_alphas(train_ics)\n1700: \n1701:             # ------------------------------------------------------------------\n1702:             # Stage 3 ML Gate: filter top_alphas through Research Gate\n1703:             # Uses validation set (val_actual) — PIT safe, no look-ahead.\n1704:             # ------------------------------------------------------------------\n1705:             gated_alphas, gate_results = self.validate_alpha_with_research_gate(\n1706:                 top_alphas=top_alphas,\n1707:                 train_ics=train_ics,\n1708:                 train_df_clean=val_actual,\n1709:                 return_col=return_col,\n1710:             )\n1711: \n1712:             # ------------------------------------------------------------------\n1713:             # Stage 4: optional XGBoost path (use_xgboost=True) vs baseline\n1714:             # Baseline: IC-weighted signal from gated alphas (unchanged).\n1715:             # XGBoost: train XGBoostAlphaEnsemble on train_actual MultiIndex,\n1716:             #          predict on test_df MultiIndex, standardize to portfolio_signal.\n1717:             # PIT Safety: ensemble trains only on embargoed train_actual.\n1718:             # ------------------------------------------------------------------\n1719:             if self.use_xgboost and len(train_actual) > 0 and len(gated_alphas) > 0:\n1720:                 try:\n1721:                     # Convert flat ['date','ticker'] -> MultiIndex ['date','symbol']\n1722:                     X_train_multi = (\n1723:                         train_actual\n1724:                         .set_index(['date', 'ticker'])\n1725:                         .rename_axis(index={'ticker': 'symbol'})\n1726:                     )\n1727:                     X_test_multi = (\n1728:                         test_df\n1729:                         .set_index(['date', 'ticker'])\n1730:                         .rename_axis(index={'ticker': 'symbol'})\n1731:                     )\n1732: \n1733:                     # Derive cutoff_date from max train date (embargo already applied)\n1734:                     cutoff_date = str(\n1735:                         train_df_clean['date'].max().date()\n1736:                         if hasattr(train_df_clean['date'].max(), 'date')\n1737:                         else train_df_clean['date'].max()\n1738:                     )\n1739: \n1740:                     ensemble = XGBoostAlphaEnsemble(min_ic_threshold=0.0)\n1741:                     ensemble.train(\n1742:                         X_train_multi,\n1743:                         gated_alphas,\n1744:                         cutoff_date=cutoff_date,\n1745:                         embargo_days=0,  # embargo already applied upstream\n1746:                     )\n1747:                     raw_preds = ensemble.predict(X_test_multi, gated_alphas)\n1748: \n1749:                     # Flatten MultiIndex predictions back to flat test_df index\n1750:                     # Align raw_preds (indexed by date, symbol) with test_df (columns date, ticker) to prevent drift\n1751:                     preds_df = raw_preds.reset_index().rename(columns={'symbol': 'ticker', 0: 'pred'})\n1752:                     merged = test_df[['date', 'ticker']].merge(preds_df, on=['date', 'ticker'], how='left')\n1753:                     preds_flat = merged['pred'].fillna(0.0).values\n1754:                     if len(preds_flat) == len(test_df):\n1755:                         preds_series = pd.Series(preds_flat, index=test_df.index)\n1756:                         # Standardize: zero-mean, unit-std per date cross-section\n1757:                         std_val = preds_series.std()\n1758:                         if std_val > 0:\n1759:                             portfolio_signal = (preds_series - preds_series.mean()) / std_val\n1760:                         else:\n1761:                             portfolio_signal = preds_series\n1762:                         logger.info(f\"Fold {fold_id}: XGBoost path active, signal std={std_val:.4f}\")\n1763:                     else:\n1764:                         logger.warning(\n1765:                             f\"Fold {fold_id}: XGBoost pred length mismatch \"\n1766:                             f\"({len(preds_flat)} vs {len(test_df)}), falling back to baseline\"\n1767:                         )\n1768:                         portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n1769:                 except Exception as e:\n1770:                     logger.warning(\n1771:                         f\"Fold {fold_id}: XGBoost path failed ({e}), falling back to baseline\"\n1772:                     )\n1773:                     portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n1774:             else:\n1775:                 # Baseline: IC-weighted signal (original path, fully preserved)\n1776:                 portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n1777: \n1778:             # ------------------------------------------------------------------\n1779:             # Evolved Alpha Blending (optional) with Adaptive Weight\n1780:             # If enable_evolved=True, run inline GP evolution on train_actual,\n1781:             # execute best tree on test_df, and blend with hand-crafted signal.\n1782:             # PIT Safety: evolution trains only on train_actual (embargoed).\n1783:             # Adaptive: blend weight scales with train_ic quality (cap at user weight).\n1784:             # ------------------------------------------------------------------\n1785:             if self.enable_evolved and len(train_actual) > 0:\n1786:                 evolved_signal, gp_train_ic = self._evolve_inline_signal(train_actual, test_df, return_col)\n1787:                 if evolved_signal is not None:\n1788:                     # Align evolved signal length with portfolio_signal\n1789:                     if len(evolved_signal) == len(portfolio_signal):\n1790:                         # Adaptive blend: scale weight by GP train quality\n1791:                         # w_adaptive = min(user_weight, abs(train_ic) * scale_factor)\n1792:                         # scale_factor=2 means IC=0.05 → weight=0.10, IC=0.10 → weight=0.20\n1793:                         abs_train_ic = abs(gp_train_ic)\n1794:                         scale_factor = 2.0\n1795:                         w_adaptive = min(self.evolved_blend_weight, abs_train_ic * scale_factor)\n1796:                         # P2: Ceiling protection - cap at 25% to prevent overfit\n1797:                         # Ensures hand-crafted signal dominates (≥75%)\n1798:                         ceiling = 0.25\n1799:                         w_evo = min(w_adaptive, ceiling)\n1800:                         # Floor: at least 10% of user weight to avoid zero contribution\n1801:                         w_evo = max(w_evo, self.evolved_blend_weight * 0.1)\n1802:                         w_hand = 1.0 - w_evo\n1803:                         portfolio_signal = pd.Series(\n1804:                             w_evo * evolved_signal + w_hand * portfolio_signal.values,\n1805:                             index=portfolio_signal.index\n1806:                         )\n1807:                         logger.info(\n1808:                             f\"Fold {fold_id}: Evolved signal blended \"\n1809:                             f\"(evolved={w_evo:.3f}, handcrafted={w_hand:.3f}, \"\n1810:                             f\"gp_train_ic={gp_train_ic:.4f}, adaptive=True)\"\n1811:                         )\n1812:                     else:\n1813:                         logger.warning(\n1814:                             f\"Fold {fold_id}: Evolved signal length mismatch \"\n1815:                             f\"({len(evolved_signal)} vs {len(portfolio_signal)}), skipping blend\"\n1816:                         )\n1817: \n1818:             # Strategy filter: mean reversion reverses signal direction\n1819:             if hasattr(self, \"strategy\") and self.strategy == \"mean_reversion\":\n1820:                 portfolio_signal = -portfolio_signal\n1821: \n1822:             # --- Fix 3+4: Raw signal IC (before Stage 2) + Z-score normalization ---\n1823:             # Apply cross-sectional z-score normalization to raw signal before blending\n1824:             # This prevents scale differences between alphas from dominating weights\n1825:             test_df_copy = test_df.copy()\n1826:             test_df_copy['_raw_signal'] = portfolio_signal\n1827:             # Z-score per date (cross-sectional)\n1828:             test_df_copy['_raw_signal'] = test_df_copy.groupby('date')['_raw_signal'].transform(\n1829:                 lambda x: (x - x.mean()) / (x.std() + 1e-9)\n1830:             )\n1831:             portfolio_signal = test_df_copy['_raw_signal']\n1832: \n1833:             # Compute raw signal IC (pre Stage 2) — this is the true predictive power\n1834:             raw_signal_ic = self.compute_ic(portfolio_signal, test_df[return_col])\n1835:             \n1836:             # Compute daily cross-sectional IC for raw signal (more robust metric)\n1837:             test_df_with_signal = test_df.copy()\n1838:             test_df_with_signal['_raw_signal'] = portfolio_signal\n1839:             raw_signal_daily_cs_ic = self.compute_daily_cs_ic(\n1840:                 test_df_with_signal, '_raw_signal', return_col\n1841:             )\n1842:             \n1843:             logger.info(\n1844:                 f\"Fold {fold_id} raw signal IC: {raw_signal_ic:.4f}, \"\n1845:                 f\"daily CS IC: {raw_signal_daily_cs_ic:.4f}\"\n1846:             )\n1847:         \n1848:         # ==============================================================================\n1849:         # Both paths converge here: Stage 2 constraints apply to both single-horizon\n1850:         # and multi-horizon signals\n1851:         # ==============================================================================\n1852: \n1853:         # ------------------------------------------------------------------\n1854:         # Stage 2 behavioral enforcement (top-N, rebalance cadence, sector cap)\n1855:         # Applied AFTER IC-weighted signal combination, BEFORE return computation.\n1856:         # PIT safety preserved: test_df signals are already T-1 lagged upstream.\n1857:         # ------------------------------------------------------------------\n1858:         try:\n1859:             portfolio_signal = self._apply_stage2_constraints(\n1860:                 test_df=test_df,\n1861:                 raw_signal=portfolio_signal,\n1862:                 top_alphas=gated_alphas,\n1863:                 dynamic_rebalance=True,\n1864:                 train_df=train_df,\n1865:             )\n1866:         except TypeError as exc:\n1867:             if \"unexpected keyword argument\" not in str(exc):\n1868:                 raise\n1869:             # Backward-compatible path for tests or external monkeypatches that\n1870:             # still expose the original 3-argument Stage 2 hook signature.\n1871:             logger.warning(\n1872:                 \"Stage 2 constraints hook does not accept P9 kwargs; \"\n1873:                 \"falling back to legacy call signature\"\n1874:             )\n1875:             portfolio_signal = self._apply_stage2_constraints(\n1876:                 test_df=test_df,\n1877:                 raw_signal=portfolio_signal,\n1878:                 top_alphas=gated_alphas,\n1879:             )\n1880: \n1881:         # Compute test IC for each alpha\n1882:         test_ics = self.compute_alpha_ics(test_df, alpha_cols, return_col)\n1883:         \n1884:         # Compute portfolio IC on test set\n1885:         portfolio_ic = self.compute_ic(portfolio_signal, test_df[return_col])\n1886:         \n1887:         # Compute portfolio returns (signal * forward return)\n1888:         portfolio_returns = portfolio_signal * test_df[return_col]\n1889:         portfolio_returns = portfolio_returns.dropna()\n1890: \n1891:         # Build daily aggregated returns (sum over assets on each date)\n1892:         # We must align portfolio_returns with date and group/sum.\n1893:         # Ensure PIT Safety: date aggregation is done on test_df date series.\n1894:         # Since portfolio_returns might have dropped NaNs, we align with test_df index first.\n1895:         aligned_df = pd.DataFrame({\n1896:             'date': test_df.loc[portfolio_returns.index, 'date'],\n1897:             'p_ret': portfolio_returns\n1898:         })\n1899:         daily_series = aligned_df.groupby('date')['p_ret'].sum().sort_index()\n1900: \n1901:         # Plumb slippage and commission to actual realized portfolio returns\n1902:         df_weights = pd.DataFrame({'date': test_df['date'], 'ticker': test_df['ticker'], 'weight': portfolio_signal})\n1903:         pivot_weights = df_weights.pivot(index='date', columns='ticker', values='weight').fillna(0.0)\n1904:         daily_turnover = pivot_weights.diff(axis=0).abs().sum(axis=1)\n1905:         if len(daily_turnover) > 0:\n1906:             daily_turnover.iloc[0] = pivot_weights.iloc[0].abs().sum()\n1907: \n1908:         daily_turnover = daily_turnover.reindex(daily_series.index, fill_value=0.0)\n1909:         daily_series = daily_series - (daily_turnover * self.cost_per_turnover)\n1910: \n1911:         # Stage 6.3: Active Drawdown Control\n1912:         if self.drawdown_control and len(daily_series) > 0:\n1913:             # We track cumulative NAV/drawdowns strictly sequentially\n1914:             cum_rets = (1 + daily_series).cumprod()\n1915:             running_max = cum_rets.expanding().max()\n1916:             drawdowns = (cum_rets - running_max) / running_max\n1917:             \n1918:             # Find the first date where drawdown breaches the threshold\n1919:             # Drawdowns are <= 0. Threshold is positive e.g. 0.05. Breach is drawdown < -drawdown_threshold\n1920:             breaches = drawdowns < -self.drawdown_threshold\n1921:             \n1922:             if breaches.any():\n1923:                 breach_date = breaches.idxmax() # First date where True\n1924:                 \n1925:                 # Daily return = 0.0 strictly after the first breach day, preserving the breach day return\n1926:                 # So for dates > breach_date, daily return is 0\n1927:                 dates_after = daily_series.index > breach_date\n1928:                 daily_series.loc[dates_after] = 0.0\n1929:                 \n1930:                 # Update row-level portfolio_returns to be zeroed out as well, aligning with daily returns\n1931:                 # Every row in portfolio_returns whose date is > breach_date should be 0.0\n1932:                 # Let's map date back to aligned_df\n1933:                 aligned_df['date_dt'] = pd.to_datetime(aligned_df['date'])\n1934:                 breach_dt = pd.to_datetime(breach_date)\n1935:                 \n1936:                 # Find indices where date > breach_date\n1937:                 indices_after = aligned_df[aligned_df['date_dt'] > breach_dt].index\n1938:                 portfolio_returns.loc[indices_after] = 0.0\n1939:                 \n1940:                 logger.info(f\"Fold {fold_id}: Drawdown control stop-out triggered at {breach_date}\")\n1941: \n1942:         # Compute Sharpe and Max DD from daily aggregated returns series\n1943:         sharpe = self.compute_sharpe_ratio(daily_series)\n1944:         max_dd = self.compute_max_drawdown(daily_series)\n1945:         total_return = daily_series.sum()\n1946:         pnl_val = total_return * self.initial_capital\n1947:         \n1948:         # Create metrics object\n1949:         metrics = FoldMetrics(\n1950:             fold_id=fold_id,\n1951:             train_start=str(train_df['date'].min().date()),\n1952:             train_end=str(train_df['date'].max().date()),\n1953:             test_start=str(test_df['date'].min().date()),\n1954:             test_end=str(test_df['date'].max().date()),\n1955:             alpha_ics=test_ics,\n1956:             portfolio_sharpe=sharpe,\n1957:             portfolio_max_dd=max_dd,\n1958:             portfolio_total_return=total_return,\n1959:             portfolio_pnl_vnd=pnl_val,\n1960:             portfolio_ic=portfolio_ic,\n1961:             raw_signal_ic=raw_signal_ic,\n1962:             raw_signal_daily_cs_ic=raw_signal_daily_cs_ic,\n1963:             n_train_samples=len(train_df_clean),\n1964:             n_test_samples=len(test_df),\n1965:             gate_results=gate_results,\n1966:             gated_alphas=gated_alphas,\n1967:         )\n1968:         \n1969:         logger.info(\n1970:             f\"Fold {fold_id} results: RawIC={raw_signal_ic:.4f}, \"\n1971:             f\"RawCS_IC={raw_signal_daily_cs_ic:.4f}, \"\n1972:             f\"PortfolioIC={portfolio_ic:.4f}, \"\n1973:             f\"Sharpe={sharpe:.4f}, MaxDD={max_dd:.2%}, PnL={pnl_val:+,.0f} VND\"\n1974:         )\n1975:         \n1976:         return metrics\n1977:     \n1978:     def run_walk_forward(\n1979:         self,\n1980:         splits: List[Tuple[pd.DataFrame, pd.DataFrame]],\n1981:         alpha_cols: List[str],\n1982:         return_col: str = 'fwd_ret_5',\n1983:     ) -> WalkForwardResult:\n1984:         \"\"\"Run complete walk-forward backtest.\n1985:         \n1986:         Parameters\n1987:         ----------\n1988:         splits : list of tuple\n1989:             List of (train_df, test_df) pairs\n1990:         alpha_cols : list of str\n1991:             Alpha column names\n1992:         return_col : str\n1993:             Forward return column name\n1994:         \n1995:         Returns\n1996:         -------\n1997:         WalkForwardResult\n1998:             Complete backtest results\n1999:         \"\"\"\n2000:         logger.info(f\"Starting walk-forward backtest with {len(splits)} folds\")\n2001:         \n2002:         fold_metrics = []\n2003:         \n2004:         for fold_id, (train_df, test_df) in enumerate(splits, start=1):\n2005:             metrics = self.run_fold(fold_id, train_df, test_df, alpha_cols, return_col)\n2006:             fold_metrics.append(metrics)\n2007:         \n2008:         # Aggregate results\n2009:         avg_ic_by_alpha = {}\n2010:         for alpha_col in alpha_cols:\n2011:             ics = [m.alpha_ics.get(alpha_col, 0.0) for m in fold_metrics]\n2012:             avg_ic_by_alpha[alpha_col] = np.mean(ics)\n2013:         \n2014:         avg_portfolio_ic = np.mean([m.portfolio_ic for m in fold_metrics])\n2015:         avg_raw_signal_ic = np.mean([m.raw_signal_ic for m in fold_metrics])\n2016:         avg_raw_signal_daily_cs_ic = np.mean([m.raw_signal_daily_cs_ic for m in fold_metrics])\n2017:         avg_portfolio_sharpe = np.mean([m.portfolio_sharpe for m in fold_metrics])\n2018:         avg_portfolio_max_dd = np.mean([m.portfolio_max_dd for m in fold_metrics])\n2019:         avg_portfolio_pnl_vnd = np.mean([m.portfolio_pnl_vnd for m in fold_metrics])\n2020:         \n2021:         result = WalkForwardResult(\n2022:             fold_metrics=fold_metrics,\n2023:             avg_ic_by_alpha=avg_ic_by_alpha,\n2024:             avg_portfolio_sharpe=avg_portfolio_sharpe,\n2025:             avg_portfolio_max_dd=avg_portfolio_max_dd,\n2026:             avg_portfolio_ic=avg_portfolio_ic,\n2027:             avg_raw_signal_ic=avg_raw_signal_ic,\n2028:             avg_raw_signal_daily_cs_ic=avg_raw_signal_daily_cs_ic,\n2029:             avg_portfolio_pnl_vnd=avg_portfolio_pnl_vnd,\n2030:             total_folds=len(fold_metrics),\n2031:         )\n2032:         \n2033:         logger.info(\"Walk-forward backtest complete\")\n2034:         logger.info(result.summary())\n2035:         \n2036:         return result\n2037: \n2038: \n2039: if __name__ == \"__main__\":\n2040:     # Test walk-forward engine\n2041:     logging.basicConfig(level=logging.INFO)\n2042:     \n2043:     # Import required modules\n2044:     import sys\n2045:     from pathlib import Path\n2046:     \n2047:     workspace = Path(__file__).resolve().parents[3]\n2048:     _REPO_ROOT = workspace\n2049:     if str(_REPO_ROOT / 'src') not in sys.path:\n2050:         sys.path.insert(0, str(_REPO_ROOT / 'src'))\n2051:         \n2052:     from omega.quant import phase34_microstructure_alphas\n2053:     from phase35_data_loader import Phase35DataLoader\n2054:     \n2055:     # Load data\n2056:     loader = Phase35DataLoader()\n2057:     df = loader.load_and_prepare(\n2058:         start_date=\"2018-01-01\",\n2059:         end_date=\"2026-05-08\",\n2060:         top_n_symbols=20,\n2061:     )\n2062:     \n2063:     # Create splits\n2064:     splits = loader.create_walk_forward_splits(df, n_folds=6, train_years=1, test_years=1)\n2065:     \n2066:     # Run walk-forward backtest\n2067:     engine = Phase35WalkForwardEngine(\n2068:         alpha_module=phase34_microstructure_alphas,\n2069:         min_ic_threshold=0.02,\n2070:         top_n_alphas=5,\n2071:     )\n2072:     \n2073:     alpha_cols = list(phase34_microstructure_alphas.PHASE34_ALPHA_COLUMNS)\n2074:     \n2075:     result = engine.run_walk_forward(splits, alpha_cols, return_col='fwd_ret_5')\n2076:     \n2077:     print(\"\\n\" + result.summary())\n\n(End of file - total 2077 lines)\n</content>","metadata":{"preview":"        if final_objective_return_col in val_actual.columns:\n            final_objective_validation_ic = self.compute_ic(val_signal, val_actual[final_objective_return_col])\n        \n        # Populate quality metrics dict\n        # FIX P10 Role21 Re-Audit: train_ic and validation_ic must align to final objective return_col\n        quality_metrics = {\n            'train_ic': final_objective_train_ic,  # Use final-objective IC for weighting\n            'validation_ic': final_objective_validation_ic,  # Use final-objective IC for weighting\n            'final_objective_train_ic': final_objective_train_ic,\n            'final_objective_validation_ic': final_objective_validation_ic,\n            'own_target_train_ic': own_target_train_ic,\n            'own_target_validation_ic': own_target_validation_ic,\n        }\n        \n        logger.info(\n            f\"[P10] Horizon {horizon} complete: \"\n            f\"gated_alphas={len(gated_alphas)}, \"\n            f\"own_val_ic={own_target_validation_ic:.4f}, \"\n            f\"final_obj_val_ic={final_objective_validation_ic:.4f}, \"\n            f\"gate_passed={gate_passed_count}/{len(gate_results)}\"","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\src\\omega\\quant\\phase35_walk_forward.py","text":"        if final_objective_return_col in val_actual.columns:\n            final_objective_validation_ic = self.compute_ic(val_signal, val_actual[final_objective_return_col])\n        \n        # Populate quality metrics dict\n        # FIX P10 Role21 Re-Audit: train_ic and validation_ic must align to final objective return_col\n        quality_metrics = {\n            'train_ic': final_objective_train_ic,  # Use final-objective IC for weighting\n            'validation_ic': final_objective_validation_ic,  # Use final-objective IC for weighting\n            'final_objective_train_ic': final_objective_train_ic,\n            'final_objective_validation_ic': final_objective_validation_ic,\n            'own_target_train_ic': own_target_train_ic,\n            'own_target_validation_ic': own_target_validation_ic,\n        }\n        \n        logger.info(\n            f\"[P10] Horizon {horizon} complete: \"\n            f\"gated_alphas={len(gated_alphas)}, \"\n            f\"own_val_ic={own_target_validation_ic:.4f}, \"\n            f\"final_obj_val_ic={final_objective_validation_ic:.4f}, \"\n            f\"gate_passed={gate_passed_count}/{len(gate_results)}\"\n        )\n        \n        return portfolio_signal, quality_metrics, gated_alphas, gate_results\n    \n    def _blend_horizon_signals(\n        self,\n        horizon_results: Dict[int, Tuple[pd.Series, Dict[str, float]]],\n        method: str = \"validation_ic\",\n    ) -> Optional[pd.Series]:\n        \"\"\"Blend signals from multiple horizons using quality-based weights.\n        \n        P10: Combines horizon-specific signals into a single blended signal.\n        \n        Parameters\n        ----------\n        horizon_results : dict\n            Mapping of horizon -> (signal, quality_metrics).\n            signal is a pd.Series, quality_metrics is a dict with 'train_ic', 'validation_ic', etc.\n        method : str\n            Weight computation method ('validation_ic' or 'train_ic')\n            \n        Returns\n        -------\n        pd.Series or None\n            Blended signal (same index as input signals), or None if all horizons have\n            non-positive quality (triggering fallback to baseline)\n            \n        Notes\n        -----\n        PIT Safety: quality_metrics must be computed from train/validation only,\n        never from test period. Caller is responsible for ensuring this.\n        \n        FIX 4: Negative or zero quality => weight 0 (no abs() weighting).\n        If all horizons have non-positive quality, returns None to trigger fallback.\n        If only one horizon succeeds, returns that signal directly.\n        \"\"\"\n        logger.info(f\"[P10] Blending {len(horizon_results)} horizon signals using method={method}\")\n        \n        # Validate method parameter\n        valid_methods = ['validation_ic', 'train_ic']\n        if method not in valid_methods:\n            logger.warning(f\"[P10] Invalid blend_weight_method='{method}', defaulting to 'validation_ic'\")\n            method = 'validation_ic'\n        \n        # Filter out failed horizons (None signal or missing quality metrics)\n        valid_horizons = {}\n        for h, (sig, qual_dict) in horizon_results.items():\n            if sig is None or qual_dict is None:\n                continue\n            if not isinstance(qual_dict, dict):\n                logger.warning(f\"[P10] Horizon {h} has invalid quality_metrics type, skipping\")\n                continue\n            valid_horizons[h] = (sig, qual_dict)\n        \n        if len(valid_horizons) == 0:\n            logger.error(\"[P10] All horizons failed, returning None to trigger fallback\")\n            return None\n        \n        # FIX P10 Role21 Re-Audit: Single horizon must also pass non-positive quality check\n        if len(valid_horizons) == 1:\n            h, (sig, qual_dict) = list(valid_horizons.items())[0]\n            quality_val = qual_dict.get(method, 0.0)\n            if quality_val <= 0:\n                logger.warning(\n                    f\"[P10] Only horizon {h} succeeded but {method}={quality_val:.4f} is non-positive, \"\n                    \"returning None to trigger fallback to baseline\"\n                )\n                return None\n            logger.info(f\"[P10] Only horizon {h} succeeded, using it directly ({method}={quality_val:.4f})\")\n            return sig\n        \n        # FIX 1 & 4: Extract quality metrics using specified method\n        # Use signed quality - negative IC => weight 0\n        qualities = []\n        for h, (sig, qual_dict) in valid_horizons.items():\n            quality_val = qual_dict.get(method, 0.0)\n            # FIX 4: Negative or zero quality => 0 weight (no abs())\n            if quality_val <= 0:\n                quality_val = 0.0\n                logger.info(f\"[P10] Horizon {h}: {method}={qual_dict.get(method, 0.0):.4f} (non-positive, weight=0)\")\n            qualities.append(quality_val)\n        \n        qualities = np.array(qualities)\n        \n        # FIX 4: If all qualities are non-positive, return None to trigger fallback\n        if qualities.sum() <= 1e-9:\n            logger.warning(\n                f\"[P10] All quality metrics non-positive using method={method}, \"\n                \"returning None to trigger fallback to baseline\"\n            )\n            return None\n        \n        # Normalize weights to sum to 1 (only positive qualities remain)\n        weights = qualities / qualities.sum()\n        \n        # Blend signals\n        signals = [sig for _, (sig, _) in valid_horizons.items()]\n        horizons_list = list(valid_horizons.keys())\n        \n        # Align all signals to same index (use first signal's index as reference)\n        ref_index = signals[0].index\n        blended = pd.Series(0.0, index=ref_index)\n        \n        for i, (h, weight) in enumerate(zip(horizons_list, weights)):\n            sig = signals[i].reindex(ref_index, fill_value=0.0)\n            blended += weight * sig\n            qual_dict = valid_horizons[h][1]\n            logger.info(\n                f\"[P10] Horizon {h}: weight={weight:.4f}, \"\n                f\"{method}={qual_dict.get(method, 0.0):.4f}\"\n            )\n        \n        logger.info(f\"[P10] Blend complete: {len([w for w in weights if w > 0])} horizons combined\")\n        return blended\n\n    def run_fold(\n        self,\n        fold_id: int,\n        train_df: pd.DataFrame,\n        test_df: pd.DataFrame,\n        alpha_cols: List[str],\n        return_col: str = 'fwd_ret_5',\n        cost_aware: bool | None = None,\n    ) -> FoldMetrics:\n        \"\"\"Run single walk-forward fold.\n        \n        Parameters\n        ----------\n        fold_id : int\n            Fold identifier\n        train_df : pd.DataFrame\n            Training data\n        test_df : pd.DataFrame\n            Testing data\n        alpha_cols : list of str\n            Alpha column names\n        return_col : str\n            Forward return column name\n        cost_aware : bool, optional\n            If True, cost-aware alpha selection is enabled for this fold.\n            If None, uses self.cost_aware.\n        \n        Returns\n        -------\n        FoldMetrics\n            Fold results\n        \n        Notes\n        -----\n        Embargo logic (PIT Safety): For a return_col of the form 'fwd_ret_N',\n        the last N rows per symbol are dropped from train_df before IC\n        computation and alpha selection. This prevents label leakage where\n        the forward return window of the final training rows overlaps with\n        the test period. Alpha computation (feature generation) uses the\n        full train_df so that indicators at the boundary are not distorted.\n        \"\"\"\n        logger.info(f\"Running fold {fold_id}\")\n\n        if cost_aware is None:\n            cost_aware = self.cost_aware\n        \n        # Compute alphas on train (full train_df — no embargo yet)\n        train_df = self.compute_alphas(train_df)\n\n        # --- Cold-start fix: prepend train tail to test_df for alpha computation ---\n        # Phase34 uses rolling windows (5, 10, 20 bars). Without train history,\n        # the first ~20 test days get NaN/zero-fill distortion.\n        # PIT safe: we only prepend already-embargoed train data, then strip it back.\n        warmup_n = 30  # rows per symbol to prepend (covers max rolling window)\n        train_tail = (\n            train_df\n            .groupby('ticker', group_keys=False)\n            .tail(warmup_n)\n            .copy()\n        )\n        # Mark original test rows so we can strip warmup back after alpha computation\n        is_test_mask = pd.Series(True, index=test_df.index)\n        test_df = test_df.copy()\n        test_df['_is_test'] = True\n        test_with_warmup = pd.concat([train_tail, test_df], ignore_index=True)\n        test_with_warmup = test_with_warmup.sort_values(\n            ['ticker', 'date'], ignore_index=True\n        )\n        test_with_warmup = self.compute_alphas(test_with_warmup)\n        # Strip warmup rows — keep only original test rows\n        keep_mask = test_with_warmup['_is_test'].fillna(False).astype(bool)\n        test_df = (\n            test_with_warmup.loc[keep_mask]\n            .drop(columns=['_is_test'], errors='ignore')\n            .reset_index(drop=True)\n        )\n        \n        # ==============================================================================\n        # P10: Multi-Horizon Blending Path (opt-in)\n        # ==============================================================================\n        if self.multi_horizon_blend:\n            logger.info(\n                f\"[P10] Fold {fold_id}: Multi-horizon blending enabled, \"\n                f\"horizons={self.blend_horizons}, method={self.blend_weight_method}\"\n            )\n            \n            horizon_results = {}\n            horizon_details = {}\n            \n            # Compute signal for each horizon independently\n            for horizon in self.blend_horizons:\n                horizon_return_col = f'fwd_ret_{horizon}'\n                \n                # FIX 1, 2, 5: Updated signature with quality_metrics dict and final_objective_return_col\n                signal, quality_metrics, gated, gate_res = self._compute_horizon_signal(\n                    fold_id=fold_id,\n                    train_df=train_df,\n                    test_df=test_df,\n                    alpha_cols=alpha_cols,\n                    return_col=horizon_return_col,\n                    horizon=horizon,\n                    cost_aware=cost_aware,\n                    final_objective_return_col=return_col,  # FIX 5: final objective alignment\n                )\n                \n                if signal is not None:\n                    horizon_results[horizon] = (signal, quality_metrics)\n                    # FIX 6: Store comprehensive diagnostics\n                    horizon_details[horizon] = {\n                        'gated_alphas': gated,\n                        'gate_results': gate_res,\n                        'quality_metrics': quality_metrics,\n                        'horizon_return_col': horizon_return_col,\n                        'included': True,\n                    }\n                else:\n                    # FIX 6: Track excluded horizons in diagnostics\n                    horizon_details[horizon] = {\n                        'gated_alphas': [],\n                        'gate_results': gate_res,\n                        'quality_metrics': quality_metrics,\n                        'horizon_return_col': horizon_return_col,\n                        'included': False,\n                        'exclusion_reason': 'gate_failed_or_missing_data',\n                    }\n            \n            # FIX 3: All-horizon failure fallback to single-horizon baseline\n            portfolio_signal = None\n            fallback_used = False\n            fallback_reason = None\n            \n            if len(horizon_results) == 0:\n                fallback_reason = \"all_horizons_failed_or_missing\"\n                logger.warning(\n                    f\"[P10] Fold {fold_id}: All requested horizons failed/missing. \"\n                    f\"Falling back to single-horizon baseline using return_col={return_col}\"\n                )\n                fallback_used = True\n            else:\n                # Attempt to blend\n                portfolio_signal = self._blend_horizon_signals(\n                    horizon_results, method=self.blend_weight_method\n                )\n                \n                # FIX 3 & 4: If blend returns None (all non-positive quality), fallback\n                if portfolio_signal is None:\n                    fallback_reason = \"all_quality_non_positive\"\n                    logger.warning(\n                        f\"[P10] Fold {fold_id}: Blend returned None (all quality non-positive). \"\n                        f\"Falling back to single-horizon baseline using return_col={return_col}\"\n                    )\n                    fallback_used = True\n            \n            # FIX 3: Execute fallback to approved single-horizon baseline\n            if fallback_used:\n                logger.info(\n                    f\"[P10] Fold {fold_id}: Executing fallback to single-horizon baseline \"\n                    f\"(return_col={return_col})\"\n                )\n                # Fall through to the standard single-horizon path below\n                # by setting multi_horizon_blend to False temporarily\n                self.multi_horizon_blend = False\n                # Recursively call run_fold with single-horizon mode\n                # (This ensures we use the exact same baseline logic)\n                result = self.run_fold(\n                    fold_id=fold_id,\n                    train_df=train_df,\n                    test_df=test_df,\n                    alpha_cols=alpha_cols,\n                    return_col=return_col,\n                    cost_aware=cost_aware,\n                )\n                # Restore multi_horizon_blend flag\n                self.multi_horizon_blend = True\n                # Add fallback diagnostic to result\n                # (FoldMetrics doesn't have a diagnostics field, so log it)\n                logger.info(\n                    f\"[P10] Fold {fold_id}: Fallback complete. \"\n                    f\"Reason: {fallback_reason}, \"\n                    f\"Requested horizons: {self.blend_horizons}, \"\n                    f\"Successful horizons: {list(horizon_results.keys())}\"\n                )\n                return result\n            \n            # Normal multi-horizon path (blend succeeded)\n            # For FoldMetrics reporting: use first successful horizon's details\n            # (FoldMetrics doesn't yet support per-horizon reporting)\n            first_horizon = list(horizon_details.keys())[0]\n            gated_alphas = horizon_details[first_horizon]['gated_alphas']\n            gate_results = horizon_details[first_horizon]['gate_results']\n            \n            # Compute raw signal IC using default return_col (for P9 comparison)\n            raw_signal_ic = self.compute_ic(portfolio_signal, test_df[return_col])\n            test_df_with_signal = test_df.copy()\n            test_df_with_signal['_raw_signal'] = portfolio_signal\n            raw_signal_daily_cs_ic = self.compute_daily_cs_ic(\n                test_df_with_signal, '_raw_signal', return_col\n            )\n            \n            # FIX 6: Log comprehensive diagnostics\n            logger.info(\n                f\"[P10] Fold {fold_id} multi-horizon diagnostics:\\n\"\n                f\"  Requested horizons: {self.blend_horizons}\\n\"\n                f\"  Included horizons: {[h for h, d in horizon_details.items() if d.get('included', False)]}\\n\"\n                f\"  Excluded horizons: {[h for h, d in horizon_details.items() if not d.get('included', True)]}\\n\"\n                f\"  Blend method: {self.blend_weight_method}\\n\"\n                f\"  Fallback used: {fallback_used}\"\n            )\n            for h, details in horizon_details.items():\n                if details.get('included', False):\n                    qm = details['quality_metrics']\n                    gate_passed = sum(1 for res in details['gate_results'].values() if _is_gate_verdict_pass(res.get('verdict')))\n                    gate_total = len(details['gate_results'])\n                    logger.info(\n                        f\"  Horizon {h}: train_ic={qm.get('train_ic', 0):.4f}, \"\n                        f\"val_ic={qm.get('validation_ic', 0):.4f}, \"\n                        f\"final_obj_val_ic={qm.get('final_objective_validation_ic', 0):.4f}, \"\n                        f\"gate={gate_passed}/{gate_total}\"\n                    )\n            \n            logger.info(\n                f\"[P10] Fold {fold_id} multi-horizon raw signal: \"\n                f\"IC={raw_signal_ic:.4f}, daily_cs_ic={raw_signal_daily_cs_ic:.4f}\"\n            )\n            \n            # Note: XGBoost and evolved signal are disabled in multi-horizon mode\n            # to keep P10 implementation focused and avoid complexity\n            \n            # For metrics reporting: use train_df as train_df_clean\n            # (embargo is applied per-horizon inside _compute_horizon_signal)\n            train_df_clean = train_df\n        \n        else:\n            # ==============================================================================\n            # Original Single-Horizon Path (default behavior, unchanged)\n            # ==============================================================================\n        \n            # --- Embargo: drop last h rows per symbol from IC/selection window ---\n            # Extract horizon h from return_col name (e.g. 'fwd_ret_5' -> h=5).\n            # Falls back to h=1 for unrecognised patterns.\n            try:\n                h = int(return_col.split('_')[-1])\n            except (ValueError, IndexError):\n                h = 1\n                logger.warning(\n                    f\"Could not parse horizon from return_col='{return_col}'; \"\n                    f\"defaulting embargo h={h}\"\n                )\n            \n            # Vectorized embargo: cumcount(ascending=False)==0 is the last row per symbol.\n            # Keep only rows where tail_rank >= h (i.e. not in the last h rows).\n            # This preserves all columns and is compatible with pandas 3.x.\n            _tail_rank = train_df.groupby('ticker').cumcount(ascending=False)\n            train_df_clean = train_df[_tail_rank >= h].reset_index(drop=True)\n            logger.info(\n                f\"Fold {fold_id} embargo: h={h}, \"\n                f\"train rows before={len(train_df)}, after={len(train_df_clean)}\"\n            )\n            # Split train_df_clean into Train Actual and Validation dynamically (e.g. 2:1 ratio by unique dates)\n            unique_dates = sorted(train_df_clean['date'].unique())\n            if len(unique_dates) >= 3:\n                split_idx = int(len(unique_dates) * 2 / 3)\n                val_start_date = unique_dates[split_idx]\n                train_actual = train_df_clean[train_df_clean['date'] < val_start_date].reset_index(drop=True)\n                val_actual = train_df_clean[train_df_clean['date'] >= val_start_date].reset_index(drop=True)\n            else:\n                train_actual = train_df_clean\n                val_actual = train_df_clean\n                \n            logger.info(\n                f\"Fold {fold_id} validation split: \"\n                f\"train_actual={len(train_actual)} rows, val_actual={len(val_actual)} rows\"\n            )\n            \n            # Compute IC on actual training set (no label leakage)\n            train_ics = self.compute_alpha_ics(train_actual, alpha_cols, return_col)\n            \n            # Strategy filter: momentum only keeps positive IC alphas\n            if hasattr(self, \"strategy\") and self.strategy == \"momentum\":\n                train_ics = {k: v for k, v in train_ics.items() if v > 0.0}\n                \n            logger.info(f\"Fold {fold_id} train ICs (strategy={self.strategy}): {train_ics}\")\n\n            # Stage 6.2: Cost-aware alpha selection\n            if cost_aware:\n                adjusted_ics = self.adjust_alphas_for_cost(\n                    train_actual, alpha_cols, train_ics\n                )\n                top_alphas = self.select_top_alphas(adjusted_ics)\n            else:\n                # Select top alphas based on train IC\n                top_alphas = self.select_top_alphas(train_ics)\n\n            # ------------------------------------------------------------------\n            # Stage 3 ML Gate: filter top_alphas through Research Gate\n            # Uses validation set (val_actual) — PIT safe, no look-ahead.\n            # ------------------------------------------------------------------\n            gated_alphas, gate_results = self.validate_alpha_with_research_gate(\n                top_alphas=top_alphas,\n                train_ics=train_ics,\n                train_df_clean=val_actual,\n                return_col=return_col,\n            )\n\n            # ------------------------------------------------------------------\n            # Stage 4: optional XGBoost path (use_xgboost=True) vs baseline\n            # Baseline: IC-weighted signal from gated alphas (unchanged).\n            # XGBoost: train XGBoostAlphaEnsemble on train_actual MultiIndex,\n            #          predict on test_df MultiIndex, standardize to portfolio_signal.\n            # PIT Safety: ensemble trains only on embargoed train_actual.\n            # ------------------------------------------------------------------\n            if self.use_xgboost and len(train_actual) > 0 and len(gated_alphas) > 0:\n                try:\n                    # Convert flat ['date','ticker'] -> MultiIndex ['date','symbol']\n                    X_train_multi = (\n                        train_actual\n                        .set_index(['date', 'ticker'])\n                        .rename_axis(index={'ticker': 'symbol'})\n                    )\n                    X_test_multi = (\n                        test_df\n                        .set_index(['date', 'ticker'])\n                        .rename_axis(index={'ticker': 'symbol'})\n                    )\n\n                    # Derive cutoff_date from max train date (embargo already applied)\n                    cutoff_date = str(\n                        train_df_clean['date'].max().date()\n                        if hasattr(train_df_clean['date'].max(), 'date')\n                        else train_df_clean['date'].max()\n                    )\n\n                    ensemble = XGBoostAlphaEnsemble(min_ic_threshold=0.0)\n                    ensemble.train(\n                        X_train_multi,\n                        gated_alphas,\n                        cutoff_date=cutoff_date,\n                        embargo_days=0,  # embargo already applied upstream\n                    )\n                    raw_preds = ensemble.predict(X_test_multi, gated_alphas)\n\n                    # Flatten MultiIndex predictions back to flat test_df index\n                    # Align raw_preds (indexed by date, symbol) with test_df (columns date, ticker) to prevent drift\n                    preds_df = raw_preds.reset_index().rename(columns={'symbol': 'ticker', 0: 'pred'})\n                    merged = test_df[['date', 'ticker']].merge(preds_df, on=['date', 'ticker'], how='left')\n                    preds_flat = merged['pred'].fillna(0.0).values\n                    if len(preds_flat) == len(test_df):\n                        preds_series = pd.Series(preds_flat, index=test_df.index)\n                        # Standardize: zero-mean, unit-std per date cross-section\n                        std_val = preds_series.std()\n                        if std_val > 0:\n                            portfolio_signal = (preds_series - preds_series.mean()) / std_val\n                        else:\n                            portfolio_signal = preds_series\n                        logger.info(f\"Fold {fold_id}: XGBoost path active, signal std={std_val:.4f}\")\n                    else:\n                        logger.warning(\n                            f\"Fold {fold_id}: XGBoost pred length mismatch \"\n                            f\"({len(preds_flat)} vs {len(test_df)}), falling back to baseline\"\n                        )\n                        portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n                except Exception as e:\n                    logger.warning(\n                        f\"Fold {fold_id}: XGBoost path failed ({e}), falling back to baseline\"\n                    )\n                    portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n            else:\n                # Baseline: IC-weighted signal (original path, fully preserved)\n                portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n\n            # ------------------------------------------------------------------\n            # Evolved Alpha Blending (optional) with Adaptive Weight\n            # If enable_evolved=True, run inline GP evolution on train_actual,\n            # execute best tree on test_df, and blend with hand-crafted signal.\n            # PIT Safety: evolution trains only on train_actual (embargoed).\n            # Adaptive: blend weight scales with train_ic quality (cap at user weight).\n            # ------------------------------------------------------------------\n            if self.enable_evolved and len(train_actual) > 0:\n                evolved_signal, gp_train_ic = self._evolve_inline_signal(train_actual, test_df, return_col)\n                if evolved_signal is not None:\n                    # Align evolved signal length with portfolio_signal\n                    if len(evolved_signal) == len(portfolio_signal):\n                        # Adaptive blend: scale weight by GP train quality\n                        # w_adaptive = min(user_weight, abs(train_ic) * scale_factor)\n                        # scale_factor=2 means IC=0.05 → weight=0.10, IC=0.10 → weight=0.20\n                        abs_train_ic = abs(gp_train_ic)\n                        scale_factor = 2.0\n                        w_adaptive = min(self.evolved_blend_weight, abs_train_ic * scale_factor)\n                        # P2: Ceiling protection - cap at 25% to prevent overfit\n                        # Ensures hand-crafted signal dominates (≥75%)\n                        ceiling = 0.25\n                        w_evo = min(w_adaptive, ceiling)\n                        # Floor: at least 10% of user weight to avoid zero contribution\n                        w_evo = max(w_evo, self.evolved_blend_weight * 0.1)\n                        w_hand = 1.0 - w_evo\n                        portfolio_signal = pd.Series(\n                            w_evo * evolved_signal + w_hand * portfolio_signal.values,\n                            index=portfolio_signal.index\n                        )\n                        logger.info(\n                            f\"Fold {fold_id}: Evolved signal blended \"\n                            f\"(evolved={w_evo:.3f}, handcrafted={w_hand:.3f}, \"\n                            f\"gp_train_ic={gp_train_ic:.4f}, adaptive=True)\"\n                        )\n                    else:\n                        logger.warning(\n                            f\"Fold {fold_id}: Evolved signal length mismatch \"\n                            f\"({len(evolved_signal)} vs {len(portfolio_signal)}), skipping blend\"\n                        )\n\n            # Strategy filter: mean reversion reverses signal direction\n            if hasattr(self, \"strategy\") and self.strategy == \"mean_reversion\":\n                portfolio_signal = -portfolio_signal\n\n            # --- Fix 3+4: Raw signal IC (before Stage 2) + Z-score normalization ---\n            # Apply cross-sectional z-score normalization to raw signal before blending\n            # This prevents scale differences between alphas from dominating weights\n            test_df_copy = test_df.copy()\n            test_df_copy['_raw_signal'] = portfolio_signal\n            # Z-score per date (cross-sectional)\n            test_df_copy['_raw_signal'] = test_df_copy.groupby('date')['_raw_signal'].transform(\n                lambda x: (x - x.mean()) / (x.std() + 1e-9)\n            )\n            portfolio_signal = test_df_copy['_raw_signal']\n\n            # Compute raw signal IC (pre Stage 2) — this is the true predictive power\n            raw_signal_ic = self.compute_ic(portfolio_signal, test_df[return_col])\n            \n            # Compute daily cross-sectional IC for raw signal (more robust metric)\n            test_df_with_signal = test_df.copy()\n            test_df_with_signal['_raw_signal'] = portfolio_signal\n            raw_signal_daily_cs_ic = self.compute_daily_cs_ic(\n                test_df_with_signal, '_raw_signal', return_col\n            )\n            \n            logger.info(\n                f\"Fold {fold_id} raw signal IC: {raw_signal_ic:.4f}, \"\n                f\"daily CS IC: {raw_signal_daily_cs_ic:.4f}\"\n            )\n        \n        # ==============================================================================\n        # Both paths converge here: Stage 2 constraints apply to both single-horizon\n        # and multi-horizon signals\n        # ==============================================================================\n\n        # ------------------------------------------------------------------\n        # Stage 2 behavioral enforcement (top-N, rebalance cadence, sector cap)\n        # Applied AFTER IC-weighted signal combination, BEFORE return computation.\n        # PIT safety preserved: test_df signals are already T-1 lagged upstream.\n        # ------------------------------------------------------------------\n        try:\n            portfolio_signal = self._apply_stage2_constraints(\n                test_df=test_df,\n                raw_signal=portfolio_signal,\n                top_alphas=gated_alphas,\n                dynamic_rebalance=True,\n                train_df=train_df,\n            )\n        except TypeError as exc:\n            if \"unexpected keyword argument\" not in str(exc):\n                raise\n            # Backward-compatible path for tests or external monkeypatches that\n            # still expose the original 3-argument Stage 2 hook signature.\n            logger.warning(\n                \"Stage 2 constraints hook does not accept P9 kwargs; \"\n                \"falling back to legacy call signature\"\n            )\n            portfolio_signal = self._apply_stage2_constraints(\n                test_df=test_df,\n                raw_signal=portfolio_signal,\n                top_alphas=gated_alphas,\n            )\n\n        # Compute test IC for each alpha\n        test_ics = self.compute_alpha_ics(test_df, alpha_cols, return_col)\n        \n        # Compute portfolio IC on test set\n        portfolio_ic = self.compute_ic(portfolio_signal, test_df[return_col])\n        \n        # Compute portfolio returns (signal * forward return)\n        portfolio_returns = portfolio_signal * test_df[return_col]\n        portfolio_returns = portfolio_returns.dropna()\n\n        # Build daily aggregated returns (sum over assets on each date)\n        # We must align portfolio_returns with date and group/sum.\n        # Ensure PIT Safety: date aggregation is done on test_df date series.\n        # Since portfolio_returns might have dropped NaNs, we align with test_df index first.\n        aligned_df = pd.DataFrame({\n            'date': test_df.loc[portfolio_returns.index, 'date'],\n            'p_ret': portfolio_returns\n        })\n        daily_series = aligned_df.groupby('date')['p_ret'].sum().sort_index()\n\n        # Plumb slippage and commission to actual realized portfolio returns\n        df_weights = pd.DataFrame({'date': test_df['date'], 'ticker': test_df['ticker'], 'weight': portfolio_signal})\n        pivot_weights = df_weights.pivot(index='date', columns='ticker', values='weight').fillna(0.0)\n        daily_turnover = pivot_weights.diff(axis=0).abs().sum(axis=1)\n        if len(daily_turnover) > 0:\n            daily_turnover.iloc[0] = pivot_weights.iloc[0].abs().sum()\n\n        daily_turnover = daily_turnover.reindex(daily_series.index, fill_value=0.0)\n        daily_series = daily_series - (daily_turnover * self.cost_per_turnover)\n\n        # Stage 6.3: Active Drawdown Control\n        if self.drawdown_control and len(daily_series) > 0:\n            # We track cumulative NAV/drawdowns strictly sequentially\n            cum_rets = (1 + daily_series).cumprod()\n            running_max = cum_rets.expanding().max()\n            drawdowns = (cum_rets - running_max) / running_max\n            \n            # Find the first date where drawdown breaches the threshold\n            # Drawdowns are <= 0. Threshold is positive e.g. 0.05. Breach is drawdown < -drawdown_threshold\n            breaches = drawdowns < -self.drawdown_threshold\n            \n            if breaches.any():\n                breach_date = breaches.idxmax() # First date where True\n                \n                # Daily return = 0.0 strictly after the first breach day, preserving the breach day return\n                # So for dates > breach_date, daily return is 0\n                dates_after = daily_series.index > breach_date\n                daily_series.loc[dates_after] = 0.0\n                \n                # Update row-level portfolio_returns to be zeroed out as well, aligning with daily returns\n                # Every row in portfolio_returns whose date is > breach_date should be 0.0\n                # Let's map date back to aligned_df\n                aligned_df['date_dt'] = pd.to_datetime(aligned_df['date'])\n                breach_dt = pd.to_datetime(breach_date)\n                \n                # Find indices where date > breach_date\n                indices_after = aligned_df[aligned_df['date_dt'] > breach_dt].index\n                portfolio_returns.loc[indices_after] = 0.0\n                \n                logger.info(f\"Fold {fold_id}: Drawdown control stop-out triggered at {breach_date}\")\n\n        # Compute Sharpe and Max DD from daily aggregated returns series\n        sharpe = self.compute_sharpe_ratio(daily_series)\n        max_dd = self.compute_max_drawdown(daily_series)\n        total_return = daily_series.sum()\n        pnl_val = total_return * self.initial_capital\n        \n        # Create metrics object\n        metrics = FoldMetrics(\n            fold_id=fold_id,\n            train_start=str(train_df['date'].min().date()),\n            train_end=str(train_df['date'].max().date()),\n            test_start=str(test_df['date'].min().date()),\n            test_end=str(test_df['date'].max().date()),\n            alpha_ics=test_ics,\n            portfolio_sharpe=sharpe,\n            portfolio_max_dd=max_dd,\n            portfolio_total_return=total_return,\n            portfolio_pnl_vnd=pnl_val,\n            portfolio_ic=portfolio_ic,\n            raw_signal_ic=raw_signal_ic,\n            raw_signal_daily_cs_ic=raw_signal_daily_cs_ic,\n            n_train_samples=len(train_df_clean),\n            n_test_samples=len(test_df),\n            gate_results=gate_results,\n            gated_alphas=gated_alphas,\n        )\n        \n        logger.info(\n            f\"Fold {fold_id} results: RawIC={raw_signal_ic:.4f}, \"\n            f\"RawCS_IC={raw_signal_daily_cs_ic:.4f}, \"\n            f\"PortfolioIC={portfolio_ic:.4f}, \"\n            f\"Sharpe={sharpe:.4f}, MaxDD={max_dd:.2%}, PnL={pnl_val:+,.0f} VND\"\n        )\n        \n        return metrics\n    \n    def run_walk_forward(\n        self,\n        splits: List[Tuple[pd.DataFrame, pd.DataFrame]],\n        alpha_cols: List[str],\n        return_col: str = 'fwd_ret_5',\n    ) -> WalkForwardResult:\n        \"\"\"Run complete walk-forward backtest.\n        \n        Parameters\n        ----------\n        splits : list of tuple\n            List of (train_df, test_df) pairs\n        alpha_cols : list of str\n            Alpha column names\n        return_col : str\n            Forward return column name\n        \n        Returns\n        -------\n        WalkForwardResult\n            Complete backtest results\n        \"\"\"\n        logger.info(f\"Starting walk-forward backtest with {len(splits)} folds\")\n        \n        fold_metrics = []\n        \n        for fold_id, (train_df, test_df) in enumerate(splits, start=1):\n            metrics = self.run_fold(fold_id, train_df, test_df, alpha_cols, return_col)\n            fold_metrics.append(metrics)\n        \n        # Aggregate results\n        avg_ic_by_alpha = {}\n        for alpha_col in alpha_cols:\n            ics = [m.alpha_ics.get(alpha_col, 0.0) for m in fold_metrics]\n            avg_ic_by_alpha[alpha_col] = np.mean(ics)\n        \n        avg_portfolio_ic = np.mean([m.portfolio_ic for m in fold_metrics])\n        avg_raw_signal_ic = np.mean([m.raw_signal_ic for m in fold_metrics])\n        avg_raw_signal_daily_cs_ic = np.mean([m.raw_signal_daily_cs_ic for m in fold_metrics])\n        avg_portfolio_sharpe = np.mean([m.portfolio_sharpe for m in fold_metrics])\n        avg_portfolio_max_dd = np.mean([m.portfolio_max_dd for m in fold_metrics])\n        avg_portfolio_pnl_vnd = np.mean([m.portfolio_pnl_vnd for m in fold_metrics])\n        \n        result = WalkForwardResult(\n            fold_metrics=fold_metrics,\n            avg_ic_by_alpha=avg_ic_by_alpha,\n            avg_portfolio_sharpe=avg_portfolio_sharpe,\n            avg_portfolio_max_dd=avg_portfolio_max_dd,\n            avg_portfolio_ic=avg_portfolio_ic,\n            avg_raw_signal_ic=avg_raw_signal_ic,\n            avg_raw_signal_daily_cs_ic=avg_raw_signal_daily_cs_ic,\n            avg_portfolio_pnl_vnd=avg_portfolio_pnl_vnd,\n            total_folds=len(fold_metrics),\n        )\n        \n        logger.info(\"Walk-forward backtest complete\")\n        logger.info(result.summary())\n        \n        return result\n\n\nif __name__ == \"__main__\":\n    # Test walk-forward engine\n    logging.basicConfig(level=logging.INFO)\n    \n    # Import required modules\n    import sys\n    from pathlib import Path\n    \n    workspace = Path(__file__).resolve().parents[3]\n    _REPO_ROOT = workspace\n    if str(_REPO_ROOT / 'src') not in sys.path:\n        sys.path.insert(0, str(_REPO_ROOT / 'src'))\n        \n    from omega.quant import phase34_microstructure_alphas\n    from phase35_data_loader import Phase35DataLoader\n    \n    # Load data\n    loader = Phase35DataLoader()\n    df = loader.load_and_prepare(\n        start_date=\"2018-01-01\",\n        end_date=\"2026-05-08\",\n        top_n_symbols=20,\n    )\n    \n    # Create splits\n    splits = loader.create_walk_forward_splits(df, n_folds=6, train_years=1, test_years=1)\n    \n    # Run walk-forward backtest\n    engine = Phase35WalkForwardEngine(\n        alpha_module=phase34_microstructure_alphas,\n        min_ic_threshold=0.02,\n        top_n_alphas=5,\n    )\n    \n    alpha_cols = list(phase34_microstructure_alphas.PHASE34_ALPHA_COLUMNS)\n    \n    result = engine.run_walk_forward(splits, alpha_cols, return_col='fwd_ret_5')\n    \n    print(\"\\n\" + result.summary())","lineStart":1273,"lineEnd":2077,"totalLines":2077,"truncated":false}},"title":"src\\omega\\quant\\phase35_walk_forward.py","time":{"start":1781015382128,"end":1781015382144}},"id":"prt_eacca0414001zPunYJozhhudcS","sessionID":"ses_153369dedffemeV7129OxwCDlM","messageID":"msg_eacc9df3f001BHHL8FfI2kp6dw"}}
