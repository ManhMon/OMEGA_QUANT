{"type":"tool_use","timestamp":1781015549669,"sessionID":"ses_153369dedffemeV7129OxwCDlM","part":{"type":"tool","tool":"read","callID":"tooluse_IssxBtxPAjtMOswrELIO4N","state":{"status":"completed","input":{"filePath":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\tests\\phase35\\test_p10_multi_horizon_blend.py"},"output":"<path>C:\\Users\\GHC\\repos\\OMEGA_QUANT\\tests\\phase35\\test_p10_multi_horizon_blend.py</path>\n<type>file</type>\n<content>\n1: \"\"\"\n2: P10 Multi-Horizon Blending Tests\n3: [L2-Impl:Role9-BackendEngineer] - 2026-06-09\n4: \n5: Verifies P10 multi-horizon signal blending in Phase35WalkForwardEngine:\n6:   1. Separate horizon IC calls use matching return_col (h=3 uses fwd_ret_3, not fwd_ret_5)\n7:   2. Embargo uses each horizon length (h=3 embargo is 3 rows, not 5)\n8:   3. Blend weights derive from train/validation only (no test data in weights)\n9:   4. Missing horizon fallback (if fwd_ret_1 missing, graceful handling)\n10:   5. Default behavior unchanged (multi_horizon_blend=False matches baseline)\n11:   6. No fwd_ret_* feature leakage into evolved path\n12: \n13: PIT Safety: All tests use synthetic in-memory data only.\n14: \"\"\"\n15: \n16: import sys\n17: import os\n18: import unittest\n19: from unittest.mock import patch, MagicMock\n20: \n21: import numpy as np\n22: import pandas as pd\n23: \n24: sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))\n25: \n26: \n27: # ---------------------------------------------------------------------------\n28: # Shared helpers\n29: # ---------------------------------------------------------------------------\n30: \n31: def _make_fake_alpha_module():\n32:     \"\"\"Minimal alpha module: passes df through unchanged (alpha cols pre-set).\"\"\"\n33:     class _FakeAlphaModule:\n34:         PHASE34_ALPHA_COLUMNS = ['alpha_a', 'alpha_b']\n35:         \n36:         @staticmethod\n37:         def compute_phase34_microstructure_alphas(df, **kwargs):\n38:             return df.copy()\n39:     return _FakeAlphaModule()\n40: \n41: \n42: def _make_engine(\n43:     multi_horizon_blend=False,\n44:     blend_horizons=None,\n45:     blend_weight_method=\"validation_ic\",\n46:     use_xgboost=False,\n47:     min_ic_threshold=0.0,\n48:     top_n_alphas=2,\n49:     top_n_stocks=5,\n50:     rebalance_freq=1,\n51:     sector_cap_pct=1.0,\n52: ):\n53:     from omega.quant.phase35_walk_forward import Phase35WalkForwardEngine\n54:     return Phase35WalkForwardEngine(\n55:         alpha_module=_make_fake_alpha_module(),\n56:         min_ic_threshold=min_ic_threshold,\n57:         top_n_alphas=top_n_alphas,\n58:         top_n_stocks=top_n_stocks,\n59:         rebalance_freq=rebalance_freq,\n60:         sector_cap_pct=sector_cap_pct,\n61:         use_xgboost=use_xgboost,\n62:         multi_horizon_blend=multi_horizon_blend,\n63:         blend_horizons=blend_horizons,\n64:         blend_weight_method=blend_weight_method,\n65:     )\n66: \n67: \n68: def _make_df(n_dates=100, tickers=None, seed=42, include_horizons=None):\n69:     \"\"\"\n70:     Build synthetic OHLCV DataFrame with alpha columns and forward returns\n71:     for multiple horizons.\n72:     \n73:     Parameters\n74:     ----------\n75:     include_horizons : list of int, optional\n76:         Which horizons to include (default [1, 3, 5])\n77:     \"\"\"\n78:     rng = np.random.default_rng(seed)\n79:     if tickers is None:\n80:         tickers = ['A', 'B', 'C', 'D', 'E']\n81:     if include_horizons is None:\n82:         include_horizons = [1, 3, 5]\n83: \n84:     dates = pd.date_range('2020-01-01', periods=n_dates, freq='B')\n85:     rows = []\n86:     for date in dates:\n87:         for ticker in tickers:\n88:             rows.append({'date': date, 'ticker': ticker})\n89: \n90:     df = pd.DataFrame(rows)\n91:     n = len(df)\n92: \n93:     # OHLCV\n94:     df['open']   = rng.uniform(10, 100, n)\n95:     df['high']   = df['open'] * rng.uniform(1.0, 1.05, n)\n96:     df['low']    = df['open'] * rng.uniform(0.95, 1.0, n)\n97:     df['close']  = rng.uniform(10, 100, n)\n98:     df['volume'] = rng.integers(100_000, 1_000_000, n)\n99: \n100:     # Two alphas with different IC characteristics\n101:     df['alpha_a'] = rng.uniform(-1, 1, n)\n102:     df['alpha_b'] = rng.uniform(-1, 1, n)\n103: \n104:     # Forward returns for multiple horizons\n105:     # Each horizon has slightly different correlation with alphas\n106:     for h in include_horizons:\n107:         df[f'fwd_ret_{h}'] = (\n108:             df['alpha_a'] * (0.03 + 0.01 * h / 5) +\n109:             df['alpha_b'] * (0.02 - 0.005 * h / 5) +\n110:             rng.uniform(-0.02, 0.02, n)\n111:         )\n112: \n113:     return df\n114: \n115: \n116: # ---------------------------------------------------------------------------\n117: # Test 1: Separate horizon IC calls use matching return_col\n118: # ---------------------------------------------------------------------------\n119: \n120: class TestHorizonReturnColMatching(unittest.TestCase):\n121:     \"\"\"Verify that each horizon uses its correct return column.\"\"\"\n122: \n123:     def test_compute_horizon_signal_uses_correct_return_col(self):\n124:         \"\"\"_compute_horizon_signal for h=3 must use fwd_ret_3, not fwd_ret_5.\"\"\"\n125:         engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n126:         df = _make_df(n_dates=100, include_horizons=[1, 3, 5])\n127:         \n128:         n = len(df)\n129:         train_df = df.iloc[:int(n * 0.7)].copy()\n130:         test_df = df.iloc[int(n * 0.7):].copy()\n131:         \n132:         # Compute alphas\n133:         train_df = engine.compute_alphas(train_df)\n134:         test_df = engine.compute_alphas(test_df)\n135:         \n136:         alpha_cols = ['alpha_a', 'alpha_b']\n137:         \n138:         # Call _compute_horizon_signal for horizon 3\n139:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n140:                    return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n141:             signal, val_ic, gated, gate_res = engine._compute_horizon_signal(\n142:                 fold_id=1,\n143:                 train_df=train_df,\n144:                 test_df=test_df,\n145:                 alpha_cols=alpha_cols,\n146:                 return_col='fwd_ret_3',\n147:                 horizon=3,\n148:                 cost_aware=False,\n149:             )\n150:         \n151:         # Verify signal was computed (not None)\n152:         self.assertIsNotNone(signal, \"Signal should not be None for horizon 3\")\n153:         self.assertEqual(len(signal), len(test_df), \"Signal length must match test_df\")\n154: \n155: \n156: # ---------------------------------------------------------------------------\n157: # Test 2: Embargo uses each horizon length\n158: # ---------------------------------------------------------------------------\n159: \n160: class TestHorizonSpecificEmbargo(unittest.TestCase):\n161:     \"\"\"Verify that each horizon applies its own embargo length.\"\"\"\n162: \n163:     def test_embargo_length_matches_horizon(self):\n164:         \"\"\"Horizon h=3 should apply 3-row embargo per ticker, not 5.\"\"\"\n165:         engine = _make_engine()\n166:         df = _make_df(n_dates=100, include_horizons=[1, 3, 5])\n167:         \n168:         n = len(df)\n169:         train_df = df.iloc[:int(n * 0.7)].copy()\n170:         test_df = df.iloc[int(n * 0.7):].copy()\n171:         \n172:         train_df = engine.compute_alphas(train_df)\n173:         test_df = engine.compute_alphas(test_df)\n174:         \n175:         alpha_cols = ['alpha_a', 'alpha_b']\n176:         \n177:         # Spy on embargo logic by checking train_df_clean size\n178:         original_rows = len(train_df)\n179:         tickers = train_df['ticker'].nunique()\n180:         \n181:         # Horizon 1 should remove 1 row per ticker\n182:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n183:                    return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n184:             signal_h1, _, _, _ = engine._compute_horizon_signal(\n185:                 fold_id=1, train_df=train_df, test_df=test_df,\n186:                 alpha_cols=alpha_cols, return_col='fwd_ret_1',\n187:                 horizon=1, cost_aware=False,\n188:             )\n189:         \n190:         # Horizon 3 should remove 3 rows per ticker\n191:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n192:                    return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n193:             signal_h3, _, _, _ = engine._compute_horizon_signal(\n194:                 fold_id=1, train_df=train_df, test_df=test_df,\n195:                 alpha_cols=alpha_cols, return_col='fwd_ret_3',\n196:                 horizon=3, cost_aware=False,\n197:             )\n198:         \n199:         # Both should succeed\n200:         self.assertIsNotNone(signal_h1, \"Horizon 1 signal should not be None\")\n201:         self.assertIsNotNone(signal_h3, \"Horizon 3 signal should not be None\")\n202: \n203: \n204: # ---------------------------------------------------------------------------\n205: # Test 3: Blend weights derive from train/validation only\n206: # ---------------------------------------------------------------------------\n207: \n208: class TestBlendWeightsPITSafety(unittest.TestCase):\n209:     \"\"\"Verify blend weights use only train/validation data, never test.\"\"\"\n210: \n211:     def test_blend_weights_validation_ic_method(self):\n212:         \"\"\"Blend weights must be computed from validation IC, not test IC.\"\"\"\n213:         engine = _make_engine(\n214:             multi_horizon_blend=True,\n215:             blend_horizons=[1, 3, 5],\n216:             blend_weight_method=\"validation_ic\"\n217:         )\n218:         \n219:         # Create horizon results with different validation ICs\n220:         test_index = pd.RangeIndex(100)\n221:         # Updated to use quality_metrics dict format\n222:         horizon_results = {\n223:             1: (pd.Series(np.random.default_rng(1).uniform(-1, 1, 100), index=test_index), \n224:                 {'train_ic': 0.04, 'validation_ic': 0.05, 'final_objective_validation_ic': 0.045}),\n225:             3: (pd.Series(np.random.default_rng(2).uniform(-1, 1, 100), index=test_index), \n226:                 {'train_ic': 0.09, 'validation_ic': 0.10, 'final_objective_validation_ic': 0.095}),\n227:             5: (pd.Series(np.random.default_rng(3).uniform(-1, 1, 100), index=test_index), \n228:                 {'train_ic': 0.025, 'validation_ic': 0.03, 'final_objective_validation_ic': 0.028}),\n229:         }\n230:         \n231:         # Blend signals\n232:         blended = engine._blend_horizon_signals(horizon_results, method=\"validation_ic\")\n233:         \n234:         # Verify blended signal has correct length\n235:         self.assertEqual(len(blended), 100, \"Blended signal must match input length\")\n236:         self.assertFalse(blended.isna().all(), \"Blended signal should not be all NaN\")\n237: \n238: \n239:     def test_blend_weights_sum_to_one(self):\n240:         \"\"\"Blend weights should sum to approximately 1.0.\"\"\"\n241:         engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n242:         \n243:         test_index = pd.RangeIndex(50)\n244:         # Updated to use quality_metrics dict format\n245:         horizon_results = {\n246:             1: (pd.Series(1.0, index=test_index), \n247:                 {'train_ic': 0.035, 'validation_ic': 0.04, 'final_objective_validation_ic': 0.038}),\n248:             3: (pd.Series(2.0, index=test_index), \n249:                 {'train_ic': 0.075, 'validation_ic': 0.08, 'final_objective_validation_ic': 0.077}),\n250:             5: (pd.Series(3.0, index=test_index), \n251:                 {'train_ic': 0.055, 'validation_ic': 0.06, 'final_objective_validation_ic': 0.058}),\n252:         }\n253:         \n254:         # Expected weights: validation_ic values are [0.04, 0.08, 0.06], sum=0.18\n255:         # Normalized: [0.04/0.18, 0.08/0.18, 0.06/0.18] = [0.222, 0.444, 0.333]\n256:         # Blended = 0.222*1 + 0.444*2 + 0.333*3 = 0.222 + 0.888 + 1.0 = 2.11\n257:         blended = engine._blend_horizon_signals(horizon_results)\n258:         \n259:         expected = 0.04/0.18 * 1.0 + 0.08/0.18 * 2.0 + 0.06/0.18 * 3.0\n260:         self.assertAlmostEqual(blended.iloc[0], expected, places=6)\n261: \n262: \n263: # ---------------------------------------------------------------------------\n264: # Test 4: Missing horizon fallback\n265: # ---------------------------------------------------------------------------\n266: \n267: class TestMissingHorizonFallback(unittest.TestCase):\n268:     \"\"\"Verify graceful handling when horizon return column is missing.\"\"\"\n269: \n270:     def test_missing_fwd_ret_col_returns_none(self):\n271:         \"\"\"If fwd_ret_1 is missing from data, _compute_horizon_signal returns None.\"\"\"\n272:         engine = _make_engine()\n273:         # Create df WITHOUT fwd_ret_1\n274:         df = _make_df(n_dates=80, include_horizons=[3, 5])\n275:         \n276:         n = len(df)\n277:         train_df = df.iloc[:int(n * 0.7)].copy()\n278:         test_df = df.iloc[int(n * 0.7):].copy()\n279:         \n280:         train_df = engine.compute_alphas(train_df)\n281:         test_df = engine.compute_alphas(test_df)\n282:         \n283:         # Try to compute signal for horizon 1 (missing fwd_ret_1)\n284:         # Updated to unpack quality_metrics dict\n285:         signal, quality_metrics, gated, gate_res = engine._compute_horizon_signal(\n286:             fold_id=1,\n287:             train_df=train_df,\n288:             test_df=test_df,\n289:             alpha_cols=['alpha_a', 'alpha_b'],\n290:             return_col='fwd_ret_1',\n291:             horizon=1,\n292:             cost_aware=False,\n293:             final_objective_return_col='fwd_ret_5',\n294:         )\n295:         \n296:         # Should return None for missing column\n297:         self.assertIsNone(signal, \"Signal should be None when return_col is missing\")\n298:         self.assertIsInstance(quality_metrics, dict, \"quality_metrics should be a dict\")\n299:         self.assertEqual(quality_metrics.get('validation_ic', -999), 0.0, \n300:                         \"Validation IC should be 0.0 for failed horizon\")\n301: \n302: \n303:     def test_blend_with_partial_horizon_success(self):\n304:         \"\"\"If only 2 of 3 horizons succeed, blend should use the 2 successful ones.\"\"\"\n305:         engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n306:         \n307:         test_index = pd.RangeIndex(50)\n308:         # Horizon 1 failed (None signal), horizons 3 and 5 succeeded\n309:         # Updated to use quality_metrics dict format\n310:         horizon_results = {\n311:             3: (pd.Series(1.0, index=test_index), \n312:                 {'train_ic': 0.075, 'validation_ic': 0.08, 'final_objective_validation_ic': 0.077}),\n313:             5: (pd.Series(2.0, index=test_index), \n314:                 {'train_ic': 0.055, 'validation_ic': 0.06, 'final_objective_validation_ic': 0.058}),\n315:         }\n316:         \n317:         blended = engine._blend_horizon_signals(horizon_results)\n318:         \n319:         # Should blend only the 2 successful horizons\n320:         self.assertEqual(len(blended), 50)\n321:         self.assertFalse(blended.isna().all())\n322: \n323: \n324: # ---------------------------------------------------------------------------\n325: # Test 5: Default behavior unchanged\n326: # ---------------------------------------------------------------------------\n327: \n328: class TestDefaultBehaviorUnchanged(unittest.TestCase):\n329:     \"\"\"Verify multi_horizon_blend=False preserves original behavior.\"\"\"\n330: \n331:     def test_single_horizon_baseline_unchanged(self):\n332:         \"\"\"With multi_horizon_blend=False, run_fold should work as before.\"\"\"\n333:         engine = _make_engine(multi_horizon_blend=False)\n334:         df = _make_df(n_dates=120, include_horizons=[1, 3, 5])\n335:         \n336:         n = len(df)\n337:         train_df = df.iloc[:int(n * 0.7)].copy()\n338:         test_df = df.iloc[int(n * 0.7):].copy()\n339:         \n340:         alpha_cols = ['alpha_a', 'alpha_b']\n341:         \n342:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n343:                    return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n344:             with patch('omega.quant.phase35_walk_forward._import_apply_sector_caps',\n345:                        return_value=lambda w, sm, sc: w):\n346:                 metrics = engine.run_fold(\n347:                     fold_id=1,\n348:                     train_df=train_df,\n349:                     test_df=test_df,\n350:                     alpha_cols=alpha_cols,\n351:                     return_col='fwd_ret_5',\n352:                 )\n353:         \n354:         # Should return valid metrics\n355:         self.assertIsNotNone(metrics)\n356:         self.assertFalse(np.isnan(metrics.portfolio_ic))\n357:         self.assertFalse(np.isnan(metrics.portfolio_sharpe))\n358: \n359: \n360: # ---------------------------------------------------------------------------\n361: # Test 6: Multi-horizon integration test\n362: # ---------------------------------------------------------------------------\n363: \n364: class TestMultiHorizonIntegration(unittest.TestCase):\n365:     \"\"\"End-to-end test of multi-horizon blending through run_fold.\"\"\"\n366: \n367:     def test_multi_horizon_fold_returns_valid_metrics(self):\n368:         \"\"\"Multi-horizon fold should return valid FoldMetrics.\"\"\"\n369:         engine = _make_engine(\n370:             multi_horizon_blend=True,\n371:             blend_horizons=[1, 3, 5],\n372:             blend_weight_method=\"validation_ic\",\n373:         )\n374:         df = _make_df(n_dates=120, include_horizons=[1, 3, 5])\n375:         \n376:         n = len(df)\n377:         train_df = df.iloc[:int(n * 0.7)].copy()\n378:         test_df = df.iloc[int(n * 0.7):].copy()\n379:         \n380:         alpha_cols = ['alpha_a', 'alpha_b']\n381:         \n382:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n383:                    return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n384:             with patch('omega.quant.phase35_walk_forward._import_apply_sector_caps',\n385:                        return_value=lambda w, sm, sc: w):\n386:                 metrics = engine.run_fold(\n387:                     fold_id=1,\n388:                     train_df=train_df,\n389:                     test_df=test_df,\n390:                     alpha_cols=alpha_cols,\n391:                     return_col='fwd_ret_5',  # Used for final metrics\n392:                 )\n393:         \n394:         # Verify metrics are valid\n395:         self.assertIsNotNone(metrics)\n396:         self.assertFalse(np.isnan(metrics.portfolio_ic), \"Portfolio IC is NaN\")\n397:         self.assertFalse(np.isnan(metrics.portfolio_sharpe), \"Portfolio Sharpe is NaN\")\n398:         self.assertFalse(np.isnan(metrics.raw_signal_ic), \"Raw signal IC is NaN\")\n399:         self.assertGreater(len(metrics.gated_alphas), 0, \"Gated alphas should not be empty\")\n400: \n401: \n402:     def test_multi_horizon_with_two_horizons(self):\n403:         \"\"\"Multi-horizon blending with only 2 horizons should work.\"\"\"\n404:         engine = _make_engine(\n405:             multi_horizon_blend=True,\n406:             blend_horizons=[3, 5],\n407:             blend_weight_method=\"validation_ic\",\n408:         )\n409:         df = _make_df(n_dates=100, include_horizons=[3, 5])\n410:         \n411:         n = len(df)\n412:         train_df = df.iloc[:int(n * 0.7)].copy()\n413:         test_df = df.iloc[int(n * 0.7):].copy()\n414:         \n415:         alpha_cols = ['alpha_a', 'alpha_b']\n416:         \n417:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n418:                    return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n419:             with patch('omega.quant.phase35_walk_forward._import_apply_sector_caps',\n420:                        return_value=lambda w, sm, sc: w):\n421:                 metrics = engine.run_fold(\n422:                     fold_id=1,\n423:                     train_df=train_df,\n424:                     test_df=test_df,\n425:                     alpha_cols=alpha_cols,\n426:                     return_col='fwd_ret_5',\n427:                 )\n428:         \n429:         self.assertIsNotNone(metrics)\n430:         self.assertFalse(np.isnan(metrics.portfolio_ic))\n431: \n432: \n433: # ---------------------------------------------------------------------------\n434: # Test 7: Constructor parameter validation\n435: # ---------------------------------------------------------------------------\n436: \n437: class TestConstructorParameters(unittest.TestCase):\n438:     \"\"\"Verify multi-horizon parameters are stored correctly.\"\"\"\n439: \n440:     def test_default_blend_horizons(self):\n441:         \"\"\"Default blend_horizons should be [1, 3, 5].\"\"\"\n442:         engine = _make_engine(multi_horizon_blend=True)\n443:         self.assertEqual(engine.blend_horizons, [1, 3, 5])\n444: \n445: \n446:     def test_custom_blend_horizons(self):\n447:         \"\"\"Custom blend_horizons should be stored.\"\"\"\n448:         engine = _make_engine(multi_horizon_blend=True, blend_horizons=[2, 4])\n449:         self.assertEqual(engine.blend_horizons, [2, 4])\n450: \n451: \n452:     def test_blend_weight_method_stored(self):\n453:         \"\"\"blend_weight_method should be stored correctly.\"\"\"\n454:         engine = _make_engine(\n455:             multi_horizon_blend=True,\n456:             blend_weight_method=\"train_ic\"\n457:         )\n458:         self.assertEqual(engine.blend_weight_method, \"train_ic\")\n459: \n460: \n461: # ---------------------------------------------------------------------------\n462: # Test 8: Gate verdict truthiness (P10 hotfix 2026-06-09)\n463: # ---------------------------------------------------------------------------\n464: \n465: class TestGateVerdictTruthiness(unittest.TestCase):\n466:     \"\"\"Verify robust gate verdict evaluation (truthiness hotfix).\"\"\"\n467: \n468:     def test_is_gate_verdict_pass_boolean_true(self):\n469:         \"\"\"Boolean True should count as pass.\"\"\"\n470:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n471:         self.assertTrue(_is_gate_verdict_pass(True))\n472: \n473:     def test_is_gate_verdict_pass_boolean_false(self):\n474:         \"\"\"Boolean False should count as fail.\"\"\"\n475:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n476:         self.assertFalse(_is_gate_verdict_pass(False))\n477: \n478:     def test_is_gate_verdict_pass_string_pass(self):\n479:         \"\"\"String 'PASS' should count as pass.\"\"\"\n480:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n481:         self.assertTrue(_is_gate_verdict_pass(\"PASS\"))\n482:         self.assertTrue(_is_gate_verdict_pass(\"pass\"))\n483:         self.assertTrue(_is_gate_verdict_pass(\"  PASS  \"))\n484: \n485:     def test_is_gate_verdict_pass_string_approved(self):\n486:         \"\"\"String 'APPROVED' should count as pass.\"\"\"\n487:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n488:         self.assertTrue(_is_gate_verdict_pass(\"APPROVED\"))\n489:         self.assertTrue(_is_gate_verdict_pass(\"approved\"))\n490: \n491:     def test_is_gate_verdict_pass_string_fail(self):\n492:         \"\"\"String starting with 'FAIL' should count as fail.\"\"\"\n493:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n494:         self.assertFalse(_is_gate_verdict_pass(\"FAIL\"))\n495:         self.assertFalse(_is_gate_verdict_pass(\"FAIL: insufficient samples\"))\n496:         self.assertFalse(_is_gate_verdict_pass(\"fail: low IC\"))\n497: \n498:     def test_is_gate_verdict_pass_string_reject(self):\n499:         \"\"\"String starting with 'REJECT' should count as fail.\"\"\"\n500:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n501:         self.assertFalse(_is_gate_verdict_pass(\"REJECT\"))\n502:         self.assertFalse(_is_gate_verdict_pass(\"REJECT: low IC\"))\n503: \n504:     def test_is_gate_verdict_pass_string_needs_fix(self):\n505:         \"\"\"String starting with 'NEEDS_FIX' should count as fail.\"\"\"\n506:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n507:         self.assertFalse(_is_gate_verdict_pass(\"NEEDS_FIX\"))\n508:         self.assertFalse(_is_gate_verdict_pass(\"NEEDS_FIX: instability\"))\n509: \n510:     def test_is_gate_verdict_pass_none(self):\n511:         \"\"\"None should count as fail.\"\"\"\n512:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n513:         self.assertFalse(_is_gate_verdict_pass(None))\n514: \n515:     def test_is_gate_verdict_pass_empty_string(self):\n516:         \"\"\"Empty string should count as fail.\"\"\"\n517:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n518:         self.assertFalse(_is_gate_verdict_pass(\"\"))\n519:         self.assertFalse(_is_gate_verdict_pass(\"   \"))\n520: \n521:     def test_is_gate_verdict_pass_arbitrary_string(self):\n522:         \"\"\"Arbitrary non-pass strings should count as fail (conservative).\"\"\"\n523:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n524:         self.assertFalse(_is_gate_verdict_pass(\"maybe\"))\n525:         self.assertFalse(_is_gate_verdict_pass(\"unknown\"))\n526:         self.assertFalse(_is_gate_verdict_pass(\"pending\"))\n527: \n528:     def test_horizon_exclusion_with_fail_verdicts(self):\n529:         \"\"\"Horizon with all FAIL verdicts should be excluded from blend.\"\"\"\n530:         engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n531:         df = _make_df(n_dates=100, include_horizons=[1, 3, 5])\n532:         \n533:         n = len(df)\n534:         train_df = df.iloc[:int(n * 0.7)].copy()\n535:         test_df = df.iloc[int(n * 0.7):].copy()\n536:         \n537:         train_df = engine.compute_alphas(train_df)\n538:         test_df = engine.compute_alphas(test_df)\n539:         \n540:         alpha_cols = ['alpha_a', 'alpha_b']\n541:         \n542:         # Mock gate to return FAIL verdicts for all alphas\n543:         with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n544:                    return_value={'passed': False, 'verdict': 'FAIL: insufficient samples', 'n_samples': 5}):\n545:             signal, quality_metrics, gated, gate_res = engine._compute_horizon_signal(\n546:                 fold_id=1,\n547:                 train_df=train_df,\n548:                 test_df=test_df,\n549:                 alpha_cols=alpha_cols,\n550:                 return_col='fwd_ret_3',\n551:                 horizon=3,\n552:                 cost_aware=False,\n553:             )\n554:         \n555:         # Signal should be None (horizon excluded)\n556:         self.assertIsNone(signal, \"Horizon with all FAIL verdicts should return None signal\")\n557:         self.assertEqual(len(gated), 0, \"Gated alphas should be empty for excluded horizon\")\n558: \n559:     def test_gate_passed_count_with_mixed_verdicts(self):\n560:         \"\"\"Gate passed count should correctly handle mixed PASS/FAIL verdicts.\"\"\"\n561:         from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n562:         \n563:         # Simulate gate_results with mixed verdicts\n564:         gate_results = {\n565:             'alpha_a': {'verdict': True, 'passed': True},\n566:             'alpha_b': {'verdict': 'FAIL: insufficient samples', 'passed': False},\n567:             'alpha_c': {'verdict': 'PASS', 'passed': True},\n568:             'alpha_d': {'verdict': False, 'passed': False},\n569:         }\n570:         \n571:         gate_passed_count = sum(1 for res in gate_results.values() if _is_gate_verdict_pass(res.get('verdict')))\n572:         \n573:         # Should count only alpha_a (True) and alpha_c ('PASS')\n574:         self.assertEqual(gate_passed_count, 2, \n575:                         \"Should count only True and 'PASS' verdicts, not 'FAIL: ...' strings\")\n576: \n577: \n578: # ---------------------------------------------------------------------------\n579: # Test 9: Role21 Re-Audit Fixes (P10 2026-06-09)\n580: # ---------------------------------------------------------------------------\n581: \n582: class TestRole21ReauditFixes(unittest.TestCase):\n583:     \"\"\"Verify fixes for Role21 re-audit findings:\n584:     - Single surviving horizon with non-positive quality returns None\n585:     - All horizons with non-positive quality returns None\n586:     - train_ic vs validation_ic produces different weights\n587:     - Final-objective weighting alignment\n588:     \"\"\"\n589: \n590:     def test_single_horizon_non_positive_quality_returns_none(self):\n591:         \"\"\"Single surviving horizon with non-positive quality must return None.\"\"\"\n592:         engine = _make_engine(multi_horizon_blend=True, blend_weight_method=\"validation_ic\")\n593:         \n594:         # Create synthetic signal\n595:         sig = pd.Series([1.0, 2.0, 3.0], index=[0, 1, 2])\n596:         \n597:         # Single horizon with non-positive validation_ic\n598:         horizon_results = {\n599:             3: (sig, {\n600:                 'train_ic': 0.15,\n601:                 'validation_ic': -0.1,  # Non-positive\n602:                 'final_objective_validation_ic': -0.1,\n603:                 'own_target_validation_ic': 0.05,\n604:             })\n605:         }\n606:         \n607:         result = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n608:         self.assertIsNone(result, \"Single horizon with non-positive validation_ic should return None\")\n609: \n610:     def test_all_horizons_non_positive_quality_returns_none(self):\n611:         \"\"\"All gate-passing horizons with non-positive quality must return None.\"\"\"\n612:         engine = _make_engine(multi_horizon_blend=True, blend_weight_method=\"validation_ic\")\n613:         \n614:         # Multiple horizons, all with non-positive validation_ic\n615:         sig1 = pd.Series([1.0, 2.0, 3.0], index=[0, 1, 2])\n616:         sig3 = pd.Series([1.5, 2.5, 3.5], index=[0, 1, 2])\n617:         sig5 = pd.Series([2.0, 3.0, 4.0], index=[0, 1, 2])\n618:         \n619:         horizon_results = {\n620:             1: (sig1, {\n621:                 'train_ic': -0.05,\n622:                 'validation_ic': -0.1,\n623:                 'final_objective_validation_ic': -0.1,\n624:             }),\n625:             3: (sig3, {\n626:                 'train_ic': -0.03,\n627:                 'validation_ic': 0.0,  # Zero is also non-positive\n628:                 'final_objective_validation_ic': 0.0,\n629:             }),\n630:             5: (sig5, {\n631:                 'train_ic': -0.08,\n632:                 'validation_ic': -0.15,\n633:                 'final_objective_validation_ic': -0.15,\n634:             }),\n635:         }\n636:         \n637:         result = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n638:         self.assertIsNone(result, \"All horizons with non-positive validation_ic should return None\")\n639: \n640:     def test_train_ic_vs_validation_ic_different_weights(self):\n641:         \"\"\"train_ic and validation_ic methods must produce different deterministic weights.\"\"\"\n642:         engine = _make_engine(multi_horizon_blend=True)\n643:         \n644:         # Create deterministic signals\n645:         sig1 = pd.Series([1.0, 2.0, 3.0], index=[0, 1, 2])\n646:         sig3 = pd.Series([4.0, 5.0, 6.0], index=[0, 1, 2])\n647:         \n648:         # Opposing ranks: train_ic favors h1, validation_ic favors h3\n649:         horizon_results = {\n650:             1: (sig1, {\n651:                 'train_ic': 0.8,  # High train IC for h1\n652:                 'validation_ic': 0.2,  # Low validation IC for h1\n653:                 'final_objective_train_ic': 0.8,\n654:                 'final_objective_validation_ic': 0.2,\n655:             }),\n656:             3: (sig3, {\n657:                 'train_ic': 0.3,  # Low train IC for h3\n658:                 'validation_ic': 0.7,  # High validation IC for h3\n659:                 'final_objective_train_ic': 0.3,\n660:                 'final_objective_validation_ic': 0.7,\n661:             }),\n662:         }\n663:         \n664:         result_train = engine._blend_horizon_signals(horizon_results, method='train_ic')\n665:         result_val = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n666:         \n667:         self.assertIsNotNone(result_train)\n668:         self.assertIsNotNone(result_val)\n669:         \n670:         # Results must be different (train_ic should favor h1, validation_ic should favor h3)\n671:         # Check that the blends are not equal\n672:         self.assertFalse(\n673:             np.allclose(result_train.values, result_val.values, rtol=0.01),\n674:             \"train_ic and validation_ic methods must produce different outputs\"\n675:         )\n676:         \n677:         # Verify train_ic blend is closer to sig1 (expected ~73% weight on h1: 0.8/(0.8+0.3))\n678:         train_weight_h1 = 0.8 / (0.8 + 0.3)  # ~0.727\n679:         expected_train = sig1 * train_weight_h1 + sig3 * (1 - train_weight_h1)\n680:         self.assertTrue(\n681:             np.allclose(result_train.values, expected_train.values, rtol=0.01),\n682:             \"train_ic blend should weight by train IC\"\n683:         )\n684:         \n685:         # Verify validation_ic blend is closer to sig3 (expected ~78% weight on h3: 0.7/(0.2+0.7))\n686:         val_weight_h3 = 0.7 / (0.2 + 0.7)  # ~0.778\n687:         expected_val = sig1 * (1 - val_weight_h3) + sig3 * val_weight_h3\n688:         self.assertTrue(\n689:             np.allclose(result_val.values, expected_val.values, rtol=0.01),\n690:             \"validation_ic blend should weight by validation IC\"\n691:         )\n692: \n693:     def test_final_objective_weighting_alignment(self):\n694:         \"\"\"Blending must use final-objective IC, not own-target IC.\n695:         \n696:         Scenario: own-target validation_ic favors h1, but final_objective_validation_ic\n697:         favors h5. The blend output must favor h5 because weights align to final objective.\n698:         \"\"\"\n699:         engine = _make_engine(multi_horizon_blend=True, blend_weight_method=\"validation_ic\")\n700:         \n701:         # Create distinctive signals\n702:         sig1 = pd.Series([10.0, 20.0, 30.0], index=[0, 1, 2])\n703:         sig5 = pd.Series([100.0, 200.0, 300.0], index=[0, 1, 2])\n704:         \n705:         # After P10 Role21 fix: validation_ic key now contains final_objective_validation_ic\n706:         # Own-target metrics are stored separately for diagnostics\n707:         horizon_results = {\n708:             1: (sig1, {\n709:                 'train_ic': 0.2,  # Final objective train IC for h1 (low)\n710:                 'validation_ic': 0.15,  # Final objective validation IC for h1 (low)\n711:                 'final_objective_train_ic': 0.2,\n712:                 'final_objective_validation_ic': 0.15,\n713:                 'own_target_train_ic': 0.8,  # Own-target was high, but not used for weighting\n714:                 'own_target_validation_ic': 0.9,  # Own-target was high, but not used for weighting\n715:             }),\n716:             5: (sig5, {\n717:                 'train_ic': 0.7,  # Final objective train IC for h5 (high)\n718:                 'validation_ic': 0.85,  # Final objective validation IC for h5 (high)\n719:                 'final_objective_train_ic': 0.7,\n720:                 'final_objective_validation_ic': 0.85,\n721:                 'own_target_train_ic': 0.3,  # Own-target was low, but not used for weighting\n722:                 'own_target_validation_ic': 0.1,  # Own-target was low, but not used for weighting\n723:             }),\n724:         }\n725:         \n726:         result = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n727:         self.assertIsNotNone(result)\n728:         \n729:         # Calculate expected weights: validation_ic (which now contains final_objective_validation_ic)\n730:         # h1: 0.15, h5: 0.85\n731:         # weight_h5 = 0.85 / (0.15 + 0.85) = 0.85\n732:         weight_h5 = 0.85 / (0.15 + 0.85)\n733:         expected_blend = sig1 * (1 - weight_h5) + sig5 * weight_h5\n734:         \n735:         # Result must favor h5 (85% weight) despite own-target IC favoring h1\n736:         self.assertTrue(\n737:             np.allclose(result.values, expected_blend.values, rtol=0.01),\n738:             \"Blend must use final-objective validation_ic (favoring h5), not own-target validation_ic\"\n739:         )\n740:         \n741:         # Additional check: result should be much closer to sig5 than sig1\n742:         dist_to_sig5 = np.abs(result.values - sig5.values).mean()\n743:         dist_to_sig1 = np.abs(result.values - sig1.values).mean()\n744:         self.assertLess(\n745:             dist_to_sig5, dist_to_sig1,\n746:             \"Blend should be closer to sig5 (high final-objective IC) than sig1\"\n747:         )\n748: \n749: \n750: if __name__ == '__main__':\n751:     unittest.main()\n\n(End of file - total 751 lines)\n</content>","metadata":{"preview":"\"\"\"\nP10 Multi-Horizon Blending Tests\n[L2-Impl:Role9-BackendEngineer] - 2026-06-09\n\nVerifies P10 multi-horizon signal blending in Phase35WalkForwardEngine:\n  1. Separate horizon IC calls use matching return_col (h=3 uses fwd_ret_3, not fwd_ret_5)\n  2. Embargo uses each horizon length (h=3 embargo is 3 rows, not 5)\n  3. Blend weights derive from train/validation only (no test data in weights)\n  4. Missing horizon fallback (if fwd_ret_1 missing, graceful handling)\n  5. Default behavior unchanged (multi_horizon_blend=False matches baseline)\n  6. No fwd_ret_* feature leakage into evolved path\n\nPIT Safety: All tests use synthetic in-memory data only.\n\"\"\"\n\nimport sys\nimport os\nimport unittest\nfrom unittest.mock import patch, MagicMock\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\tests\\phase35\\test_p10_multi_horizon_blend.py","text":"\"\"\"\nP10 Multi-Horizon Blending Tests\n[L2-Impl:Role9-BackendEngineer] - 2026-06-09\n\nVerifies P10 multi-horizon signal blending in Phase35WalkForwardEngine:\n  1. Separate horizon IC calls use matching return_col (h=3 uses fwd_ret_3, not fwd_ret_5)\n  2. Embargo uses each horizon length (h=3 embargo is 3 rows, not 5)\n  3. Blend weights derive from train/validation only (no test data in weights)\n  4. Missing horizon fallback (if fwd_ret_1 missing, graceful handling)\n  5. Default behavior unchanged (multi_horizon_blend=False matches baseline)\n  6. No fwd_ret_* feature leakage into evolved path\n\nPIT Safety: All tests use synthetic in-memory data only.\n\"\"\"\n\nimport sys\nimport os\nimport unittest\nfrom unittest.mock import patch, MagicMock\n\nimport numpy as np\nimport pandas as pd\n\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))\n\n\n# ---------------------------------------------------------------------------\n# Shared helpers\n# ---------------------------------------------------------------------------\n\ndef _make_fake_alpha_module():\n    \"\"\"Minimal alpha module: passes df through unchanged (alpha cols pre-set).\"\"\"\n    class _FakeAlphaModule:\n        PHASE34_ALPHA_COLUMNS = ['alpha_a', 'alpha_b']\n        \n        @staticmethod\n        def compute_phase34_microstructure_alphas(df, **kwargs):\n            return df.copy()\n    return _FakeAlphaModule()\n\n\ndef _make_engine(\n    multi_horizon_blend=False,\n    blend_horizons=None,\n    blend_weight_method=\"validation_ic\",\n    use_xgboost=False,\n    min_ic_threshold=0.0,\n    top_n_alphas=2,\n    top_n_stocks=5,\n    rebalance_freq=1,\n    sector_cap_pct=1.0,\n):\n    from omega.quant.phase35_walk_forward import Phase35WalkForwardEngine\n    return Phase35WalkForwardEngine(\n        alpha_module=_make_fake_alpha_module(),\n        min_ic_threshold=min_ic_threshold,\n        top_n_alphas=top_n_alphas,\n        top_n_stocks=top_n_stocks,\n        rebalance_freq=rebalance_freq,\n        sector_cap_pct=sector_cap_pct,\n        use_xgboost=use_xgboost,\n        multi_horizon_blend=multi_horizon_blend,\n        blend_horizons=blend_horizons,\n        blend_weight_method=blend_weight_method,\n    )\n\n\ndef _make_df(n_dates=100, tickers=None, seed=42, include_horizons=None):\n    \"\"\"\n    Build synthetic OHLCV DataFrame with alpha columns and forward returns\n    for multiple horizons.\n    \n    Parameters\n    ----------\n    include_horizons : list of int, optional\n        Which horizons to include (default [1, 3, 5])\n    \"\"\"\n    rng = np.random.default_rng(seed)\n    if tickers is None:\n        tickers = ['A', 'B', 'C', 'D', 'E']\n    if include_horizons is None:\n        include_horizons = [1, 3, 5]\n\n    dates = pd.date_range('2020-01-01', periods=n_dates, freq='B')\n    rows = []\n    for date in dates:\n        for ticker in tickers:\n            rows.append({'date': date, 'ticker': ticker})\n\n    df = pd.DataFrame(rows)\n    n = len(df)\n\n    # OHLCV\n    df['open']   = rng.uniform(10, 100, n)\n    df['high']   = df['open'] * rng.uniform(1.0, 1.05, n)\n    df['low']    = df['open'] * rng.uniform(0.95, 1.0, n)\n    df['close']  = rng.uniform(10, 100, n)\n    df['volume'] = rng.integers(100_000, 1_000_000, n)\n\n    # Two alphas with different IC characteristics\n    df['alpha_a'] = rng.uniform(-1, 1, n)\n    df['alpha_b'] = rng.uniform(-1, 1, n)\n\n    # Forward returns for multiple horizons\n    # Each horizon has slightly different correlation with alphas\n    for h in include_horizons:\n        df[f'fwd_ret_{h}'] = (\n            df['alpha_a'] * (0.03 + 0.01 * h / 5) +\n            df['alpha_b'] * (0.02 - 0.005 * h / 5) +\n            rng.uniform(-0.02, 0.02, n)\n        )\n\n    return df\n\n\n# ---------------------------------------------------------------------------\n# Test 1: Separate horizon IC calls use matching return_col\n# ---------------------------------------------------------------------------\n\nclass TestHorizonReturnColMatching(unittest.TestCase):\n    \"\"\"Verify that each horizon uses its correct return column.\"\"\"\n\n    def test_compute_horizon_signal_uses_correct_return_col(self):\n        \"\"\"_compute_horizon_signal for h=3 must use fwd_ret_3, not fwd_ret_5.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n        df = _make_df(n_dates=100, include_horizons=[1, 3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        # Compute alphas\n        train_df = engine.compute_alphas(train_df)\n        test_df = engine.compute_alphas(test_df)\n        \n        alpha_cols = ['alpha_a', 'alpha_b']\n        \n        # Call _compute_horizon_signal for horizon 3\n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n            signal, val_ic, gated, gate_res = engine._compute_horizon_signal(\n                fold_id=1,\n                train_df=train_df,\n                test_df=test_df,\n                alpha_cols=alpha_cols,\n                return_col='fwd_ret_3',\n                horizon=3,\n                cost_aware=False,\n            )\n        \n        # Verify signal was computed (not None)\n        self.assertIsNotNone(signal, \"Signal should not be None for horizon 3\")\n        self.assertEqual(len(signal), len(test_df), \"Signal length must match test_df\")\n\n\n# ---------------------------------------------------------------------------\n# Test 2: Embargo uses each horizon length\n# ---------------------------------------------------------------------------\n\nclass TestHorizonSpecificEmbargo(unittest.TestCase):\n    \"\"\"Verify that each horizon applies its own embargo length.\"\"\"\n\n    def test_embargo_length_matches_horizon(self):\n        \"\"\"Horizon h=3 should apply 3-row embargo per ticker, not 5.\"\"\"\n        engine = _make_engine()\n        df = _make_df(n_dates=100, include_horizons=[1, 3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        train_df = engine.compute_alphas(train_df)\n        test_df = engine.compute_alphas(test_df)\n        \n        alpha_cols = ['alpha_a', 'alpha_b']\n        \n        # Spy on embargo logic by checking train_df_clean size\n        original_rows = len(train_df)\n        tickers = train_df['ticker'].nunique()\n        \n        # Horizon 1 should remove 1 row per ticker\n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n            signal_h1, _, _, _ = engine._compute_horizon_signal(\n                fold_id=1, train_df=train_df, test_df=test_df,\n                alpha_cols=alpha_cols, return_col='fwd_ret_1',\n                horizon=1, cost_aware=False,\n            )\n        \n        # Horizon 3 should remove 3 rows per ticker\n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n            signal_h3, _, _, _ = engine._compute_horizon_signal(\n                fold_id=1, train_df=train_df, test_df=test_df,\n                alpha_cols=alpha_cols, return_col='fwd_ret_3',\n                horizon=3, cost_aware=False,\n            )\n        \n        # Both should succeed\n        self.assertIsNotNone(signal_h1, \"Horizon 1 signal should not be None\")\n        self.assertIsNotNone(signal_h3, \"Horizon 3 signal should not be None\")\n\n\n# ---------------------------------------------------------------------------\n# Test 3: Blend weights derive from train/validation only\n# ---------------------------------------------------------------------------\n\nclass TestBlendWeightsPITSafety(unittest.TestCase):\n    \"\"\"Verify blend weights use only train/validation data, never test.\"\"\"\n\n    def test_blend_weights_validation_ic_method(self):\n        \"\"\"Blend weights must be computed from validation IC, not test IC.\"\"\"\n        engine = _make_engine(\n            multi_horizon_blend=True,\n            blend_horizons=[1, 3, 5],\n            blend_weight_method=\"validation_ic\"\n        )\n        \n        # Create horizon results with different validation ICs\n        test_index = pd.RangeIndex(100)\n        # Updated to use quality_metrics dict format\n        horizon_results = {\n            1: (pd.Series(np.random.default_rng(1).uniform(-1, 1, 100), index=test_index), \n                {'train_ic': 0.04, 'validation_ic': 0.05, 'final_objective_validation_ic': 0.045}),\n            3: (pd.Series(np.random.default_rng(2).uniform(-1, 1, 100), index=test_index), \n                {'train_ic': 0.09, 'validation_ic': 0.10, 'final_objective_validation_ic': 0.095}),\n            5: (pd.Series(np.random.default_rng(3).uniform(-1, 1, 100), index=test_index), \n                {'train_ic': 0.025, 'validation_ic': 0.03, 'final_objective_validation_ic': 0.028}),\n        }\n        \n        # Blend signals\n        blended = engine._blend_horizon_signals(horizon_results, method=\"validation_ic\")\n        \n        # Verify blended signal has correct length\n        self.assertEqual(len(blended), 100, \"Blended signal must match input length\")\n        self.assertFalse(blended.isna().all(), \"Blended signal should not be all NaN\")\n\n\n    def test_blend_weights_sum_to_one(self):\n        \"\"\"Blend weights should sum to approximately 1.0.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n        \n        test_index = pd.RangeIndex(50)\n        # Updated to use quality_metrics dict format\n        horizon_results = {\n            1: (pd.Series(1.0, index=test_index), \n                {'train_ic': 0.035, 'validation_ic': 0.04, 'final_objective_validation_ic': 0.038}),\n            3: (pd.Series(2.0, index=test_index), \n                {'train_ic': 0.075, 'validation_ic': 0.08, 'final_objective_validation_ic': 0.077}),\n            5: (pd.Series(3.0, index=test_index), \n                {'train_ic': 0.055, 'validation_ic': 0.06, 'final_objective_validation_ic': 0.058}),\n        }\n        \n        # Expected weights: validation_ic values are [0.04, 0.08, 0.06], sum=0.18\n        # Normalized: [0.04/0.18, 0.08/0.18, 0.06/0.18] = [0.222, 0.444, 0.333]\n        # Blended = 0.222*1 + 0.444*2 + 0.333*3 = 0.222 + 0.888 + 1.0 = 2.11\n        blended = engine._blend_horizon_signals(horizon_results)\n        \n        expected = 0.04/0.18 * 1.0 + 0.08/0.18 * 2.0 + 0.06/0.18 * 3.0\n        self.assertAlmostEqual(blended.iloc[0], expected, places=6)\n\n\n# ---------------------------------------------------------------------------\n# Test 4: Missing horizon fallback\n# ---------------------------------------------------------------------------\n\nclass TestMissingHorizonFallback(unittest.TestCase):\n    \"\"\"Verify graceful handling when horizon return column is missing.\"\"\"\n\n    def test_missing_fwd_ret_col_returns_none(self):\n        \"\"\"If fwd_ret_1 is missing from data, _compute_horizon_signal returns None.\"\"\"\n        engine = _make_engine()\n        # Create df WITHOUT fwd_ret_1\n        df = _make_df(n_dates=80, include_horizons=[3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        train_df = engine.compute_alphas(train_df)\n        test_df = engine.compute_alphas(test_df)\n        \n        # Try to compute signal for horizon 1 (missing fwd_ret_1)\n        # Updated to unpack quality_metrics dict\n        signal, quality_metrics, gated, gate_res = engine._compute_horizon_signal(\n            fold_id=1,\n            train_df=train_df,\n            test_df=test_df,\n            alpha_cols=['alpha_a', 'alpha_b'],\n            return_col='fwd_ret_1',\n            horizon=1,\n            cost_aware=False,\n            final_objective_return_col='fwd_ret_5',\n        )\n        \n        # Should return None for missing column\n        self.assertIsNone(signal, \"Signal should be None when return_col is missing\")\n        self.assertIsInstance(quality_metrics, dict, \"quality_metrics should be a dict\")\n        self.assertEqual(quality_metrics.get('validation_ic', -999), 0.0, \n                        \"Validation IC should be 0.0 for failed horizon\")\n\n\n    def test_blend_with_partial_horizon_success(self):\n        \"\"\"If only 2 of 3 horizons succeed, blend should use the 2 successful ones.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n        \n        test_index = pd.RangeIndex(50)\n        # Horizon 1 failed (None signal), horizons 3 and 5 succeeded\n        # Updated to use quality_metrics dict format\n        horizon_results = {\n            3: (pd.Series(1.0, index=test_index), \n                {'train_ic': 0.075, 'validation_ic': 0.08, 'final_objective_validation_ic': 0.077}),\n            5: (pd.Series(2.0, index=test_index), \n                {'train_ic': 0.055, 'validation_ic': 0.06, 'final_objective_validation_ic': 0.058}),\n        }\n        \n        blended = engine._blend_horizon_signals(horizon_results)\n        \n        # Should blend only the 2 successful horizons\n        self.assertEqual(len(blended), 50)\n        self.assertFalse(blended.isna().all())\n\n\n# ---------------------------------------------------------------------------\n# Test 5: Default behavior unchanged\n# ---------------------------------------------------------------------------\n\nclass TestDefaultBehaviorUnchanged(unittest.TestCase):\n    \"\"\"Verify multi_horizon_blend=False preserves original behavior.\"\"\"\n\n    def test_single_horizon_baseline_unchanged(self):\n        \"\"\"With multi_horizon_blend=False, run_fold should work as before.\"\"\"\n        engine = _make_engine(multi_horizon_blend=False)\n        df = _make_df(n_dates=120, include_horizons=[1, 3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        alpha_cols = ['alpha_a', 'alpha_b']\n        \n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n            with patch('omega.quant.phase35_walk_forward._import_apply_sector_caps',\n                       return_value=lambda w, sm, sc: w):\n                metrics = engine.run_fold(\n                    fold_id=1,\n                    train_df=train_df,\n                    test_df=test_df,\n                    alpha_cols=alpha_cols,\n                    return_col='fwd_ret_5',\n                )\n        \n        # Should return valid metrics\n        self.assertIsNotNone(metrics)\n        self.assertFalse(np.isnan(metrics.portfolio_ic))\n        self.assertFalse(np.isnan(metrics.portfolio_sharpe))\n\n\n# ---------------------------------------------------------------------------\n# Test 6: Multi-horizon integration test\n# ---------------------------------------------------------------------------\n\nclass TestMultiHorizonIntegration(unittest.TestCase):\n    \"\"\"End-to-end test of multi-horizon blending through run_fold.\"\"\"\n\n    def test_multi_horizon_fold_returns_valid_metrics(self):\n        \"\"\"Multi-horizon fold should return valid FoldMetrics.\"\"\"\n        engine = _make_engine(\n            multi_horizon_blend=True,\n            blend_horizons=[1, 3, 5],\n            blend_weight_method=\"validation_ic\",\n        )\n        df = _make_df(n_dates=120, include_horizons=[1, 3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        alpha_cols = ['alpha_a', 'alpha_b']\n        \n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n            with patch('omega.quant.phase35_walk_forward._import_apply_sector_caps',\n                       return_value=lambda w, sm, sc: w):\n                metrics = engine.run_fold(\n                    fold_id=1,\n                    train_df=train_df,\n                    test_df=test_df,\n                    alpha_cols=alpha_cols,\n                    return_col='fwd_ret_5',  # Used for final metrics\n                )\n        \n        # Verify metrics are valid\n        self.assertIsNotNone(metrics)\n        self.assertFalse(np.isnan(metrics.portfolio_ic), \"Portfolio IC is NaN\")\n        self.assertFalse(np.isnan(metrics.portfolio_sharpe), \"Portfolio Sharpe is NaN\")\n        self.assertFalse(np.isnan(metrics.raw_signal_ic), \"Raw signal IC is NaN\")\n        self.assertGreater(len(metrics.gated_alphas), 0, \"Gated alphas should not be empty\")\n\n\n    def test_multi_horizon_with_two_horizons(self):\n        \"\"\"Multi-horizon blending with only 2 horizons should work.\"\"\"\n        engine = _make_engine(\n            multi_horizon_blend=True,\n            blend_horizons=[3, 5],\n            blend_weight_method=\"validation_ic\",\n        )\n        df = _make_df(n_dates=100, include_horizons=[3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        alpha_cols = ['alpha_a', 'alpha_b']\n        \n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': True, 'verdict': 'PASS', 'n_samples': 10}):\n            with patch('omega.quant.phase35_walk_forward._import_apply_sector_caps',\n                       return_value=lambda w, sm, sc: w):\n                metrics = engine.run_fold(\n                    fold_id=1,\n                    train_df=train_df,\n                    test_df=test_df,\n                    alpha_cols=alpha_cols,\n                    return_col='fwd_ret_5',\n                )\n        \n        self.assertIsNotNone(metrics)\n        self.assertFalse(np.isnan(metrics.portfolio_ic))\n\n\n# ---------------------------------------------------------------------------\n# Test 7: Constructor parameter validation\n# ---------------------------------------------------------------------------\n\nclass TestConstructorParameters(unittest.TestCase):\n    \"\"\"Verify multi-horizon parameters are stored correctly.\"\"\"\n\n    def test_default_blend_horizons(self):\n        \"\"\"Default blend_horizons should be [1, 3, 5].\"\"\"\n        engine = _make_engine(multi_horizon_blend=True)\n        self.assertEqual(engine.blend_horizons, [1, 3, 5])\n\n\n    def test_custom_blend_horizons(self):\n        \"\"\"Custom blend_horizons should be stored.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_horizons=[2, 4])\n        self.assertEqual(engine.blend_horizons, [2, 4])\n\n\n    def test_blend_weight_method_stored(self):\n        \"\"\"blend_weight_method should be stored correctly.\"\"\"\n        engine = _make_engine(\n            multi_horizon_blend=True,\n            blend_weight_method=\"train_ic\"\n        )\n        self.assertEqual(engine.blend_weight_method, \"train_ic\")\n\n\n# ---------------------------------------------------------------------------\n# Test 8: Gate verdict truthiness (P10 hotfix 2026-06-09)\n# ---------------------------------------------------------------------------\n\nclass TestGateVerdictTruthiness(unittest.TestCase):\n    \"\"\"Verify robust gate verdict evaluation (truthiness hotfix).\"\"\"\n\n    def test_is_gate_verdict_pass_boolean_true(self):\n        \"\"\"Boolean True should count as pass.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertTrue(_is_gate_verdict_pass(True))\n\n    def test_is_gate_verdict_pass_boolean_false(self):\n        \"\"\"Boolean False should count as fail.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(False))\n\n    def test_is_gate_verdict_pass_string_pass(self):\n        \"\"\"String 'PASS' should count as pass.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertTrue(_is_gate_verdict_pass(\"PASS\"))\n        self.assertTrue(_is_gate_verdict_pass(\"pass\"))\n        self.assertTrue(_is_gate_verdict_pass(\"  PASS  \"))\n\n    def test_is_gate_verdict_pass_string_approved(self):\n        \"\"\"String 'APPROVED' should count as pass.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertTrue(_is_gate_verdict_pass(\"APPROVED\"))\n        self.assertTrue(_is_gate_verdict_pass(\"approved\"))\n\n    def test_is_gate_verdict_pass_string_fail(self):\n        \"\"\"String starting with 'FAIL' should count as fail.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(\"FAIL\"))\n        self.assertFalse(_is_gate_verdict_pass(\"FAIL: insufficient samples\"))\n        self.assertFalse(_is_gate_verdict_pass(\"fail: low IC\"))\n\n    def test_is_gate_verdict_pass_string_reject(self):\n        \"\"\"String starting with 'REJECT' should count as fail.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(\"REJECT\"))\n        self.assertFalse(_is_gate_verdict_pass(\"REJECT: low IC\"))\n\n    def test_is_gate_verdict_pass_string_needs_fix(self):\n        \"\"\"String starting with 'NEEDS_FIX' should count as fail.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(\"NEEDS_FIX\"))\n        self.assertFalse(_is_gate_verdict_pass(\"NEEDS_FIX: instability\"))\n\n    def test_is_gate_verdict_pass_none(self):\n        \"\"\"None should count as fail.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(None))\n\n    def test_is_gate_verdict_pass_empty_string(self):\n        \"\"\"Empty string should count as fail.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(\"\"))\n        self.assertFalse(_is_gate_verdict_pass(\"   \"))\n\n    def test_is_gate_verdict_pass_arbitrary_string(self):\n        \"\"\"Arbitrary non-pass strings should count as fail (conservative).\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        self.assertFalse(_is_gate_verdict_pass(\"maybe\"))\n        self.assertFalse(_is_gate_verdict_pass(\"unknown\"))\n        self.assertFalse(_is_gate_verdict_pass(\"pending\"))\n\n    def test_horizon_exclusion_with_fail_verdicts(self):\n        \"\"\"Horizon with all FAIL verdicts should be excluded from blend.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_horizons=[1, 3, 5])\n        df = _make_df(n_dates=100, include_horizons=[1, 3, 5])\n        \n        n = len(df)\n        train_df = df.iloc[:int(n * 0.7)].copy()\n        test_df = df.iloc[int(n * 0.7):].copy()\n        \n        train_df = engine.compute_alphas(train_df)\n        test_df = engine.compute_alphas(test_df)\n        \n        alpha_cols = ['alpha_a', 'alpha_b']\n        \n        # Mock gate to return FAIL verdicts for all alphas\n        with patch('omega.quant.phase35_walk_forward.validate_research_gate',\n                   return_value={'passed': False, 'verdict': 'FAIL: insufficient samples', 'n_samples': 5}):\n            signal, quality_metrics, gated, gate_res = engine._compute_horizon_signal(\n                fold_id=1,\n                train_df=train_df,\n                test_df=test_df,\n                alpha_cols=alpha_cols,\n                return_col='fwd_ret_3',\n                horizon=3,\n                cost_aware=False,\n            )\n        \n        # Signal should be None (horizon excluded)\n        self.assertIsNone(signal, \"Horizon with all FAIL verdicts should return None signal\")\n        self.assertEqual(len(gated), 0, \"Gated alphas should be empty for excluded horizon\")\n\n    def test_gate_passed_count_with_mixed_verdicts(self):\n        \"\"\"Gate passed count should correctly handle mixed PASS/FAIL verdicts.\"\"\"\n        from omega.quant.phase35_walk_forward import _is_gate_verdict_pass\n        \n        # Simulate gate_results with mixed verdicts\n        gate_results = {\n            'alpha_a': {'verdict': True, 'passed': True},\n            'alpha_b': {'verdict': 'FAIL: insufficient samples', 'passed': False},\n            'alpha_c': {'verdict': 'PASS', 'passed': True},\n            'alpha_d': {'verdict': False, 'passed': False},\n        }\n        \n        gate_passed_count = sum(1 for res in gate_results.values() if _is_gate_verdict_pass(res.get('verdict')))\n        \n        # Should count only alpha_a (True) and alpha_c ('PASS')\n        self.assertEqual(gate_passed_count, 2, \n                        \"Should count only True and 'PASS' verdicts, not 'FAIL: ...' strings\")\n\n\n# ---------------------------------------------------------------------------\n# Test 9: Role21 Re-Audit Fixes (P10 2026-06-09)\n# ---------------------------------------------------------------------------\n\nclass TestRole21ReauditFixes(unittest.TestCase):\n    \"\"\"Verify fixes for Role21 re-audit findings:\n    - Single surviving horizon with non-positive quality returns None\n    - All horizons with non-positive quality returns None\n    - train_ic vs validation_ic produces different weights\n    - Final-objective weighting alignment\n    \"\"\"\n\n    def test_single_horizon_non_positive_quality_returns_none(self):\n        \"\"\"Single surviving horizon with non-positive quality must return None.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_weight_method=\"validation_ic\")\n        \n        # Create synthetic signal\n        sig = pd.Series([1.0, 2.0, 3.0], index=[0, 1, 2])\n        \n        # Single horizon with non-positive validation_ic\n        horizon_results = {\n            3: (sig, {\n                'train_ic': 0.15,\n                'validation_ic': -0.1,  # Non-positive\n                'final_objective_validation_ic': -0.1,\n                'own_target_validation_ic': 0.05,\n            })\n        }\n        \n        result = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n        self.assertIsNone(result, \"Single horizon with non-positive validation_ic should return None\")\n\n    def test_all_horizons_non_positive_quality_returns_none(self):\n        \"\"\"All gate-passing horizons with non-positive quality must return None.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_weight_method=\"validation_ic\")\n        \n        # Multiple horizons, all with non-positive validation_ic\n        sig1 = pd.Series([1.0, 2.0, 3.0], index=[0, 1, 2])\n        sig3 = pd.Series([1.5, 2.5, 3.5], index=[0, 1, 2])\n        sig5 = pd.Series([2.0, 3.0, 4.0], index=[0, 1, 2])\n        \n        horizon_results = {\n            1: (sig1, {\n                'train_ic': -0.05,\n                'validation_ic': -0.1,\n                'final_objective_validation_ic': -0.1,\n            }),\n            3: (sig3, {\n                'train_ic': -0.03,\n                'validation_ic': 0.0,  # Zero is also non-positive\n                'final_objective_validation_ic': 0.0,\n            }),\n            5: (sig5, {\n                'train_ic': -0.08,\n                'validation_ic': -0.15,\n                'final_objective_validation_ic': -0.15,\n            }),\n        }\n        \n        result = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n        self.assertIsNone(result, \"All horizons with non-positive validation_ic should return None\")\n\n    def test_train_ic_vs_validation_ic_different_weights(self):\n        \"\"\"train_ic and validation_ic methods must produce different deterministic weights.\"\"\"\n        engine = _make_engine(multi_horizon_blend=True)\n        \n        # Create deterministic signals\n        sig1 = pd.Series([1.0, 2.0, 3.0], index=[0, 1, 2])\n        sig3 = pd.Series([4.0, 5.0, 6.0], index=[0, 1, 2])\n        \n        # Opposing ranks: train_ic favors h1, validation_ic favors h3\n        horizon_results = {\n            1: (sig1, {\n                'train_ic': 0.8,  # High train IC for h1\n                'validation_ic': 0.2,  # Low validation IC for h1\n                'final_objective_train_ic': 0.8,\n                'final_objective_validation_ic': 0.2,\n            }),\n            3: (sig3, {\n                'train_ic': 0.3,  # Low train IC for h3\n                'validation_ic': 0.7,  # High validation IC for h3\n                'final_objective_train_ic': 0.3,\n                'final_objective_validation_ic': 0.7,\n            }),\n        }\n        \n        result_train = engine._blend_horizon_signals(horizon_results, method='train_ic')\n        result_val = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n        \n        self.assertIsNotNone(result_train)\n        self.assertIsNotNone(result_val)\n        \n        # Results must be different (train_ic should favor h1, validation_ic should favor h3)\n        # Check that the blends are not equal\n        self.assertFalse(\n            np.allclose(result_train.values, result_val.values, rtol=0.01),\n            \"train_ic and validation_ic methods must produce different outputs\"\n        )\n        \n        # Verify train_ic blend is closer to sig1 (expected ~73% weight on h1: 0.8/(0.8+0.3))\n        train_weight_h1 = 0.8 / (0.8 + 0.3)  # ~0.727\n        expected_train = sig1 * train_weight_h1 + sig3 * (1 - train_weight_h1)\n        self.assertTrue(\n            np.allclose(result_train.values, expected_train.values, rtol=0.01),\n            \"train_ic blend should weight by train IC\"\n        )\n        \n        # Verify validation_ic blend is closer to sig3 (expected ~78% weight on h3: 0.7/(0.2+0.7))\n        val_weight_h3 = 0.7 / (0.2 + 0.7)  # ~0.778\n        expected_val = sig1 * (1 - val_weight_h3) + sig3 * val_weight_h3\n        self.assertTrue(\n            np.allclose(result_val.values, expected_val.values, rtol=0.01),\n            \"validation_ic blend should weight by validation IC\"\n        )\n\n    def test_final_objective_weighting_alignment(self):\n        \"\"\"Blending must use final-objective IC, not own-target IC.\n        \n        Scenario: own-target validation_ic favors h1, but final_objective_validation_ic\n        favors h5. The blend output must favor h5 because weights align to final objective.\n        \"\"\"\n        engine = _make_engine(multi_horizon_blend=True, blend_weight_method=\"validation_ic\")\n        \n        # Create distinctive signals\n        sig1 = pd.Series([10.0, 20.0, 30.0], index=[0, 1, 2])\n        sig5 = pd.Series([100.0, 200.0, 300.0], index=[0, 1, 2])\n        \n        # After P10 Role21 fix: validation_ic key now contains final_objective_validation_ic\n        # Own-target metrics are stored separately for diagnostics\n        horizon_results = {\n            1: (sig1, {\n                'train_ic': 0.2,  # Final objective train IC for h1 (low)\n                'validation_ic': 0.15,  # Final objective validation IC for h1 (low)\n                'final_objective_train_ic': 0.2,\n                'final_objective_validation_ic': 0.15,\n                'own_target_train_ic': 0.8,  # Own-target was high, but not used for weighting\n                'own_target_validation_ic': 0.9,  # Own-target was high, but not used for weighting\n            }),\n            5: (sig5, {\n                'train_ic': 0.7,  # Final objective train IC for h5 (high)\n                'validation_ic': 0.85,  # Final objective validation IC for h5 (high)\n                'final_objective_train_ic': 0.7,\n                'final_objective_validation_ic': 0.85,\n                'own_target_train_ic': 0.3,  # Own-target was low, but not used for weighting\n                'own_target_validation_ic': 0.1,  # Own-target was low, but not used for weighting\n            }),\n        }\n        \n        result = engine._blend_horizon_signals(horizon_results, method='validation_ic')\n        self.assertIsNotNone(result)\n        \n        # Calculate expected weights: validation_ic (which now contains final_objective_validation_ic)\n        # h1: 0.15, h5: 0.85\n        # weight_h5 = 0.85 / (0.15 + 0.85) = 0.85\n        weight_h5 = 0.85 / (0.15 + 0.85)\n        expected_blend = sig1 * (1 - weight_h5) + sig5 * weight_h5\n        \n        # Result must favor h5 (85% weight) despite own-target IC favoring h1\n        self.assertTrue(\n            np.allclose(result.values, expected_blend.values, rtol=0.01),\n            \"Blend must use final-objective validation_ic (favoring h5), not own-target validation_ic\"\n        )\n        \n        # Additional check: result should be much closer to sig5 than sig1\n        dist_to_sig5 = np.abs(result.values - sig5.values).mean()\n        dist_to_sig1 = np.abs(result.values - sig1.values).mean()\n        self.assertLess(\n            dist_to_sig5, dist_to_sig1,\n            \"Blend should be closer to sig5 (high final-objective IC) than sig1\"\n        )\n\n\nif __name__ == '__main__':\n    unittest.main()","lineStart":1,"lineEnd":751,"totalLines":751,"truncated":false}},"title":"tests\\phase35\\test_p10_multi_horizon_blend.py","time":{"start":1781015549642,"end":1781015549653}},"id":"prt_eaccc9492001leqlGE5C3mF0K1","sessionID":"ses_153369dedffemeV7129OxwCDlM","messageID":"msg_eaccc725e001DNri04AFJWMINY"}}
