{"type":"tool_use","timestamp":1781015371190,"sessionID":"ses_153369dedffemeV7129OxwCDlM","part":{"type":"tool","tool":"read","callID":"tooluse_hwBqrMCMoT7A83IjUMb2Ox","state":{"status":"completed","input":{"filePath":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\src\\omega\\quant\\phase35_walk_forward.py"},"output":"<path>C:\\Users\\GHC\\repos\\OMEGA_QUANT\\src\\omega\\quant\\phase35_walk_forward.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Phase 3.5 Walk-Forward Backtest Engine.\n2: \n3: Version: v21.38-Phase35-Stage3\n4: Date: 2026-05-22\n5: \n6: Walk-forward backtest for 7 Phase 3.4 microstructure alphas using real VN market data.\n7: \n8: COMPLIANCE:\n9:   - PIT Safety: T-1 lag enforcement\n10:   - Vectorization: 100% Pandas/NumPy\n11:   - Error Handling: Graceful degradation\n12:   - Metrics: IC, Sharpe, Max DD per fold\n13: \"\"\"\n14: from __future__ import annotations\n15: \n16: import logging\n17: import sys\n18: import os\n19: from dataclasses import dataclass, field\n20: from pathlib import Path\n21: from typing import Dict, List, Optional, Tuple\n22: import warnings\n23: \n24: import numpy as np\n25: import pandas as pd\n26: from scipy.stats import spearmanr\n27: \n28: from omega.quant.ml_gate_validator import validate_research_gate\n29: from omega.quant.alpha_ensemble_xgboost import XGBoostAlphaEnsemble\n30: \n31: warnings.filterwarnings('ignore')\n32: logger = logging.getLogger(__name__)\n33: \n34: # ---------------------------------------------------------------------------\n35: # Helper: Robust gate verdict evaluation (P10 truthiness hotfix 2026-06-09)\n36: # ---------------------------------------------------------------------------\n37: def _is_gate_verdict_pass(verdict) -> bool:\n38:     \"\"\"Check if a gate verdict represents a pass.\n39:     \n40:     Parameters\n41:     ----------\n42:     verdict : any\n43:         Gate verdict value from validate_research_gate() result dict.\n44:         \n45:     Returns\n46:     -------\n47:     bool\n48:         True if verdict is a pass, False otherwise.\n49:         \n50:     Notes\n51:     -----\n52:     Pass conditions:\n53:     - Boolean True\n54:     - String exactly matching \"PASS\" or \"APPROVED\" (case-insensitive)\n55:     \n56:     Fail conditions:\n57:     - Boolean False\n58:     - String starting with \"FAIL\", \"REJECT\", \"NEEDS_FIX\" (case-insensitive)\n59:     - None, empty string, or missing value\n60:     - Any other string not explicitly recognized as pass\n61:     \n62:     This prevents truthiness bugs where non-empty fail strings like\n63:     \"FAIL: insufficient samples\" are incorrectly treated as pass.\n64:     \"\"\"\n65:     # Boolean True is pass\n66:     if verdict is True:\n67:         return True\n68:     \n69:     # Boolean False, None, or missing is fail\n70:     if verdict is False or verdict is None:\n71:         return False\n72:     \n73:     # String verdict: check for explicit pass/fail markers\n74:     if isinstance(verdict, str):\n75:         verdict_upper = verdict.strip().upper()\n76:         \n77:         # Empty string is fail\n78:         if not verdict_upper:\n79:             return False\n80:         \n81:         # Explicit pass markers\n82:         if verdict_upper in (\"PASS\", \"APPROVED\"):\n83:             return True\n84:         \n85:         # Explicit fail markers\n86:         if verdict_upper.startswith((\"FAIL\", \"REJECT\", \"NEEDS_FIX\")):\n87:             return False\n88:         \n89:         # Any other string is treated as fail (conservative)\n90:         return False\n91:     \n92:     # Any other type is treated as fail\n93:     return False\n94: \n95: # ---------------------------------------------------------------------------\n96: # Stage 2: reuse sector-cap enforcement from alpha_pipeline (no duplication)\n97: # ---------------------------------------------------------------------------\n98: def _import_apply_sector_caps():\n99:     \"\"\"Lazy import of _apply_sector_caps from alpha_pipeline.\n100: \n101:     Searches for alpha_pipeline.py relative to this file's location so the\n102:     import works regardless of the working directory.\n103:     \"\"\"\n104:     _scripts_dir = str(Path(__file__).resolve().parents[3] / \"scripts\")\n105:     if _scripts_dir not in sys.path:\n106:         sys.path.insert(0, _scripts_dir)\n107:     from alpha_pipeline import _apply_sector_caps  # noqa: PLC0415\n108:     return _apply_sector_caps\n109: \n110: \n111: @dataclass\n112: class FoldMetrics:\n113:     \"\"\"Metrics for a single walk-forward fold.\"\"\"\n114:     fold_id: int\n115:     train_start: str\n116:     train_end: str\n117:     test_start: str\n118:     test_end: str\n119:     alpha_ics: Dict[str, float] = field(default_factory=dict)\n120:     portfolio_sharpe: float = 0.0\n121:     portfolio_max_dd: float = 0.0\n122:     portfolio_total_return: float = 0.0\n123:     portfolio_pnl_vnd: float = 0.0\n124:     portfolio_ic: float = 0.0\n125:     raw_signal_ic: float = 0.0\n126:     raw_signal_daily_cs_ic: float = 0.0\n127:     n_train_samples: int = 0\n128:     n_test_samples: int = 0\n129:     # Stage 3 ML Gate fields\n130:     gate_results: Dict[str, dict] = field(default_factory=dict)\n131:     gated_alphas: List[str] = field(default_factory=list)\n132: \n133: \n134: @dataclass\n135: class WalkForwardResult:\n136:     \"\"\"Complete walk-forward backtest results.\"\"\"\n137:     fold_metrics: List[FoldMetrics] = field(default_factory=list)\n138:     avg_ic_by_alpha: Dict[str, float] = field(default_factory=dict)\n139:     avg_portfolio_sharpe: float = 0.0\n140:     avg_portfolio_max_dd: float = 0.0\n141:     avg_portfolio_ic: float = 0.0\n142:     avg_raw_signal_ic: float = 0.0\n143:     avg_raw_signal_daily_cs_ic: float = 0.0\n144:     avg_portfolio_pnl_vnd: float = 0.0\n145:     total_folds: int = 0\n146:     \n147:     def summary(self) -> str:\n148:         \"\"\"Generate summary string.\"\"\"\n149:         lines = [\n150:             f\"Walk-Forward Backtest Results ({self.total_folds} folds)\",\n151:             \"=\" * 60,\n152:             f\"Average Portfolio IC (post Stage 2): {self.avg_portfolio_ic:.4f}\",\n153:             f\"Average Raw Signal IC (pre Stage 2):  {self.avg_raw_signal_ic:.4f}\",\n154:             f\"Average Raw Signal Daily CS IC:       {self.avg_raw_signal_daily_cs_ic:.4f}\",\n155:             f\"Average Portfolio Sharpe: {self.avg_portfolio_sharpe:.4f}\",\n156:             f\"Average Max Drawdown: {self.avg_portfolio_max_dd:.2%}\",\n157:             \"\",\n158:             \"Alpha IC Summary:\",\n159:         ]\n160:         \n161:         for alpha, ic in sorted(self.avg_ic_by_alpha.items(), key=lambda x: abs(x[1]), reverse=True):\n162:             lines.append(f\"  {alpha}: {ic:.4f}\")\n163:         \n164:         return \"\\n\".join(lines)\n165: \n166: \n167: class Phase35WalkForwardEngine:\n168:     \"\"\"Walk-forward backtest engine for Phase 3.4 microstructure alphas.\"\"\"\n169:     \n170:     def __init__(\n171:         self,\n172:         alpha_module,\n173:         min_ic_threshold: float = 0.02,\n174:         top_n_alphas: int = 5,\n175:         top_n_stocks: int = 15,\n176:         rebalance_freq: int = 7,\n177:         sector_cap_pct: float = 0.40,\n178:         use_xgboost: bool = False,\n179:         cost_aware: bool = False,\n180:         cost_per_turnover: float = 0.0025,\n181:         drawdown_control: bool = False,\n182:         drawdown_threshold: float = 0.05,\n183:         strategy: str = \"multi_factor\",\n184:         initial_capital: float = 1_000_000_000.0,\n185:         enable_evolved: bool = False,\n186:         evolved_blend_weight: float = 0.5,\n187:         multi_horizon_blend: bool = False,\n188:         blend_horizons: Optional[List[int]] = None,\n189:         blend_weight_method: str = \"validation_ic\",\n190:     ):\n191:         \"\"\"Initialize walk-forward engine.\n192:         \n193:         Parameters\n194:         ----------\n195:         alpha_module : module\n196:             Module containing compute_phase34_microstructure_alphas function\n197:         min_ic_threshold : float\n198:             Minimum IC threshold for alpha selection\n199:         top_n_alphas : int\n200:             Number of top alphas to use in portfolio\n201:         top_n_stocks : int\n202:             Stage 2 diversification: number of stocks in portfolio (default 15)\n203:         rebalance_freq : int\n204:             Stage 2 diversification: rebalance every N days (default 7)\n205:         sector_cap_pct : float\n206:             Stage 2 diversification: max sector weight fraction (default 0.40)\n207:         use_xgboost : bool\n208:             Stage 4: if True, replace IC-weighted signal with XGBoostAlphaEnsemble\n209:             predictions. Baseline raw-alpha path is used when False (default).\n210:         cost_aware : bool\n211:             Stage 6.2: if True, penalise high-turnover alphas in selection\n212:         cost_per_turnover : float\n213:             Stage 6.2: cost penalty multiplier per unit of turnover (default 0.0025)\n214:         drawdown_control : bool\n215:             Stage 6.3: if True, stop out to cash if max drawdown threshold is breached\n216:         drawdown_threshold : float\n217:             Stage 6.3: drawdown threshold to trigger stop-out (default 0.05)\n218:         strategy : str\n219:             Trading strategy (multi_factor, momentum, mean_reversion)\n220:         initial_capital : float\n221:             Initial capital in VND\n222:         enable_evolved : bool\n223:             If True, run inline GP evolution per fold and blend evolved signal\n224:         evolved_blend_weight : float\n225:             Weight of evolved signal in blend (0-1), remainder is hand-crafted\n226:         multi_horizon_blend : bool\n227:             P10: If True, blend signals from multiple return horizons (T+1, T+3, T+5)\n228:         blend_horizons : list of int, optional\n229:             P10: Horizons to blend (default [1, 3, 5]). Each horizon uses separate\n230:             return_col (fwd_ret_h), embargo, and train/gate/model path.\n231:         blend_weight_method : str\n232:             P10: Method for computing blend weights (default 'validation_ic').\n233:             Options: 'validation_ic', 'train_ic'\n234:         \"\"\"\n235:         self.alpha_module = alpha_module\n236:         self.min_ic_threshold = min_ic_threshold\n237:         self.top_n_alphas = top_n_alphas\n238:         self.top_n_stocks = top_n_stocks\n239:         self.rebalance_freq = rebalance_freq\n240:         self.sector_cap_pct = sector_cap_pct\n241:         self.use_xgboost = use_xgboost\n242:         self.cost_aware = cost_aware\n243:         self.cost_per_turnover = cost_per_turnover\n244:         self.drawdown_control = drawdown_control\n245:         self.drawdown_threshold = drawdown_threshold\n246:         self.strategy = strategy\n247:         self.initial_capital = initial_capital\n248:         self.enable_evolved = enable_evolved\n249:         # Validate and clamp blend weight to [0, 1]\n250:         if not 0 <= evolved_blend_weight <= 1:\n251:             raise ValueError(f\"evolved_blend_weight must be in [0, 1], got {evolved_blend_weight}\")\n252:         self.evolved_blend_weight = evolved_blend_weight\n253:         \n254:         # P10: Multi-horizon blending parameters\n255:         self.multi_horizon_blend = multi_horizon_blend\n256:         self.blend_horizons = blend_horizons if blend_horizons is not None else [1, 3, 5]\n257:         self.blend_weight_method = blend_weight_method\n258:         \n259:         # Store reference alpha columns for feature whitelist\n260:         self.alpha_cols_ref = getattr(alpha_module, 'PHASE34_ALPHA_COLUMNS', [])\n261:     \n262:     def compute_alphas(self, df: pd.DataFrame) -> pd.DataFrame:\n263:         \"\"\"Compute Phase 3.4 alphas on data.\n264:         \n265:         Parameters\n266:         ----------\n267:         df : pd.DataFrame\n268:             OHLCV data with 'ticker', 'date', 'open', 'high', 'low', 'close', 'volume'\n269:         \n270:         Returns\n271:         -------\n272:         pd.DataFrame\n273:             Data with alpha columns added\n274:         \"\"\"\n275:         return self.alpha_module.compute_phase34_microstructure_alphas(\n276:             df,\n277:             symbol_col='ticker',\n278:             date_col='date',\n279:             open_col='open',\n280:             high_col='high',\n281:             low_col='low',\n282:             close_col='close',\n283:             volume_col='volume',\n284:         )\n285:     \n286:     def compute_ic(\n287:         self,\n288:         alpha_values: pd.Series,\n289:         returns: pd.Series,\n290:     ) -> float:\n291:         \"\"\"Compute Spearman IC between alpha and returns.\n292:         \n293:         Parameters\n294:         ----------\n295:         alpha_values : pd.Series\n296:             Alpha signal values\n297:         returns : pd.Series\n298:             Forward returns\n299:         \n300:         Returns\n301:         -------\n302:         float\n303:             Spearman IC\n304:         \"\"\"\n305:         # Remove NaN pairs\n306:         mask = ~(alpha_values.isna() | returns.isna())\n307:         if mask.sum() < 10:\n308:             return 0.0\n309:         \n310:         alpha_clean = alpha_values[mask].values\n311:         returns_clean = returns[mask].values\n312:         \n313:         try:\n314:             ic, _ = spearmanr(alpha_clean, returns_clean)\n315:             return ic if not np.isnan(ic) else 0.0\n316:         except Exception as e:\n317:             logger.warning(f\"IC computation failed: {e}\")\n318:             return 0.0\n319: \n320:     def compute_daily_cs_ic(\n321:         self,\n322:         df: pd.DataFrame,\n323:         signal_col: str,\n324:         return_col: str,\n325:         min_cross_section: int = 5,\n326:     ) -> float:\n327:         \"\"\"Compute daily cross-sectional Spearman IC, then average across dates.\n328: \n329:         For each unique date in df, computes Spearman IC between signal_col and\n330:         return_col across tickers. Returns the mean of per-date ICs.\n331: \n332:         Parameters\n333:         ----------\n334:         df : pd.DataFrame\n335:             Must have 'date', signal_col, return_col columns.\n336:         signal_col : str\n337:             Column name for the signal (alpha or portfolio weight).\n338:         return_col : str\n339:             Column name for forward returns.\n340:         min_cross_section : int\n341:             Minimum number of non-NaN pairs per date to compute IC (default 5).\n342: \n343:         Returns\n344:         -------\n345:         float\n346:             Mean daily cross-sectional Spearman IC.\n347:         \"\"\"\n348:         if signal_col not in df.columns or return_col not in df.columns:\n349:             return 0.0\n350: \n351:         def _cs_ic(group: pd.DataFrame) -> float:\n352:             mask = ~(group[signal_col].isna() | group[return_col].isna())\n353:             if mask.sum() < min_cross_section:\n354:                 return np.nan\n355:             try:\n356:                 ic, _ = spearmanr(\n357:                     group.loc[mask, signal_col].values,\n358:                     group.loc[mask, return_col].values,\n359:                 )\n360:                 return ic if not np.isnan(ic) else np.nan\n361:             except Exception:\n362:                 return np.nan\n363: \n364:         daily_ics = df.groupby('date').apply(_cs_ic, include_groups=False)\n365:         valid = daily_ics.dropna()\n366:         if valid.empty:\n367:             return 0.0\n368:         return float(valid.mean())\n369: \n370:     def _evolve_inline_signal(\n371:         self,\n372:         train_df: pd.DataFrame,\n373:         test_df: pd.DataFrame,\n374:         return_col: str,\n375:     ) -> Tuple[Optional[np.ndarray], float]:\n376:         \"\"\"Run inline GP evolution on train_df, execute best on test_df.\n377: \n378:         PIT-safe: evolves only on train_actual, executes on test_df.\n379:         Returns (evolved_signal_array, train_ic) or (None, 0.0) on failure.\n380:         train_ic is used by caller for adaptive blend weighting.\n381:         \"\"\"\n382:         try:\n383:             from omega.quant.evolution.genetic_engine import GeneticEngine, GPConfig\n384:         except ImportError:\n385:             logger.warning(\"Cannot import GeneticEngine, skipping evolved signal\")\n386:             return None, 0.0\n387: \n388:         # Extract features from train_df (OHLCV + any alpha/feature columns)\n389:         base_cols = ['open', 'high', 'low', 'close', 'volume']\n390:         # Add any additional numeric columns available (alphas, fwd returns, etc.)\n391:         alpha_cols = [c for c in self.alpha_cols_ref if c in train_df.columns]\n392:         \n393:         # Explicitly exclude return_col and any fwd_ret_* columns (prevent look-ahead leak)\n394:         exclude_patterns = [return_col] + [c for c in train_df.columns if c.startswith('fwd_ret_')]\n395:         available_cols = [c for c in base_cols + alpha_cols \n396:                          if c in train_df.columns and c not in exclude_patterns]\n397:         \n398:         if len(available_cols) < 5:\n399:             logger.warning(f\"Insufficient features ({len(available_cols)}), skipping evolution\")\n400:             return None, 0.0\n401: \n402:         # PIT Safety: T-1 lag raw OHLCV per ticker before GP sees them\n403:         # Alpha columns are already T-1 lagged by compute_alphas(), but raw OHLCV are not.\n404:         lagged_train = train_df.copy()\n405:         lagged_test = test_df.copy()\n406:         for col in base_cols:\n407:             if col in lagged_train.columns:\n408:                 lagged_train[col] = lagged_train.groupby('ticker')[col].shift(1)\n409:             if col in lagged_test.columns:\n410:                 lagged_test[col] = lagged_test.groupby('ticker')[col].shift(1)\n411:         # Drop rows with NaN from lagging\n412:         lagged_train = lagged_train.dropna(subset=[c for c in base_cols if c in lagged_train.columns])\n413: \n414:         # Build features dict for train (using lagged OHLCV)\n415:         train_features = {col: lagged_train[col].values for col in available_cols if col in lagged_train.columns}\n416:         # Add target\n417:         if return_col not in lagged_train.columns:\n418:             logger.warning(f\"Target {return_col} not in train_df, skipping evolution\")\n419:             return None, 0.0\n420:         train_target = lagged_train[return_col].values\n421:         # GP config: keep simple to avoid overfitting (V2 proven config)\n422:         # Adaptive blend weight handles quality variance instead\n423:         config = GPConfig(\n424:             population_size=150,\n425:             generations=3,\n426:             max_depth=3,\n427:             hall_of_fame_size=3,\n428:         )\n429:         engine = GeneticEngine(config)\n430:         # features dict = OHLCV + alpha columns, target = forward returns\n431:         train_target = lagged_train[return_col].values\n432:         # Align hall_of_fame evolve with lagged train features\n433:         hall_of_fame = engine.evolve(train_features, train_target)\n434: \n435:         if not hall_of_fame:\n436:             logger.warning(\"Evolution produced no individuals, skipping\")\n437:             return None, 0.0\n438: \n439:         # P1: Ensemble top 3 GP trees (not just best) for robustness\n440:         # Average signals from hall_of_fame[0:3] to reduce variance\n441:         test_features = {col: lagged_test[col].values if col in lagged_test.columns else np.zeros(len(lagged_test))\n442:                         for col in available_cols}\n443:         \n444:         try:\n445:             # Execute all individuals in hall_of_fame\n446:             ensemble_signals = []\n447:             for individual in hall_of_fame:\n448:                 signal = individual._execute_tree(individual.tree, test_features)\n449:                 signal = np.nan_to_num(signal, nan=0.0, posinf=0.0, neginf=0.0)\n450:                 # Normalize each signal to zero mean, unit std\n451:                 std_val = np.std(signal)\n452:                 if std_val > 1e-9:\n453:                     signal = (signal - np.mean(signal)) / std_val\n454:                 ensemble_signals.append(signal)\n455:             \n456:             # Average ensemble signals\n457:             evolved_signal = np.mean(ensemble_signals, axis=0)\n458:             \n459:             # Compute train IC on ensemble signal for adaptive blending\n460:             train_ensemble_signals = []\n461:             for individual in hall_of_fame:\n462:                 signal = individual._execute_tree(individual.tree, train_features)\n463:                 signal = np.nan_to_num(signal, nan=0.0, posinf=0.0, neginf=0.0)\n464:                 # Normalize each signal to zero mean, unit std (same as test side for parity)\n465:                 train_std = np.std(signal)\n466:                 if train_std > 1e-9:\n467:                     signal = (signal - np.mean(signal)) / train_std\n468:                 train_ensemble_signals.append(signal)\n469:             \n470:             train_signal = np.mean(train_ensemble_signals, axis=0)\n471:             train_ic = float(np.corrcoef(train_signal, train_target)[0, 1]) if len(train_signal) > 1 else 0.0\n472:             if np.isnan(train_ic):\n473:                 train_ic = 0.0\n474:             \n475:             test_ret = lagged_test[return_col].values if return_col in lagged_test.columns else np.zeros(len(lagged_test))\n476:             test_ic = float(np.corrcoef(evolved_signal, test_ret)[0, 1]) if len(evolved_signal) > 1 else 0.0\n477:             if np.isnan(test_ic):\n478:                 test_ic = 0.0\n479:             \n480:             logger.info(\n481:                 f\"GP ensemble (n={len(hall_of_fame)}): train_ic={train_ic:.4f}, \"\n482:                 f\"test_ic={test_ic:.4f}, signal_std={np.std(evolved_signal):.4f}\"\n483:             )\n484:             return evolved_signal, train_ic\n485:         except Exception as e:\n486:             logger.error(f\"GP ensemble execution failed: {e}\")\n487:             return None, 0.0\n488:     \n489:     def compute_alpha_ics(\n490:         self,\n491:         df: pd.DataFrame,\n492:         alpha_cols: List[str],\n493:         return_col: str = 'fwd_ret_5',\n494:     ) -> Dict[str, float]:\n495:         \"\"\"Compute IC for each alpha.\n496:         \n497:         Parameters\n498:         ----------\n499:         df : pd.DataFrame\n500:             Data with alpha columns and forward returns\n501:         alpha_cols : list of str\n502:             Alpha column names\n503:         return_col : str\n504:             Forward return column name\n505:         \n506:         Returns\n507:         -------\n508:         dict\n509:             Mapping of alpha name to IC\n510:         \"\"\"\n511:         ics = {}\n512:         \n513:         for alpha_col in alpha_cols:\n514:             if alpha_col not in df.columns:\n515:                 logger.warning(f\"Alpha column {alpha_col} not found\")\n516:                 ics[alpha_col] = 0.0\n517:                 continue\n518:             \n519:             # P8: IC-Decay Weighting - compute IC on 3 sub-windows with exponential decay\n520:             # Weights: [0.2, 0.3, 0.5] for [old, middle, recent] thirds of training data\n521:             dates = sorted(df['date'].unique())\n522:             n_dates = len(dates)\n523:             \n524:             if n_dates >= 30:  # Only apply decay if enough history\n525:                 third = n_dates // 3\n526:                 windows = [\n527:                     (0, third, 0.2),           # oldest third\n528:                     (third, 2*third, 0.3),     # middle third\n529:                     (2*third, n_dates, 0.5)    # most recent third\n530:                 ]\n531:                 \n532:                 weighted_ic = 0.0\n533:                 weight_sum = 0.0\n534:                 \n535:                 for start_idx, end_idx, weight in windows:\n536:                     window_dates = dates[start_idx:end_idx]\n537:                     window_df = df[df['date'].isin(window_dates)]\n538:                     \n539:                     if len(window_df) > 0:\n540:                         ic_val = self.compute_ic(window_df[alpha_col], window_df[return_col])\n541:                         weighted_ic += ic_val * weight\n542:                         weight_sum += weight\n543:                 \n544:                 if weight_sum > 0:\n545:                     ics[alpha_col] = weighted_ic / weight_sum\n546:                 else:\n547:                     ics[alpha_col] = self.compute_ic(df[alpha_col], df[return_col])\n548:             else:\n549:                 # Fallback to simple IC if insufficient history\n550:                 ic = self.compute_ic(df[alpha_col], df[return_col])\n551:                 ics[alpha_col] = ic\n552:         \n553:         return ics\n554:     \n555:     def _estimate_alpha_turnover(self, df: pd.DataFrame, alpha_col: str) -> float:\n556:         \"\"\"Estimate day-over-day rank turnover of alpha_col in [0, 1].\n557: \n558:         If column missing or single-date DataFrame, return conservative fallback 0.5.\n559:         Turnover = mean( abs( rank_t - rank_{t-1} ) ) / (N_assets - 1)\n560:         \"\"\"\n561:         if alpha_col not in df.columns:\n562:             return 0.5\n563: \n564:         # Check unique dates\n565:         dates = sorted(df['date'].unique())\n566:         if len(dates) < 2:\n567:             return 0.5\n568: \n569:         # Pivoting date x ticker to compute rank turnover\n570:         pivot = df.pivot(index='date', columns='ticker', values=alpha_col)\n571:         \n572:         # Rank cross-sectionally per day, normalized to [0, 1]\n573:         # method='average' is stable, pct=True maps rank to [0, 1]\n574:         ranks = pivot.rank(axis=1, pct=True)\n575:         \n576:         # Day-over-day absolute change in rank pct\n577:         diffs = ranks.diff(axis=0).abs()\n578:         \n579:         # Mean absolute change over time and assets\n580:         # If there are NaN values we drop them\n581:         mean_diff = diffs.mean(axis=1).mean()\n582:         if pd.isna(mean_diff):\n583:             return 0.5\n584:             \n585:         # Clip to ensure in [0, 1]\n586:         return float(np.clip(mean_diff, 0.0, 1.0))\n587: \n588:     def adjust_alphas_for_cost(\n589:         self,\n590:         df: pd.DataFrame,\n591:         alpha_cols: List[str],\n592:         train_ics: Dict[str, float],\n593:         cost_per_turnover: float | None = None,\n594:     ) -> Dict[str, float]:\n595:         \"\"\"Compute cost-adjusted IC for each alpha.\n596: \n597:         adjusted_ic = raw_ic - cost * turnover\n598:         \"\"\"\n599:         if cost_per_turnover is None:\n600:             cost_per_turnover = self.cost_per_turnover\n601: \n602:         adjusted_ics = {}\n603:         for col in alpha_cols:\n604:             raw_ic = train_ics.get(col, 0.0)\n605:             turnover = self._estimate_alpha_turnover(df, col)\n606:             adjusted_ics[col] = raw_ic - cost_per_turnover * turnover\n607: \n608:         return adjusted_ics\n609: \n610:     def select_top_alphas(\n611:         self,\n612:         alpha_ics: Dict[str, float],\n613:     ) -> List[str]:\n614:         \"\"\"Select top N alphas by absolute IC.\n615:         \n616:         Parameters\n617:         ----------\n618:         alpha_ics : dict\n619:             Mapping of alpha name to IC\n620:         \n621:         Returns\n622:         -------\n623:         list of str\n624:             Top N alpha names\n625:         \"\"\"\n626:         # Filter by minimum IC threshold\n627:         valid_alphas = {k: v for k, v in alpha_ics.items() if abs(v) >= self.min_ic_threshold}\n628:         \n629:         if not valid_alphas:\n630:             logger.warning(f\"No alphas meet IC threshold {self.min_ic_threshold}, using all\")\n631:             valid_alphas = alpha_ics\n632:         \n633:         # Sort by absolute IC\n634:         sorted_alphas = sorted(valid_alphas.items(), key=lambda x: abs(x[1]), reverse=True)\n635:         \n636:         # Take top N\n637:         top_alphas = [name for name, _ in sorted_alphas[:self.top_n_alphas]]\n638:         \n639:         logger.info(f\"Selected top {len(top_alphas)} alphas: {top_alphas}\")\n640:         \n641:         return top_alphas\n642:     \n643:     def validate_alpha_with_research_gate(\n644:         self,\n645:         top_alphas: List[str],\n646:         train_ics: Dict[str, float],\n647:         train_df_clean: pd.DataFrame,\n648:         return_col: str = 'fwd_ret_5',\n649:         rolling_window: int = 20,\n650:     ) -> Tuple[List[str], Dict[str, dict]]:\n651:         \"\"\"Filter top_alphas through Research Gate using embargoed train_df_clean.\n652: \n653:         Computes a rolling IC series (rolling_window-day window) from daily\n654:         cross-sectional ICs on train_df_clean (PIT safe — no look-ahead).\n655:         Each alpha is validated via validate_research_gate(). Alphas that pass\n656:         are returned as gated_alphas. If all fail, falls back to top_alphas.\n657: \n658:         Parameters\n659:         ----------\n660:         top_alphas : list of str\n661:             Candidate alpha names from select_top_alphas().\n662:         train_ics : dict\n663:             Per-alpha IC on embargoed train set (used as val_ic).\n664:         train_df_clean : pd.DataFrame\n665:             Embargoed training data with alpha columns and return_col.\n666:         return_col : str\n667:             Forward return column name.\n668:         rolling_window : int\n669:             Window size for rolling IC series (default 20).\n670: \n671:         Returns\n672:         -------\n673:         gated_alphas : list of str\n674:             Alphas that passed the Research Gate (or fallback = top_alphas).\n675:         gate_results : dict\n676:             Mapping of alpha name -> validate_research_gate() result dict.\n677: \n678:         Notes\n679:         -----\n680:         PIT Safety: rolling IC is computed solely on train_df_clean which has\n681:         the embargo applied upstream. No test-period data is used here.\n682:         \"\"\"\n683:         gate_results: Dict[str, dict] = {}\n684: \n685:         # Compute daily cross-sectional IC per alpha on embargoed train set\n686:         # Vectorized: groupby date, compute all alpha ICs per group\n687:         dates = sorted(train_df_clean['date'].unique())\n688:         _avail_alphas = [a for a in top_alphas if a in train_df_clean.columns]\n689: \n690:         def _daily_ics(group: pd.DataFrame) -> pd.Series:\n691:             \"\"\"Return Series of IC per alpha for one date group.\"\"\"\n692:             ret = group[return_col]\n693:             ics = {}\n694:             for alpha in _avail_alphas:\n695:                 mask = ~(group[alpha].isna() | ret.isna())\n696:                 if mask.sum() < 5:\n697:                     ics[alpha] = np.nan\n698:                     continue\n699:                 try:\n700:                     ic_val, _ = spearmanr(\n701:                         group.loc[mask, alpha].values,\n702:                         group.loc[mask, return_col].values,\n703:                     )\n704:                     ics[alpha] = ic_val if not np.isnan(ic_val) else np.nan\n705:                 except Exception:\n706:                     ics[alpha] = np.nan\n707:             return pd.Series(ics)\n708: \n709:         ic_df = train_df_clean.groupby('date').apply(\n710:             _daily_ics, include_groups=False\n711:         )  # index=date, columns=alphas\n712: \n713:         daily_ics: Dict[str, pd.Series] = {}\n714:         for alpha in top_alphas:\n715:             if alpha in ic_df.columns:\n716:                 daily_ics[alpha] = ic_df[alpha].reindex(dates)\n717:             else:\n718:                 daily_ics[alpha] = pd.Series(dtype=float)\n719: \n720:         # Validate each alpha through Research Gate\n721:         gated_alphas: List[str] = []\n722:         for alpha in top_alphas:\n723:             val_ic = train_ics.get(alpha, 0.0)\n724:             raw_daily = daily_ics.get(alpha, pd.Series(dtype=float))\n725:             # Rolling mean IC series (drop NaN before rolling)\n726:             rolling_ic = raw_daily.dropna().rolling(window=rolling_window).mean().dropna()\n727:             result = validate_research_gate(val_ic, rolling_ic)\n728:             gate_results[alpha] = result\n729:             if result['passed']:\n730:                 gated_alphas.append(alpha)\n731:             logger.info(\n732:                 f\"Research Gate [{alpha}]: {result['verdict']} \"\n733:                 f\"(val_ic={val_ic:.4f}, n_samples={result['n_samples']})\"\n734:             )\n735: \n736:         # Fallback: if all alphas fail gate, use original top_alphas\n737:         if not gated_alphas:\n738:             logger.warning(\n739:                 \"All alphas failed Research Gate — falling back to top_alphas \"\n740:                 f\"({top_alphas})\"\n741:             )\n742:             gated_alphas = list(top_alphas)\n743: \n744:         logger.info(f\"Gated alphas ({len(gated_alphas)}/{len(top_alphas)}): {gated_alphas}\")\n745:         return gated_alphas, gate_results\n746:     \n747:     def compute_portfolio_signal(\n748:         self,\n749:         df: pd.DataFrame,\n750:         alpha_cols: List[str],\n751:         alpha_ics: Dict[str, float],\n752:     ) -> pd.Series:\n753:         \"\"\"Compute IC-weighted portfolio signal.\n754:         \n755:         Parameters\n756:         ----------\n757:         df : pd.DataFrame\n758:             Data with alpha columns\n759:         alpha_cols : list of str\n760:             Alpha column names to combine\n761:         alpha_ics : dict\n762:             IC weights for each alpha\n763:         \n764:         Returns\n765:         -------\n766:         pd.Series\n767:             Combined portfolio signal\n768:         \"\"\"\n769:         # Extract IC weights\n770:         weights = np.array([alpha_ics.get(col, 0.0) for col in alpha_cols])\n771:         \n772:         # Normalize weights to sum to 1\n773:         weight_sum = np.abs(weights).sum()\n774:         if weight_sum > 0:\n775:             weights = weights / weight_sum\n776:         else:\n777:             weights = np.ones(len(weights)) / len(weights)\n778:         \n779:         # Per-alpha z-score normalization (cross-sectional per date) BEFORE blend\n780:         # Prevents high-scale alphas from dominating IC-weighted combination\n781:         df_norm = df[alpha_cols].copy()\n782:         for col in alpha_cols:\n783:             df_norm[col] = df.groupby('date')[col].transform(\n784:                 lambda x: (x - x.mean()) / (x.std() + 1e-9)\n785:             )\n786:         \n787:         # Compute weighted average on normalized alphas\n788:         alpha_matrix = df_norm[alpha_cols].values\n789:         portfolio_signal = alpha_matrix @ weights\n790:         \n791:         return pd.Series(portfolio_signal, index=df.index)\n792:     \n793:     def compute_sharpe_ratio(\n794:         self,\n795:         returns: pd.Series,\n796:         periods_per_year: int = 252,\n797:     ) -> float:\n798:         \"\"\"Compute annualized Sharpe ratio.\n799:         \n800:         Parameters\n801:         ----------\n802:         returns : pd.Series\n803:             Period returns\n804:         periods_per_year : int\n805:             Number of periods per year (252 for daily)\n806:         \n807:         Returns\n808:         -------\n809:         float\n810:             Annualized Sharpe ratio\n811:         \"\"\"\n812:         if len(returns) < 2:\n813:             return 0.0\n814:         \n815:         mean_return = returns.mean()\n816:         std_return = returns.std()\n817:         \n818:         if std_return == 0 or np.isnan(std_return):\n819:             return 0.0\n820:         \n821:         sharpe = (mean_return / std_return) * np.sqrt(periods_per_year)\n822:         \n823:         return sharpe if not np.isnan(sharpe) else 0.0\n824:     \n825:     def compute_max_drawdown(\n826:         self,\n827:         returns: pd.Series,\n828:     ) -> float:\n829:         \"\"\"Compute maximum drawdown.\n830:         \n831:         Parameters\n832:         ----------\n833:         returns : pd.Series\n834:             Period returns\n835:         \n836:         Returns\n837:         -------\n838:         float\n839:             Maximum drawdown (negative value)\n840:         \"\"\"\n841:         if len(returns) < 2:\n842:             return 0.0\n843:         \n844:         # Compute cumulative returns\n845:         cum_returns = (1 + returns).cumprod()\n846:         \n847:         # Compute running maximum\n848:         running_max = cum_returns.expanding().max()\n849:         \n850:         # Compute drawdown\n851:         drawdown = (cum_returns - running_max) / running_max\n852:         \n853:         # Return maximum drawdown (most negative)\n854:         max_dd = drawdown.min()\n855:         \n856:         return max_dd if not np.isnan(max_dd) else 0.0\n857:     \n858:     def _compute_sequential_dynamic_freq(\n859:         self,\n860:         train_df: pd.DataFrame,\n861:         available_test_df: pd.DataFrame,\n862:         base_freq: int = 7,\n863:     ) -> int:\n864:         \"\"\"Compute dynamic rebalance frequency for a specific point in time.\n865:         \n866:         P9 v4 (PIT-safe): Adjust rebalance frequency based on market volatility regime\n867:         using only data available up to the decision point.\n868:         \n869:         - Compare CURRENT volatility (recent available data) vs HISTORICAL baseline (train period)\n870:         - High volatility (current > 1.5x baseline): rebalance more often (freq=5)\n871:         - Low volatility (current < 0.67x baseline): rebalance less often (freq=10)\n872:         - Medium volatility: use base_freq (7)\n873:         \n874:         Parameters\n875:         ----------\n876:         train_df : pd.DataFrame\n877:             Training period data with 'close' and 'date' columns (historical baseline)\n878:         available_test_df : pd.DataFrame\n879:             Test period data available up to (but not including) the decision date.\n880:             Must contain only rows with date < decision_date for PIT safety.\n881:         base_freq : int\n882:             Default rebalance frequency\n883:             \n884:         Returns\n885:         -------\n886:         int\n887:             Adjusted rebalance frequency\n888:             \n889:         Notes\n890:         -----\n891:         PIT safety: This function only uses train_df and available_test_df (strictly\n892:         prior dates). The caller is responsible for filtering test_df to exclude\n893:         current and future dates relative to the decision point.\n894:         \"\"\"\n895:         # Guard: if train_df not provided, cannot compute baseline\n896:         if train_df is None or train_df.empty:\n897:             logger.warning(\"P9: train_df is None/empty, cannot compute baseline vol, using base_freq\")\n898:             return base_freq\n899:         \n900:         # Compute baseline volatility from TRAINING period (historical).\n901:         # Sort first: pct_change is order-sensitive inside each ticker group.\n902:         train_work = train_df.sort_values(['ticker', 'date'])\n903:         train_returns = train_work.groupby('ticker')['close'].pct_change().clip(-0.5, 0.5)\n904:         train_daily_vol = train_returns.groupby(train_work['date']).std()\n905:         train_median_vol = train_daily_vol.median()\n906:         \n907:         if pd.isna(train_median_vol) or train_median_vol < 1e-9:\n908:             logger.warning(\"P9: Cannot compute baseline volatility from train_df, using base_freq\")\n909:             return base_freq\n910:         \n911:         # Compute current volatility from AVAILABLE test data (strictly prior dates).\n912:         # If no test data available yet (first OOS date), use train baseline only.\n913:         if available_test_df is None or available_test_df.empty:\n914:             # No OOS data available yet: use train median as current estimate\n915:             current_vol = train_median_vol\n916:             logger.debug(\"P9: No available test data, using train baseline as current vol\")\n917:         else:\n918:             # Sort first: pct_change is order-sensitive inside each ticker group.\n919:             # Clip like forward returns to avoid corporate-action/data jumps dominating regime.\n920:             test_work = available_test_df.sort_values(['ticker', 'date'])\n921:             test_returns = test_work.groupby('ticker')['close'].pct_change().clip(-0.5, 0.5)\n922:             test_daily_vol = test_returns.groupby(test_work['date']).std()\n923:             \n924:             # Use recent 20-day rolling average for stability\n925:             if len(test_daily_vol) >= 20:\n926:                 current_vol = test_daily_vol.rolling(window=20, min_periods=10).mean().iloc[-1]\n927:             else:\n928:                 current_vol = test_daily_vol.median()\n929:             \n930:             if pd.isna(current_vol):\n931:                 current_vol = test_daily_vol.median()\n932:             \n933:             # Fallback to train baseline if still invalid\n934:             if pd.isna(current_vol):\n935:                 current_vol = train_median_vol\n936:                 logger.debug(\"P9: Could not compute current vol from available test data, using train baseline\")\n937:         \n938:         # Compare current vs baseline\n939:         vol_ratio = current_vol / train_median_vol\n940:         \n941:         if vol_ratio > 1.5:\n942:             # High volatility regime: rebalance more often\n943:             adjusted_freq = max(5, base_freq - 2)\n944:             regime = \"HIGH\"\n945:         elif vol_ratio < 0.67:\n946:             # Low volatility regime: rebalance less often\n947:             adjusted_freq = min(10, base_freq + 3)\n948:             regime = \"LOW\"\n949:         else:\n950:             # Medium volatility regime: use base frequency\n951:             adjusted_freq = base_freq\n952:             regime = \"MEDIUM\"\n953:         \n954:         logger.debug(\n955:             f\"P9 Sequential Dynamic: regime={regime}, current_vol={current_vol:.6f}, \"\n956:             f\"baseline_vol={train_median_vol:.6f}, ratio={vol_ratio:.2f}, freq={base_freq}->{adjusted_freq}\"\n957:         )\n958:         \n959:         return adjusted_freq\n960:     \n961:     def _apply_stage2_constraints(\n962:         self,\n963:         test_df: pd.DataFrame,\n964:         raw_signal: pd.Series,\n965:         top_alphas: List[str],\n966:         dynamic_rebalance: bool = False,\n967:         train_df: Optional[pd.DataFrame] = None,\n968:     ) -> pd.Series:\n969:         \"\"\"Apply Stage 2 behavioral constraints to the raw IC-weighted signal.\n970: \n971:         Enforces in order:\n972:           1. Top-N stock selection per rebalance date (nlargest on signal)\n973:           2. Rebalance cadence (only recompute weights every rebalance_freq dates)\n974:           3. Sector cap (delegate to alpha_pipeline._apply_sector_caps)\n975: \n976:         Parameters\n977:         ----------\n978:         test_df : pd.DataFrame\n979:             Test-set rows with columns 'date', 'ticker', and optionally 'sector'.\n980:             Rows are in the same order as raw_signal.\n981:         raw_signal : pd.Series\n982:             IC-weighted combined signal, indexed identically to test_df.index.\n983:         top_alphas : list of str\n984:             Selected alpha column names (used only for logging context).\n985:         dynamic_rebalance : bool\n986:             If True, adjust rebalance frequency based on market volatility regime.\n987:             P9 v4: Uses sequential PIT-safe frequency computation.\n988:         train_df : pd.DataFrame, optional\n989:             Training data for baseline volatility computation (P9 dynamic rebalance).\n990: \n991:         Returns\n992:         -------\n993:         pd.Series\n994:             Per-row portfolio weight Series, same index as raw_signal.\n995:             Sums to ~1.0 across tickers on each date (after sector cap renorm).\n996: \n997:         Notes\n998:         -----\n999:         PIT safety: test_df signals are already T-1 lagged by compute_alphas().\n1000:         P9 v4: Dynamic rebalance frequency is computed sequentially per rebalance\n1001:         checkpoint using only train_df + strictly prior test dates.\n1002:         \"\"\"\n1003:         top_n = self.top_n_stocks\n1004:         sector_cap = self.sector_cap_pct\n1005: \n1006:         # Attach raw signal to a working frame aligned by position\n1007:         work = test_df[['date', 'ticker']].copy().reset_index(drop=True)\n1008:         work['_signal'] = raw_signal.values\n1009: \n1010:         # Build sector_map from 'sector' column if present\n1011:         if 'sector' in test_df.columns:\n1012:             sector_map: Dict[str, str] = (\n1013:                 test_df[['ticker', 'sector']]\n1014:                 .drop_duplicates('ticker')\n1015:                 .set_index('ticker')['sector']\n1016:                 .to_dict()\n1017:             )\n1018:         else:\n1019:             # No sector metadata: each ticker is its own sector (cap has no effect)\n1020:             sector_map = {t: t for t in work['ticker'].unique()}\n1021: \n1022:         all_sectors = set(sector_map.values())\n1023:         resolved_caps: Dict[str, float] = {s: sector_cap for s in all_sectors}\n1024: \n1025:         # Sorted unique dates in test fold (chronological)\n1026:         sorted_dates = sorted(work['date'].unique())\n1027: \n1028:         # Build wide signal matrix: rows=dates, cols=tickers\n1029:         signal_wide = work.pivot_table(\n1030:             index='date', columns='ticker', values='_signal', aggfunc='first'\n1031:         )\n1032: \n1033:         # Weight matrix (same shape, filled with 0)\n1034:         weight_wide = pd.DataFrame(\n1035:             0.0, index=signal_wide.index, columns=signal_wide.columns\n1036:         )\n1037: \n1038:         last_weights: Optional[pd.Series] = None\n1039:         apply_sector_caps = _import_apply_sector_caps()\n1040:         \n1041:         # P9 v4 fix: Track current rebalance frequency (updated sequentially at checkpoints)\n1042:         # Drive both frequency recompute and rebalance eligibility from elapsed distance\n1043:         current_rebal_freq = self.rebalance_freq\n1044:         last_rebal_checkpoint_idx = None\n1045: \n1046:         for idx, date in enumerate(sorted_dates):\n1047:             if date not in signal_wide.index:\n1048:                 continue\n1049: \n1050:             # P9 v4 fix: Determine if we should rebalance at this date FIRST\n1051:             # Use elapsed distance from last actual checkpoint\n1052:             if last_rebal_checkpoint_idx is None:\n1053:                 # First checkpoint: always rebalance\n1054:                 should_rebalance = (idx == 0)\n1055:             else:\n1056:                 # Check if enough dates have passed since last checkpoint\n1057:                 elapsed = idx - last_rebal_checkpoint_idx\n1058:                 should_rebalance = (elapsed >= current_rebal_freq)\n1059: \n1060:             if should_rebalance:\n1061:                 # P9 v4 fix: At rebalance dates, recompute frequency using PIT-safe data\n1062:                 # BEFORE executing rebalance, so new frequency applies to NEXT interval\n1063:                 if dynamic_rebalance:\n1064:                     # Use only data available strictly BEFORE this date (train_df + prior test dates)\n1065:                     # This ensures no lookahead: decision at date D uses data < D only\n1066:                     available_test = test_df[test_df['date'] < date]\n1067:                     current_rebal_freq = self._compute_sequential_dynamic_freq(\n1068:                         train_df, available_test, self.rebalance_freq\n1069:                     )\n1070:                     logger.debug(\n1071:                         f\"P9 v4: Rebalance at idx={idx}, date={date}, \"\n1072:                         f\"updated freq to {current_rebal_freq} for next interval\"\n1073:                     )\n1074:                 \n1075:                 # Execute rebalance: select top-N by signal, build equal-weight, apply sector cap\n1076:                 alpha_row = signal_wide.loc[date].dropna()\n1077:                 if len(alpha_row) > 0:\n1078:                     top_stocks = alpha_row.nlargest(min(top_n, len(alpha_row)))\n1079:                     target = pd.Series(0.0, index=signal_wide.columns)\n1080:                     target[top_stocks.index] = 1.0 / len(top_stocks)\n1081:                     # Apply sector caps (reuse alpha_pipeline logic, no duplication)\n1082:                     target = apply_sector_caps(target, sector_map, resolved_caps)\n1083:                     last_weights = target\n1084:                 \n1085:                 # Update checkpoint tracker AFTER rebalance\n1086:                 last_rebal_checkpoint_idx = idx\n1087: \n1088:             if last_weights is not None:\n1089:                 weight_wide.loc[date] = last_weights\n1090: \n1091:         # Log final applied frequency (may have changed during fold)\n1092:         logger.info(\n1093:             f\"Stage 2 constraints applied: top_n={top_n}, \"\n1094:             f\"final_rebal_freq={current_rebal_freq}, sector_cap={sector_cap:.0%}, \"\n1095:             f\"alphas={top_alphas}, dynamic={'YES' if dynamic_rebalance else 'NO'}\"\n1096:         )\n1097: \n1098:         # Flatten back to per-row Series aligned with original test_df index\n1099:         work_with_weights = work.merge(\n1100:             weight_wide.stack().rename('_weight').reset_index().rename(\n1101:                 columns={'ticker': 'ticker', 'date': 'date'}\n1102:             ),\n1103:             on=['date', 'ticker'],\n1104:             how='left',\n1105:         )\n1106:         result = work_with_weights['_weight'].fillna(0.0)\n1107:         result.index = raw_signal.index\n1108:         return result\n1109: \n1110:     def _compute_horizon_signal(\n1111:         self,\n1112:         fold_id: int,\n1113:         train_df: pd.DataFrame,\n1114:         test_df: pd.DataFrame,\n1115:         alpha_cols: List[str],\n1116:         return_col: str,\n1117:         horizon: int,\n1118:         cost_aware: bool,\n1119:         final_objective_return_col: str = 'fwd_ret_5',\n1120:     ) -> Tuple[Optional[pd.Series], Dict[str, float], List[str], Dict[str, dict]]:\n1121:         \"\"\"Compute raw signal for a single horizon without Stage 2 constraints.\n1122:         \n1123:         P10: Helper for multi-horizon blending. Computes IC, gates alphas,\n1124:         and produces raw portfolio signal for one return horizon.\n1125:         \n1126:         Parameters\n1127:         ----------\n1128:         fold_id : int\n1129:             Fold identifier (for logging)\n1130:         train_df : pd.DataFrame\n1131:             Training data with alphas already computed\n1132:         test_df : pd.DataFrame\n1133:             Test data with alphas already computed\n1134:         alpha_cols : list of str\n1135:             Alpha column names\n1136:         return_col : str\n1137:             Forward return column for this horizon (e.g., 'fwd_ret_1')\n1138:         horizon : int\n1139:             Horizon length in days (e.g., 1, 3, 5)\n1140:         cost_aware : bool\n1141:             If True, apply cost-aware alpha selection\n1142:         final_objective_return_col : str\n1143:             Final objective return column (usually 'fwd_ret_5') for measuring\n1144:             contribution to final monetization target\n1145:             \n1146:         Returns\n1147:         -------\n1148:         raw_signal : pd.Series or None\n1149:             Raw portfolio signal (no Stage 2 constraints), or None if horizon fails\n1150:         quality_metrics : dict\n1151:             Quality metrics with keys: 'train_ic', 'validation_ic', \n1152:             'final_objective_validation_ic', 'own_target_train_ic', 'own_target_validation_ic'\n1153:         gated_alphas : list of str\n1154:             Alphas that passed research gate for this horizon\n1155:         gate_results : dict\n1156:             Research gate results per alpha\n1157:             \n1158:         Notes\n1159:         -----\n1160:         PIT Safety: Applies horizon-specific embargo (last h rows per ticker).\n1161:         No Stage 2 constraints applied here (caller applies after blending).\n1162:         \n1163:         Gate Failure Detection: If all alphas fail the research gate (all gate\n1164:         results are False), this horizon is excluded (returns None) even if\n1165:         validate_alpha_with_research_gate() falls back to top_alphas.\n1166:         \"\"\"\n1167:         logger.info(f\"[P10] Computing horizon signal: fold={fold_id}, horizon={horizon}, return_col={return_col}\")\n1168:         \n1169:         # Initialize empty quality metrics\n1170:         quality_metrics = {\n1171:             'train_ic': 0.0,\n1172:             'validation_ic': 0.0,\n1173:             'final_objective_validation_ic': 0.0,\n1174:             'own_target_train_ic': 0.0,\n1175:             'own_target_validation_ic': 0.0,\n1176:         }\n1177:         \n1178:         # Check if return_col exists in data\n1179:         if return_col not in train_df.columns or return_col not in test_df.columns:\n1180:             logger.warning(f\"[P10] Return column {return_col} not found, skipping horizon {horizon}\")\n1181:             return None, quality_metrics, [], {}\n1182:         \n1183:         # Horizon-specific embargo: drop last h rows per ticker from train IC computation\n1184:         _tail_rank = train_df.groupby('ticker').cumcount(ascending=False)\n1185:         train_df_clean = train_df[_tail_rank >= horizon].reset_index(drop=True)\n1186:         logger.info(\n1187:             f\"[P10] Horizon {horizon} embargo: \"\n1188:             f\"train rows before={len(train_df)}, after={len(train_df_clean)}\"\n1189:         )\n1190:         \n1191:         if len(train_df_clean) < 10:\n1192:             logger.warning(f\"[P10] Insufficient train data after embargo for horizon {horizon}\")\n1193:             return None, quality_metrics, [], {}\n1194:         \n1195:         # Split into train_actual and validation for IC computation\n1196:         unique_dates = sorted(train_df_clean['date'].unique())\n1197:         if len(unique_dates) >= 3:\n1198:             split_idx = int(len(unique_dates) * 2 / 3)\n1199:             val_start_date = unique_dates[split_idx]\n1200:             train_actual = train_df_clean[train_df_clean['date'] < val_start_date].reset_index(drop=True)\n1201:             val_actual = train_df_clean[train_df_clean['date'] >= val_start_date].reset_index(drop=True)\n1202:         else:\n1203:             train_actual = train_df_clean\n1204:             val_actual = train_df_clean\n1205:         \n1206:         # Compute IC on train_actual using this horizon's return column\n1207:         train_ics = self.compute_alpha_ics(train_actual, alpha_cols, return_col)\n1208:         \n1209:         # Strategy filter: momentum only keeps positive IC alphas\n1210:         if hasattr(self, \"strategy\") and self.strategy == \"momentum\":\n1211:             train_ics = {k: v for k, v in train_ics.items() if v > 0.0}\n1212:         \n1213:         logger.info(f\"[P10] Horizon {horizon} train ICs: {train_ics}\")\n1214:         \n1215:         # Cost-aware alpha selection if enabled\n1216:         if cost_aware:\n1217:             adjusted_ics = self.adjust_alphas_for_cost(train_actual, alpha_cols, train_ics)\n1218:             top_alphas = self.select_top_alphas(adjusted_ics)\n1219:         else:\n1220:             top_alphas = self.select_top_alphas(train_ics)\n1221:         \n1222:         # Research gate validation using validation set\n1223:         gated_alphas, gate_results = self.validate_alpha_with_research_gate(\n1224:             top_alphas=top_alphas,\n1225:             train_ics=train_ics,\n1226:             train_df_clean=val_actual,\n1227:             return_col=return_col,\n1228:         )\n1229:         \n1230:         # FIX 2: Check if research gate actually passed any alphas\n1231:         # If all alphas failed gate (all verdict=False), exclude this horizon\n1232:         # Use robust verdict checker to avoid truthiness bugs (P10 hotfix 2026-06-09)\n1233:         gate_passed_count = sum(1 for res in gate_results.values() if _is_gate_verdict_pass(res.get('verdict')))\n1234:         if gate_passed_count == 0:\n1235:             logger.warning(\n1236:                 f\"[P10] Research gate failed all alphas for horizon {horizon} \"\n1237:                 f\"({len(gate_results)} alphas tested, 0 passed) - excluding horizon\"\n1238:             )\n1239:             return None, quality_metrics, [], gate_results\n1240:         \n1241:         if len(gated_alphas) == 0:\n1242:             logger.warning(f\"[P10] No alphas passed gate for horizon {horizon}\")\n1243:             return None, quality_metrics, [], gate_results\n1244:         \n1245:         # Compute raw portfolio signal (IC-weighted, no XGBoost for multi-horizon)\n1246:         # XGBoost is disabled in multi-horizon mode to keep implementation simple\n1247:         portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n1248:         \n1249:         # Z-score normalize signal (cross-sectional per date)\n1250:         test_df_copy = test_df.copy()\n1251:         test_df_copy['_signal'] = portfolio_signal\n1252:         test_df_copy['_signal'] = test_df_copy.groupby('date')['_signal'].transform(\n1253:             lambda x: (x - x.mean()) / (x.std() + 1e-9)\n1254:         )\n1255:         portfolio_signal = test_df_copy['_signal']\n1256:         \n1257:         # FIX 1 & 5: Compute comprehensive quality metrics\n1258:         # Own-target train IC\n1259:         train_signal = self.compute_portfolio_signal(train_actual, gated_alphas, train_ics)\n1260:         own_target_train_ic = self.compute_ic(train_signal, train_actual[return_col]) if return_col in train_actual.columns else 0.0\n1261:         \n1262:         # Own-target validation IC\n1263:         val_signal = self.compute_portfolio_signal(val_actual, gated_alphas, train_ics)\n1264:         own_target_validation_ic = self.compute_ic(val_signal, val_actual[return_col]) if return_col in val_actual.columns else 0.0\n1265:         \n1266:         # Final objective train IC (contribution to final monetization target on train set)\n1267:         final_objective_train_ic = 0.0\n1268:         if final_objective_return_col in train_actual.columns:\n1269:             final_objective_train_ic = self.compute_ic(train_signal, train_actual[final_objective_return_col])\n1270:         \n1271:         # Final objective validation IC (contribution to final monetization target)\n1272:         final_objective_validation_ic = 0.0\n\n(Output capped at 50 KB. Showing lines 1-1272. Use offset=1273 to continue.)\n</content>","metadata":{"preview":"\"\"\"Phase 3.5 Walk-Forward Backtest Engine.\n\nVersion: v21.38-Phase35-Stage3\nDate: 2026-05-22\n\nWalk-forward backtest for 7 Phase 3.4 microstructure alphas using real VN market data.\n\nCOMPLIANCE:\n  - PIT Safety: T-1 lag enforcement\n  - Vectorization: 100% Pandas/NumPy\n  - Error Handling: Graceful degradation\n  - Metrics: IC, Sharpe, Max DD per fold\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport sys\nimport os\nfrom dataclasses import dataclass, field\nfrom pathlib import Path","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\src\\omega\\quant\\phase35_walk_forward.py","text":"\"\"\"Phase 3.5 Walk-Forward Backtest Engine.\n\nVersion: v21.38-Phase35-Stage3\nDate: 2026-05-22\n\nWalk-forward backtest for 7 Phase 3.4 microstructure alphas using real VN market data.\n\nCOMPLIANCE:\n  - PIT Safety: T-1 lag enforcement\n  - Vectorization: 100% Pandas/NumPy\n  - Error Handling: Graceful degradation\n  - Metrics: IC, Sharpe, Max DD per fold\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport sys\nimport os\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import spearmanr\n\nfrom omega.quant.ml_gate_validator import validate_research_gate\nfrom omega.quant.alpha_ensemble_xgboost import XGBoostAlphaEnsemble\n\nwarnings.filterwarnings('ignore')\nlogger = logging.getLogger(__name__)\n\n# ---------------------------------------------------------------------------\n# Helper: Robust gate verdict evaluation (P10 truthiness hotfix 2026-06-09)\n# ---------------------------------------------------------------------------\ndef _is_gate_verdict_pass(verdict) -> bool:\n    \"\"\"Check if a gate verdict represents a pass.\n    \n    Parameters\n    ----------\n    verdict : any\n        Gate verdict value from validate_research_gate() result dict.\n        \n    Returns\n    -------\n    bool\n        True if verdict is a pass, False otherwise.\n        \n    Notes\n    -----\n    Pass conditions:\n    - Boolean True\n    - String exactly matching \"PASS\" or \"APPROVED\" (case-insensitive)\n    \n    Fail conditions:\n    - Boolean False\n    - String starting with \"FAIL\", \"REJECT\", \"NEEDS_FIX\" (case-insensitive)\n    - None, empty string, or missing value\n    - Any other string not explicitly recognized as pass\n    \n    This prevents truthiness bugs where non-empty fail strings like\n    \"FAIL: insufficient samples\" are incorrectly treated as pass.\n    \"\"\"\n    # Boolean True is pass\n    if verdict is True:\n        return True\n    \n    # Boolean False, None, or missing is fail\n    if verdict is False or verdict is None:\n        return False\n    \n    # String verdict: check for explicit pass/fail markers\n    if isinstance(verdict, str):\n        verdict_upper = verdict.strip().upper()\n        \n        # Empty string is fail\n        if not verdict_upper:\n            return False\n        \n        # Explicit pass markers\n        if verdict_upper in (\"PASS\", \"APPROVED\"):\n            return True\n        \n        # Explicit fail markers\n        if verdict_upper.startswith((\"FAIL\", \"REJECT\", \"NEEDS_FIX\")):\n            return False\n        \n        # Any other string is treated as fail (conservative)\n        return False\n    \n    # Any other type is treated as fail\n    return False\n\n# ---------------------------------------------------------------------------\n# Stage 2: reuse sector-cap enforcement from alpha_pipeline (no duplication)\n# ---------------------------------------------------------------------------\ndef _import_apply_sector_caps():\n    \"\"\"Lazy import of _apply_sector_caps from alpha_pipeline.\n\n    Searches for alpha_pipeline.py relative to this file's location so the\n    import works regardless of the working directory.\n    \"\"\"\n    _scripts_dir = str(Path(__file__).resolve().parents[3] / \"scripts\")\n    if _scripts_dir not in sys.path:\n        sys.path.insert(0, _scripts_dir)\n    from alpha_pipeline import _apply_sector_caps  # noqa: PLC0415\n    return _apply_sector_caps\n\n\n@dataclass\nclass FoldMetrics:\n    \"\"\"Metrics for a single walk-forward fold.\"\"\"\n    fold_id: int\n    train_start: str\n    train_end: str\n    test_start: str\n    test_end: str\n    alpha_ics: Dict[str, float] = field(default_factory=dict)\n    portfolio_sharpe: float = 0.0\n    portfolio_max_dd: float = 0.0\n    portfolio_total_return: float = 0.0\n    portfolio_pnl_vnd: float = 0.0\n    portfolio_ic: float = 0.0\n    raw_signal_ic: float = 0.0\n    raw_signal_daily_cs_ic: float = 0.0\n    n_train_samples: int = 0\n    n_test_samples: int = 0\n    # Stage 3 ML Gate fields\n    gate_results: Dict[str, dict] = field(default_factory=dict)\n    gated_alphas: List[str] = field(default_factory=list)\n\n\n@dataclass\nclass WalkForwardResult:\n    \"\"\"Complete walk-forward backtest results.\"\"\"\n    fold_metrics: List[FoldMetrics] = field(default_factory=list)\n    avg_ic_by_alpha: Dict[str, float] = field(default_factory=dict)\n    avg_portfolio_sharpe: float = 0.0\n    avg_portfolio_max_dd: float = 0.0\n    avg_portfolio_ic: float = 0.0\n    avg_raw_signal_ic: float = 0.0\n    avg_raw_signal_daily_cs_ic: float = 0.0\n    avg_portfolio_pnl_vnd: float = 0.0\n    total_folds: int = 0\n    \n    def summary(self) -> str:\n        \"\"\"Generate summary string.\"\"\"\n        lines = [\n            f\"Walk-Forward Backtest Results ({self.total_folds} folds)\",\n            \"=\" * 60,\n            f\"Average Portfolio IC (post Stage 2): {self.avg_portfolio_ic:.4f}\",\n            f\"Average Raw Signal IC (pre Stage 2):  {self.avg_raw_signal_ic:.4f}\",\n            f\"Average Raw Signal Daily CS IC:       {self.avg_raw_signal_daily_cs_ic:.4f}\",\n            f\"Average Portfolio Sharpe: {self.avg_portfolio_sharpe:.4f}\",\n            f\"Average Max Drawdown: {self.avg_portfolio_max_dd:.2%}\",\n            \"\",\n            \"Alpha IC Summary:\",\n        ]\n        \n        for alpha, ic in sorted(self.avg_ic_by_alpha.items(), key=lambda x: abs(x[1]), reverse=True):\n            lines.append(f\"  {alpha}: {ic:.4f}\")\n        \n        return \"\\n\".join(lines)\n\n\nclass Phase35WalkForwardEngine:\n    \"\"\"Walk-forward backtest engine for Phase 3.4 microstructure alphas.\"\"\"\n    \n    def __init__(\n        self,\n        alpha_module,\n        min_ic_threshold: float = 0.02,\n        top_n_alphas: int = 5,\n        top_n_stocks: int = 15,\n        rebalance_freq: int = 7,\n        sector_cap_pct: float = 0.40,\n        use_xgboost: bool = False,\n        cost_aware: bool = False,\n        cost_per_turnover: float = 0.0025,\n        drawdown_control: bool = False,\n        drawdown_threshold: float = 0.05,\n        strategy: str = \"multi_factor\",\n        initial_capital: float = 1_000_000_000.0,\n        enable_evolved: bool = False,\n        evolved_blend_weight: float = 0.5,\n        multi_horizon_blend: bool = False,\n        blend_horizons: Optional[List[int]] = None,\n        blend_weight_method: str = \"validation_ic\",\n    ):\n        \"\"\"Initialize walk-forward engine.\n        \n        Parameters\n        ----------\n        alpha_module : module\n            Module containing compute_phase34_microstructure_alphas function\n        min_ic_threshold : float\n            Minimum IC threshold for alpha selection\n        top_n_alphas : int\n            Number of top alphas to use in portfolio\n        top_n_stocks : int\n            Stage 2 diversification: number of stocks in portfolio (default 15)\n        rebalance_freq : int\n            Stage 2 diversification: rebalance every N days (default 7)\n        sector_cap_pct : float\n            Stage 2 diversification: max sector weight fraction (default 0.40)\n        use_xgboost : bool\n            Stage 4: if True, replace IC-weighted signal with XGBoostAlphaEnsemble\n            predictions. Baseline raw-alpha path is used when False (default).\n        cost_aware : bool\n            Stage 6.2: if True, penalise high-turnover alphas in selection\n        cost_per_turnover : float\n            Stage 6.2: cost penalty multiplier per unit of turnover (default 0.0025)\n        drawdown_control : bool\n            Stage 6.3: if True, stop out to cash if max drawdown threshold is breached\n        drawdown_threshold : float\n            Stage 6.3: drawdown threshold to trigger stop-out (default 0.05)\n        strategy : str\n            Trading strategy (multi_factor, momentum, mean_reversion)\n        initial_capital : float\n            Initial capital in VND\n        enable_evolved : bool\n            If True, run inline GP evolution per fold and blend evolved signal\n        evolved_blend_weight : float\n            Weight of evolved signal in blend (0-1), remainder is hand-crafted\n        multi_horizon_blend : bool\n            P10: If True, blend signals from multiple return horizons (T+1, T+3, T+5)\n        blend_horizons : list of int, optional\n            P10: Horizons to blend (default [1, 3, 5]). Each horizon uses separate\n            return_col (fwd_ret_h), embargo, and train/gate/model path.\n        blend_weight_method : str\n            P10: Method for computing blend weights (default 'validation_ic').\n            Options: 'validation_ic', 'train_ic'\n        \"\"\"\n        self.alpha_module = alpha_module\n        self.min_ic_threshold = min_ic_threshold\n        self.top_n_alphas = top_n_alphas\n        self.top_n_stocks = top_n_stocks\n        self.rebalance_freq = rebalance_freq\n        self.sector_cap_pct = sector_cap_pct\n        self.use_xgboost = use_xgboost\n        self.cost_aware = cost_aware\n        self.cost_per_turnover = cost_per_turnover\n        self.drawdown_control = drawdown_control\n        self.drawdown_threshold = drawdown_threshold\n        self.strategy = strategy\n        self.initial_capital = initial_capital\n        self.enable_evolved = enable_evolved\n        # Validate and clamp blend weight to [0, 1]\n        if not 0 <= evolved_blend_weight <= 1:\n            raise ValueError(f\"evolved_blend_weight must be in [0, 1], got {evolved_blend_weight}\")\n        self.evolved_blend_weight = evolved_blend_weight\n        \n        # P10: Multi-horizon blending parameters\n        self.multi_horizon_blend = multi_horizon_blend\n        self.blend_horizons = blend_horizons if blend_horizons is not None else [1, 3, 5]\n        self.blend_weight_method = blend_weight_method\n        \n        # Store reference alpha columns for feature whitelist\n        self.alpha_cols_ref = getattr(alpha_module, 'PHASE34_ALPHA_COLUMNS', [])\n    \n    def compute_alphas(self, df: pd.DataFrame) -> pd.DataFrame:\n        \"\"\"Compute Phase 3.4 alphas on data.\n        \n        Parameters\n        ----------\n        df : pd.DataFrame\n            OHLCV data with 'ticker', 'date', 'open', 'high', 'low', 'close', 'volume'\n        \n        Returns\n        -------\n        pd.DataFrame\n            Data with alpha columns added\n        \"\"\"\n        return self.alpha_module.compute_phase34_microstructure_alphas(\n            df,\n            symbol_col='ticker',\n            date_col='date',\n            open_col='open',\n            high_col='high',\n            low_col='low',\n            close_col='close',\n            volume_col='volume',\n        )\n    \n    def compute_ic(\n        self,\n        alpha_values: pd.Series,\n        returns: pd.Series,\n    ) -> float:\n        \"\"\"Compute Spearman IC between alpha and returns.\n        \n        Parameters\n        ----------\n        alpha_values : pd.Series\n            Alpha signal values\n        returns : pd.Series\n            Forward returns\n        \n        Returns\n        -------\n        float\n            Spearman IC\n        \"\"\"\n        # Remove NaN pairs\n        mask = ~(alpha_values.isna() | returns.isna())\n        if mask.sum() < 10:\n            return 0.0\n        \n        alpha_clean = alpha_values[mask].values\n        returns_clean = returns[mask].values\n        \n        try:\n            ic, _ = spearmanr(alpha_clean, returns_clean)\n            return ic if not np.isnan(ic) else 0.0\n        except Exception as e:\n            logger.warning(f\"IC computation failed: {e}\")\n            return 0.0\n\n    def compute_daily_cs_ic(\n        self,\n        df: pd.DataFrame,\n        signal_col: str,\n        return_col: str,\n        min_cross_section: int = 5,\n    ) -> float:\n        \"\"\"Compute daily cross-sectional Spearman IC, then average across dates.\n\n        For each unique date in df, computes Spearman IC between signal_col and\n        return_col across tickers. Returns the mean of per-date ICs.\n\n        Parameters\n        ----------\n        df : pd.DataFrame\n            Must have 'date', signal_col, return_col columns.\n        signal_col : str\n            Column name for the signal (alpha or portfolio weight).\n        return_col : str\n            Column name for forward returns.\n        min_cross_section : int\n            Minimum number of non-NaN pairs per date to compute IC (default 5).\n\n        Returns\n        -------\n        float\n            Mean daily cross-sectional Spearman IC.\n        \"\"\"\n        if signal_col not in df.columns or return_col not in df.columns:\n            return 0.0\n\n        def _cs_ic(group: pd.DataFrame) -> float:\n            mask = ~(group[signal_col].isna() | group[return_col].isna())\n            if mask.sum() < min_cross_section:\n                return np.nan\n            try:\n                ic, _ = spearmanr(\n                    group.loc[mask, signal_col].values,\n                    group.loc[mask, return_col].values,\n                )\n                return ic if not np.isnan(ic) else np.nan\n            except Exception:\n                return np.nan\n\n        daily_ics = df.groupby('date').apply(_cs_ic, include_groups=False)\n        valid = daily_ics.dropna()\n        if valid.empty:\n            return 0.0\n        return float(valid.mean())\n\n    def _evolve_inline_signal(\n        self,\n        train_df: pd.DataFrame,\n        test_df: pd.DataFrame,\n        return_col: str,\n    ) -> Tuple[Optional[np.ndarray], float]:\n        \"\"\"Run inline GP evolution on train_df, execute best on test_df.\n\n        PIT-safe: evolves only on train_actual, executes on test_df.\n        Returns (evolved_signal_array, train_ic) or (None, 0.0) on failure.\n        train_ic is used by caller for adaptive blend weighting.\n        \"\"\"\n        try:\n            from omega.quant.evolution.genetic_engine import GeneticEngine, GPConfig\n        except ImportError:\n            logger.warning(\"Cannot import GeneticEngine, skipping evolved signal\")\n            return None, 0.0\n\n        # Extract features from train_df (OHLCV + any alpha/feature columns)\n        base_cols = ['open', 'high', 'low', 'close', 'volume']\n        # Add any additional numeric columns available (alphas, fwd returns, etc.)\n        alpha_cols = [c for c in self.alpha_cols_ref if c in train_df.columns]\n        \n        # Explicitly exclude return_col and any fwd_ret_* columns (prevent look-ahead leak)\n        exclude_patterns = [return_col] + [c for c in train_df.columns if c.startswith('fwd_ret_')]\n        available_cols = [c for c in base_cols + alpha_cols \n                         if c in train_df.columns and c not in exclude_patterns]\n        \n        if len(available_cols) < 5:\n            logger.warning(f\"Insufficient features ({len(available_cols)}), skipping evolution\")\n            return None, 0.0\n\n        # PIT Safety: T-1 lag raw OHLCV per ticker before GP sees them\n        # Alpha columns are already T-1 lagged by compute_alphas(), but raw OHLCV are not.\n        lagged_train = train_df.copy()\n        lagged_test = test_df.copy()\n        for col in base_cols:\n            if col in lagged_train.columns:\n                lagged_train[col] = lagged_train.groupby('ticker')[col].shift(1)\n            if col in lagged_test.columns:\n                lagged_test[col] = lagged_test.groupby('ticker')[col].shift(1)\n        # Drop rows with NaN from lagging\n        lagged_train = lagged_train.dropna(subset=[c for c in base_cols if c in lagged_train.columns])\n\n        # Build features dict for train (using lagged OHLCV)\n        train_features = {col: lagged_train[col].values for col in available_cols if col in lagged_train.columns}\n        # Add target\n        if return_col not in lagged_train.columns:\n            logger.warning(f\"Target {return_col} not in train_df, skipping evolution\")\n            return None, 0.0\n        train_target = lagged_train[return_col].values\n        # GP config: keep simple to avoid overfitting (V2 proven config)\n        # Adaptive blend weight handles quality variance instead\n        config = GPConfig(\n            population_size=150,\n            generations=3,\n            max_depth=3,\n            hall_of_fame_size=3,\n        )\n        engine = GeneticEngine(config)\n        # features dict = OHLCV + alpha columns, target = forward returns\n        train_target = lagged_train[return_col].values\n        # Align hall_of_fame evolve with lagged train features\n        hall_of_fame = engine.evolve(train_features, train_target)\n\n        if not hall_of_fame:\n            logger.warning(\"Evolution produced no individuals, skipping\")\n            return None, 0.0\n\n        # P1: Ensemble top 3 GP trees (not just best) for robustness\n        # Average signals from hall_of_fame[0:3] to reduce variance\n        test_features = {col: lagged_test[col].values if col in lagged_test.columns else np.zeros(len(lagged_test))\n                        for col in available_cols}\n        \n        try:\n            # Execute all individuals in hall_of_fame\n            ensemble_signals = []\n            for individual in hall_of_fame:\n                signal = individual._execute_tree(individual.tree, test_features)\n                signal = np.nan_to_num(signal, nan=0.0, posinf=0.0, neginf=0.0)\n                # Normalize each signal to zero mean, unit std\n                std_val = np.std(signal)\n                if std_val > 1e-9:\n                    signal = (signal - np.mean(signal)) / std_val\n                ensemble_signals.append(signal)\n            \n            # Average ensemble signals\n            evolved_signal = np.mean(ensemble_signals, axis=0)\n            \n            # Compute train IC on ensemble signal for adaptive blending\n            train_ensemble_signals = []\n            for individual in hall_of_fame:\n                signal = individual._execute_tree(individual.tree, train_features)\n                signal = np.nan_to_num(signal, nan=0.0, posinf=0.0, neginf=0.0)\n                # Normalize each signal to zero mean, unit std (same as test side for parity)\n                train_std = np.std(signal)\n                if train_std > 1e-9:\n                    signal = (signal - np.mean(signal)) / train_std\n                train_ensemble_signals.append(signal)\n            \n            train_signal = np.mean(train_ensemble_signals, axis=0)\n            train_ic = float(np.corrcoef(train_signal, train_target)[0, 1]) if len(train_signal) > 1 else 0.0\n            if np.isnan(train_ic):\n                train_ic = 0.0\n            \n            test_ret = lagged_test[return_col].values if return_col in lagged_test.columns else np.zeros(len(lagged_test))\n            test_ic = float(np.corrcoef(evolved_signal, test_ret)[0, 1]) if len(evolved_signal) > 1 else 0.0\n            if np.isnan(test_ic):\n                test_ic = 0.0\n            \n            logger.info(\n                f\"GP ensemble (n={len(hall_of_fame)}): train_ic={train_ic:.4f}, \"\n                f\"test_ic={test_ic:.4f}, signal_std={np.std(evolved_signal):.4f}\"\n            )\n            return evolved_signal, train_ic\n        except Exception as e:\n            logger.error(f\"GP ensemble execution failed: {e}\")\n            return None, 0.0\n    \n    def compute_alpha_ics(\n        self,\n        df: pd.DataFrame,\n        alpha_cols: List[str],\n        return_col: str = 'fwd_ret_5',\n    ) -> Dict[str, float]:\n        \"\"\"Compute IC for each alpha.\n        \n        Parameters\n        ----------\n        df : pd.DataFrame\n            Data with alpha columns and forward returns\n        alpha_cols : list of str\n            Alpha column names\n        return_col : str\n            Forward return column name\n        \n        Returns\n        -------\n        dict\n            Mapping of alpha name to IC\n        \"\"\"\n        ics = {}\n        \n        for alpha_col in alpha_cols:\n            if alpha_col not in df.columns:\n                logger.warning(f\"Alpha column {alpha_col} not found\")\n                ics[alpha_col] = 0.0\n                continue\n            \n            # P8: IC-Decay Weighting - compute IC on 3 sub-windows with exponential decay\n            # Weights: [0.2, 0.3, 0.5] for [old, middle, recent] thirds of training data\n            dates = sorted(df['date'].unique())\n            n_dates = len(dates)\n            \n            if n_dates >= 30:  # Only apply decay if enough history\n                third = n_dates // 3\n                windows = [\n                    (0, third, 0.2),           # oldest third\n                    (third, 2*third, 0.3),     # middle third\n                    (2*third, n_dates, 0.5)    # most recent third\n                ]\n                \n                weighted_ic = 0.0\n                weight_sum = 0.0\n                \n                for start_idx, end_idx, weight in windows:\n                    window_dates = dates[start_idx:end_idx]\n                    window_df = df[df['date'].isin(window_dates)]\n                    \n                    if len(window_df) > 0:\n                        ic_val = self.compute_ic(window_df[alpha_col], window_df[return_col])\n                        weighted_ic += ic_val * weight\n                        weight_sum += weight\n                \n                if weight_sum > 0:\n                    ics[alpha_col] = weighted_ic / weight_sum\n                else:\n                    ics[alpha_col] = self.compute_ic(df[alpha_col], df[return_col])\n            else:\n                # Fallback to simple IC if insufficient history\n                ic = self.compute_ic(df[alpha_col], df[return_col])\n                ics[alpha_col] = ic\n        \n        return ics\n    \n    def _estimate_alpha_turnover(self, df: pd.DataFrame, alpha_col: str) -> float:\n        \"\"\"Estimate day-over-day rank turnover of alpha_col in [0, 1].\n\n        If column missing or single-date DataFrame, return conservative fallback 0.5.\n        Turnover = mean( abs( rank_t - rank_{t-1} ) ) / (N_assets - 1)\n        \"\"\"\n        if alpha_col not in df.columns:\n            return 0.5\n\n        # Check unique dates\n        dates = sorted(df['date'].unique())\n        if len(dates) < 2:\n            return 0.5\n\n        # Pivoting date x ticker to compute rank turnover\n        pivot = df.pivot(index='date', columns='ticker', values=alpha_col)\n        \n        # Rank cross-sectionally per day, normalized to [0, 1]\n        # method='average' is stable, pct=True maps rank to [0, 1]\n        ranks = pivot.rank(axis=1, pct=True)\n        \n        # Day-over-day absolute change in rank pct\n        diffs = ranks.diff(axis=0).abs()\n        \n        # Mean absolute change over time and assets\n        # If there are NaN values we drop them\n        mean_diff = diffs.mean(axis=1).mean()\n        if pd.isna(mean_diff):\n            return 0.5\n            \n        # Clip to ensure in [0, 1]\n        return float(np.clip(mean_diff, 0.0, 1.0))\n\n    def adjust_alphas_for_cost(\n        self,\n        df: pd.DataFrame,\n        alpha_cols: List[str],\n        train_ics: Dict[str, float],\n        cost_per_turnover: float | None = None,\n    ) -> Dict[str, float]:\n        \"\"\"Compute cost-adjusted IC for each alpha.\n\n        adjusted_ic = raw_ic - cost * turnover\n        \"\"\"\n        if cost_per_turnover is None:\n            cost_per_turnover = self.cost_per_turnover\n\n        adjusted_ics = {}\n        for col in alpha_cols:\n            raw_ic = train_ics.get(col, 0.0)\n            turnover = self._estimate_alpha_turnover(df, col)\n            adjusted_ics[col] = raw_ic - cost_per_turnover * turnover\n\n        return adjusted_ics\n\n    def select_top_alphas(\n        self,\n        alpha_ics: Dict[str, float],\n    ) -> List[str]:\n        \"\"\"Select top N alphas by absolute IC.\n        \n        Parameters\n        ----------\n        alpha_ics : dict\n            Mapping of alpha name to IC\n        \n        Returns\n        -------\n        list of str\n            Top N alpha names\n        \"\"\"\n        # Filter by minimum IC threshold\n        valid_alphas = {k: v for k, v in alpha_ics.items() if abs(v) >= self.min_ic_threshold}\n        \n        if not valid_alphas:\n            logger.warning(f\"No alphas meet IC threshold {self.min_ic_threshold}, using all\")\n            valid_alphas = alpha_ics\n        \n        # Sort by absolute IC\n        sorted_alphas = sorted(valid_alphas.items(), key=lambda x: abs(x[1]), reverse=True)\n        \n        # Take top N\n        top_alphas = [name for name, _ in sorted_alphas[:self.top_n_alphas]]\n        \n        logger.info(f\"Selected top {len(top_alphas)} alphas: {top_alphas}\")\n        \n        return top_alphas\n    \n    def validate_alpha_with_research_gate(\n        self,\n        top_alphas: List[str],\n        train_ics: Dict[str, float],\n        train_df_clean: pd.DataFrame,\n        return_col: str = 'fwd_ret_5',\n        rolling_window: int = 20,\n    ) -> Tuple[List[str], Dict[str, dict]]:\n        \"\"\"Filter top_alphas through Research Gate using embargoed train_df_clean.\n\n        Computes a rolling IC series (rolling_window-day window) from daily\n        cross-sectional ICs on train_df_clean (PIT safe — no look-ahead).\n        Each alpha is validated via validate_research_gate(). Alphas that pass\n        are returned as gated_alphas. If all fail, falls back to top_alphas.\n\n        Parameters\n        ----------\n        top_alphas : list of str\n            Candidate alpha names from select_top_alphas().\n        train_ics : dict\n            Per-alpha IC on embargoed train set (used as val_ic).\n        train_df_clean : pd.DataFrame\n            Embargoed training data with alpha columns and return_col.\n        return_col : str\n            Forward return column name.\n        rolling_window : int\n            Window size for rolling IC series (default 20).\n\n        Returns\n        -------\n        gated_alphas : list of str\n            Alphas that passed the Research Gate (or fallback = top_alphas).\n        gate_results : dict\n            Mapping of alpha name -> validate_research_gate() result dict.\n\n        Notes\n        -----\n        PIT Safety: rolling IC is computed solely on train_df_clean which has\n        the embargo applied upstream. No test-period data is used here.\n        \"\"\"\n        gate_results: Dict[str, dict] = {}\n\n        # Compute daily cross-sectional IC per alpha on embargoed train set\n        # Vectorized: groupby date, compute all alpha ICs per group\n        dates = sorted(train_df_clean['date'].unique())\n        _avail_alphas = [a for a in top_alphas if a in train_df_clean.columns]\n\n        def _daily_ics(group: pd.DataFrame) -> pd.Series:\n            \"\"\"Return Series of IC per alpha for one date group.\"\"\"\n            ret = group[return_col]\n            ics = {}\n            for alpha in _avail_alphas:\n                mask = ~(group[alpha].isna() | ret.isna())\n                if mask.sum() < 5:\n                    ics[alpha] = np.nan\n                    continue\n                try:\n                    ic_val, _ = spearmanr(\n                        group.loc[mask, alpha].values,\n                        group.loc[mask, return_col].values,\n                    )\n                    ics[alpha] = ic_val if not np.isnan(ic_val) else np.nan\n                except Exception:\n                    ics[alpha] = np.nan\n            return pd.Series(ics)\n\n        ic_df = train_df_clean.groupby('date').apply(\n            _daily_ics, include_groups=False\n        )  # index=date, columns=alphas\n\n        daily_ics: Dict[str, pd.Series] = {}\n        for alpha in top_alphas:\n            if alpha in ic_df.columns:\n                daily_ics[alpha] = ic_df[alpha].reindex(dates)\n            else:\n                daily_ics[alpha] = pd.Series(dtype=float)\n\n        # Validate each alpha through Research Gate\n        gated_alphas: List[str] = []\n        for alpha in top_alphas:\n            val_ic = train_ics.get(alpha, 0.0)\n            raw_daily = daily_ics.get(alpha, pd.Series(dtype=float))\n            # Rolling mean IC series (drop NaN before rolling)\n            rolling_ic = raw_daily.dropna().rolling(window=rolling_window).mean().dropna()\n            result = validate_research_gate(val_ic, rolling_ic)\n            gate_results[alpha] = result\n            if result['passed']:\n                gated_alphas.append(alpha)\n            logger.info(\n                f\"Research Gate [{alpha}]: {result['verdict']} \"\n                f\"(val_ic={val_ic:.4f}, n_samples={result['n_samples']})\"\n            )\n\n        # Fallback: if all alphas fail gate, use original top_alphas\n        if not gated_alphas:\n            logger.warning(\n                \"All alphas failed Research Gate — falling back to top_alphas \"\n                f\"({top_alphas})\"\n            )\n            gated_alphas = list(top_alphas)\n\n        logger.info(f\"Gated alphas ({len(gated_alphas)}/{len(top_alphas)}): {gated_alphas}\")\n        return gated_alphas, gate_results\n    \n    def compute_portfolio_signal(\n        self,\n        df: pd.DataFrame,\n        alpha_cols: List[str],\n        alpha_ics: Dict[str, float],\n    ) -> pd.Series:\n        \"\"\"Compute IC-weighted portfolio signal.\n        \n        Parameters\n        ----------\n        df : pd.DataFrame\n            Data with alpha columns\n        alpha_cols : list of str\n            Alpha column names to combine\n        alpha_ics : dict\n            IC weights for each alpha\n        \n        Returns\n        -------\n        pd.Series\n            Combined portfolio signal\n        \"\"\"\n        # Extract IC weights\n        weights = np.array([alpha_ics.get(col, 0.0) for col in alpha_cols])\n        \n        # Normalize weights to sum to 1\n        weight_sum = np.abs(weights).sum()\n        if weight_sum > 0:\n            weights = weights / weight_sum\n        else:\n            weights = np.ones(len(weights)) / len(weights)\n        \n        # Per-alpha z-score normalization (cross-sectional per date) BEFORE blend\n        # Prevents high-scale alphas from dominating IC-weighted combination\n        df_norm = df[alpha_cols].copy()\n        for col in alpha_cols:\n            df_norm[col] = df.groupby('date')[col].transform(\n                lambda x: (x - x.mean()) / (x.std() + 1e-9)\n            )\n        \n        # Compute weighted average on normalized alphas\n        alpha_matrix = df_norm[alpha_cols].values\n        portfolio_signal = alpha_matrix @ weights\n        \n        return pd.Series(portfolio_signal, index=df.index)\n    \n    def compute_sharpe_ratio(\n        self,\n        returns: pd.Series,\n        periods_per_year: int = 252,\n    ) -> float:\n        \"\"\"Compute annualized Sharpe ratio.\n        \n        Parameters\n        ----------\n        returns : pd.Series\n            Period returns\n        periods_per_year : int\n            Number of periods per year (252 for daily)\n        \n        Returns\n        -------\n        float\n            Annualized Sharpe ratio\n        \"\"\"\n        if len(returns) < 2:\n            return 0.0\n        \n        mean_return = returns.mean()\n        std_return = returns.std()\n        \n        if std_return == 0 or np.isnan(std_return):\n            return 0.0\n        \n        sharpe = (mean_return / std_return) * np.sqrt(periods_per_year)\n        \n        return sharpe if not np.isnan(sharpe) else 0.0\n    \n    def compute_max_drawdown(\n        self,\n        returns: pd.Series,\n    ) -> float:\n        \"\"\"Compute maximum drawdown.\n        \n        Parameters\n        ----------\n        returns : pd.Series\n            Period returns\n        \n        Returns\n        -------\n        float\n            Maximum drawdown (negative value)\n        \"\"\"\n        if len(returns) < 2:\n            return 0.0\n        \n        # Compute cumulative returns\n        cum_returns = (1 + returns).cumprod()\n        \n        # Compute running maximum\n        running_max = cum_returns.expanding().max()\n        \n        # Compute drawdown\n        drawdown = (cum_returns - running_max) / running_max\n        \n        # Return maximum drawdown (most negative)\n        max_dd = drawdown.min()\n        \n        return max_dd if not np.isnan(max_dd) else 0.0\n    \n    def _compute_sequential_dynamic_freq(\n        self,\n        train_df: pd.DataFrame,\n        available_test_df: pd.DataFrame,\n        base_freq: int = 7,\n    ) -> int:\n        \"\"\"Compute dynamic rebalance frequency for a specific point in time.\n        \n        P9 v4 (PIT-safe): Adjust rebalance frequency based on market volatility regime\n        using only data available up to the decision point.\n        \n        - Compare CURRENT volatility (recent available data) vs HISTORICAL baseline (train period)\n        - High volatility (current > 1.5x baseline): rebalance more often (freq=5)\n        - Low volatility (current < 0.67x baseline): rebalance less often (freq=10)\n        - Medium volatility: use base_freq (7)\n        \n        Parameters\n        ----------\n        train_df : pd.DataFrame\n            Training period data with 'close' and 'date' columns (historical baseline)\n        available_test_df : pd.DataFrame\n            Test period data available up to (but not including) the decision date.\n            Must contain only rows with date < decision_date for PIT safety.\n        base_freq : int\n            Default rebalance frequency\n            \n        Returns\n        -------\n        int\n            Adjusted rebalance frequency\n            \n        Notes\n        -----\n        PIT safety: This function only uses train_df and available_test_df (strictly\n        prior dates). The caller is responsible for filtering test_df to exclude\n        current and future dates relative to the decision point.\n        \"\"\"\n        # Guard: if train_df not provided, cannot compute baseline\n        if train_df is None or train_df.empty:\n            logger.warning(\"P9: train_df is None/empty, cannot compute baseline vol, using base_freq\")\n            return base_freq\n        \n        # Compute baseline volatility from TRAINING period (historical).\n        # Sort first: pct_change is order-sensitive inside each ticker group.\n        train_work = train_df.sort_values(['ticker', 'date'])\n        train_returns = train_work.groupby('ticker')['close'].pct_change().clip(-0.5, 0.5)\n        train_daily_vol = train_returns.groupby(train_work['date']).std()\n        train_median_vol = train_daily_vol.median()\n        \n        if pd.isna(train_median_vol) or train_median_vol < 1e-9:\n            logger.warning(\"P9: Cannot compute baseline volatility from train_df, using base_freq\")\n            return base_freq\n        \n        # Compute current volatility from AVAILABLE test data (strictly prior dates).\n        # If no test data available yet (first OOS date), use train baseline only.\n        if available_test_df is None or available_test_df.empty:\n            # No OOS data available yet: use train median as current estimate\n            current_vol = train_median_vol\n            logger.debug(\"P9: No available test data, using train baseline as current vol\")\n        else:\n            # Sort first: pct_change is order-sensitive inside each ticker group.\n            # Clip like forward returns to avoid corporate-action/data jumps dominating regime.\n            test_work = available_test_df.sort_values(['ticker', 'date'])\n            test_returns = test_work.groupby('ticker')['close'].pct_change().clip(-0.5, 0.5)\n            test_daily_vol = test_returns.groupby(test_work['date']).std()\n            \n            # Use recent 20-day rolling average for stability\n            if len(test_daily_vol) >= 20:\n                current_vol = test_daily_vol.rolling(window=20, min_periods=10).mean().iloc[-1]\n            else:\n                current_vol = test_daily_vol.median()\n            \n            if pd.isna(current_vol):\n                current_vol = test_daily_vol.median()\n            \n            # Fallback to train baseline if still invalid\n            if pd.isna(current_vol):\n                current_vol = train_median_vol\n                logger.debug(\"P9: Could not compute current vol from available test data, using train baseline\")\n        \n        # Compare current vs baseline\n        vol_ratio = current_vol / train_median_vol\n        \n        if vol_ratio > 1.5:\n            # High volatility regime: rebalance more often\n            adjusted_freq = max(5, base_freq - 2)\n            regime = \"HIGH\"\n        elif vol_ratio < 0.67:\n            # Low volatility regime: rebalance less often\n            adjusted_freq = min(10, base_freq + 3)\n            regime = \"LOW\"\n        else:\n            # Medium volatility regime: use base frequency\n            adjusted_freq = base_freq\n            regime = \"MEDIUM\"\n        \n        logger.debug(\n            f\"P9 Sequential Dynamic: regime={regime}, current_vol={current_vol:.6f}, \"\n            f\"baseline_vol={train_median_vol:.6f}, ratio={vol_ratio:.2f}, freq={base_freq}->{adjusted_freq}\"\n        )\n        \n        return adjusted_freq\n    \n    def _apply_stage2_constraints(\n        self,\n        test_df: pd.DataFrame,\n        raw_signal: pd.Series,\n        top_alphas: List[str],\n        dynamic_rebalance: bool = False,\n        train_df: Optional[pd.DataFrame] = None,\n    ) -> pd.Series:\n        \"\"\"Apply Stage 2 behavioral constraints to the raw IC-weighted signal.\n\n        Enforces in order:\n          1. Top-N stock selection per rebalance date (nlargest on signal)\n          2. Rebalance cadence (only recompute weights every rebalance_freq dates)\n          3. Sector cap (delegate to alpha_pipeline._apply_sector_caps)\n\n        Parameters\n        ----------\n        test_df : pd.DataFrame\n            Test-set rows with columns 'date', 'ticker', and optionally 'sector'.\n            Rows are in the same order as raw_signal.\n        raw_signal : pd.Series\n            IC-weighted combined signal, indexed identically to test_df.index.\n        top_alphas : list of str\n            Selected alpha column names (used only for logging context).\n        dynamic_rebalance : bool\n            If True, adjust rebalance frequency based on market volatility regime.\n            P9 v4: Uses sequential PIT-safe frequency computation.\n        train_df : pd.DataFrame, optional\n            Training data for baseline volatility computation (P9 dynamic rebalance).\n\n        Returns\n        -------\n        pd.Series\n            Per-row portfolio weight Series, same index as raw_signal.\n            Sums to ~1.0 across tickers on each date (after sector cap renorm).\n\n        Notes\n        -----\n        PIT safety: test_df signals are already T-1 lagged by compute_alphas().\n        P9 v4: Dynamic rebalance frequency is computed sequentially per rebalance\n        checkpoint using only train_df + strictly prior test dates.\n        \"\"\"\n        top_n = self.top_n_stocks\n        sector_cap = self.sector_cap_pct\n\n        # Attach raw signal to a working frame aligned by position\n        work = test_df[['date', 'ticker']].copy().reset_index(drop=True)\n        work['_signal'] = raw_signal.values\n\n        # Build sector_map from 'sector' column if present\n        if 'sector' in test_df.columns:\n            sector_map: Dict[str, str] = (\n                test_df[['ticker', 'sector']]\n                .drop_duplicates('ticker')\n                .set_index('ticker')['sector']\n                .to_dict()\n            )\n        else:\n            # No sector metadata: each ticker is its own sector (cap has no effect)\n            sector_map = {t: t for t in work['ticker'].unique()}\n\n        all_sectors = set(sector_map.values())\n        resolved_caps: Dict[str, float] = {s: sector_cap for s in all_sectors}\n\n        # Sorted unique dates in test fold (chronological)\n        sorted_dates = sorted(work['date'].unique())\n\n        # Build wide signal matrix: rows=dates, cols=tickers\n        signal_wide = work.pivot_table(\n            index='date', columns='ticker', values='_signal', aggfunc='first'\n        )\n\n        # Weight matrix (same shape, filled with 0)\n        weight_wide = pd.DataFrame(\n            0.0, index=signal_wide.index, columns=signal_wide.columns\n        )\n\n        last_weights: Optional[pd.Series] = None\n        apply_sector_caps = _import_apply_sector_caps()\n        \n        # P9 v4 fix: Track current rebalance frequency (updated sequentially at checkpoints)\n        # Drive both frequency recompute and rebalance eligibility from elapsed distance\n        current_rebal_freq = self.rebalance_freq\n        last_rebal_checkpoint_idx = None\n\n        for idx, date in enumerate(sorted_dates):\n            if date not in signal_wide.index:\n                continue\n\n            # P9 v4 fix: Determine if we should rebalance at this date FIRST\n            # Use elapsed distance from last actual checkpoint\n            if last_rebal_checkpoint_idx is None:\n                # First checkpoint: always rebalance\n                should_rebalance = (idx == 0)\n            else:\n                # Check if enough dates have passed since last checkpoint\n                elapsed = idx - last_rebal_checkpoint_idx\n                should_rebalance = (elapsed >= current_rebal_freq)\n\n            if should_rebalance:\n                # P9 v4 fix: At rebalance dates, recompute frequency using PIT-safe data\n                # BEFORE executing rebalance, so new frequency applies to NEXT interval\n                if dynamic_rebalance:\n                    # Use only data available strictly BEFORE this date (train_df + prior test dates)\n                    # This ensures no lookahead: decision at date D uses data < D only\n                    available_test = test_df[test_df['date'] < date]\n                    current_rebal_freq = self._compute_sequential_dynamic_freq(\n                        train_df, available_test, self.rebalance_freq\n                    )\n                    logger.debug(\n                        f\"P9 v4: Rebalance at idx={idx}, date={date}, \"\n                        f\"updated freq to {current_rebal_freq} for next interval\"\n                    )\n                \n                # Execute rebalance: select top-N by signal, build equal-weight, apply sector cap\n                alpha_row = signal_wide.loc[date].dropna()\n                if len(alpha_row) > 0:\n                    top_stocks = alpha_row.nlargest(min(top_n, len(alpha_row)))\n                    target = pd.Series(0.0, index=signal_wide.columns)\n                    target[top_stocks.index] = 1.0 / len(top_stocks)\n                    # Apply sector caps (reuse alpha_pipeline logic, no duplication)\n                    target = apply_sector_caps(target, sector_map, resolved_caps)\n                    last_weights = target\n                \n                # Update checkpoint tracker AFTER rebalance\n                last_rebal_checkpoint_idx = idx\n\n            if last_weights is not None:\n                weight_wide.loc[date] = last_weights\n\n        # Log final applied frequency (may have changed during fold)\n        logger.info(\n            f\"Stage 2 constraints applied: top_n={top_n}, \"\n            f\"final_rebal_freq={current_rebal_freq}, sector_cap={sector_cap:.0%}, \"\n            f\"alphas={top_alphas}, dynamic={'YES' if dynamic_rebalance else 'NO'}\"\n        )\n\n        # Flatten back to per-row Series aligned with original test_df index\n        work_with_weights = work.merge(\n            weight_wide.stack().rename('_weight').reset_index().rename(\n                columns={'ticker': 'ticker', 'date': 'date'}\n            ),\n            on=['date', 'ticker'],\n            how='left',\n        )\n        result = work_with_weights['_weight'].fillna(0.0)\n        result.index = raw_signal.index\n        return result\n\n    def _compute_horizon_signal(\n        self,\n        fold_id: int,\n        train_df: pd.DataFrame,\n        test_df: pd.DataFrame,\n        alpha_cols: List[str],\n        return_col: str,\n        horizon: int,\n        cost_aware: bool,\n        final_objective_return_col: str = 'fwd_ret_5',\n    ) -> Tuple[Optional[pd.Series], Dict[str, float], List[str], Dict[str, dict]]:\n        \"\"\"Compute raw signal for a single horizon without Stage 2 constraints.\n        \n        P10: Helper for multi-horizon blending. Computes IC, gates alphas,\n        and produces raw portfolio signal for one return horizon.\n        \n        Parameters\n        ----------\n        fold_id : int\n            Fold identifier (for logging)\n        train_df : pd.DataFrame\n            Training data with alphas already computed\n        test_df : pd.DataFrame\n            Test data with alphas already computed\n        alpha_cols : list of str\n            Alpha column names\n        return_col : str\n            Forward return column for this horizon (e.g., 'fwd_ret_1')\n        horizon : int\n            Horizon length in days (e.g., 1, 3, 5)\n        cost_aware : bool\n            If True, apply cost-aware alpha selection\n        final_objective_return_col : str\n            Final objective return column (usually 'fwd_ret_5') for measuring\n            contribution to final monetization target\n            \n        Returns\n        -------\n        raw_signal : pd.Series or None\n            Raw portfolio signal (no Stage 2 constraints), or None if horizon fails\n        quality_metrics : dict\n            Quality metrics with keys: 'train_ic', 'validation_ic', \n            'final_objective_validation_ic', 'own_target_train_ic', 'own_target_validation_ic'\n        gated_alphas : list of str\n            Alphas that passed research gate for this horizon\n        gate_results : dict\n            Research gate results per alpha\n            \n        Notes\n        -----\n        PIT Safety: Applies horizon-specific embargo (last h rows per ticker).\n        No Stage 2 constraints applied here (caller applies after blending).\n        \n        Gate Failure Detection: If all alphas fail the research gate (all gate\n        results are False), this horizon is excluded (returns None) even if\n        validate_alpha_with_research_gate() falls back to top_alphas.\n        \"\"\"\n        logger.info(f\"[P10] Computing horizon signal: fold={fold_id}, horizon={horizon}, return_col={return_col}\")\n        \n        # Initialize empty quality metrics\n        quality_metrics = {\n            'train_ic': 0.0,\n            'validation_ic': 0.0,\n            'final_objective_validation_ic': 0.0,\n            'own_target_train_ic': 0.0,\n            'own_target_validation_ic': 0.0,\n        }\n        \n        # Check if return_col exists in data\n        if return_col not in train_df.columns or return_col not in test_df.columns:\n            logger.warning(f\"[P10] Return column {return_col} not found, skipping horizon {horizon}\")\n            return None, quality_metrics, [], {}\n        \n        # Horizon-specific embargo: drop last h rows per ticker from train IC computation\n        _tail_rank = train_df.groupby('ticker').cumcount(ascending=False)\n        train_df_clean = train_df[_tail_rank >= horizon].reset_index(drop=True)\n        logger.info(\n            f\"[P10] Horizon {horizon} embargo: \"\n            f\"train rows before={len(train_df)}, after={len(train_df_clean)}\"\n        )\n        \n        if len(train_df_clean) < 10:\n            logger.warning(f\"[P10] Insufficient train data after embargo for horizon {horizon}\")\n            return None, quality_metrics, [], {}\n        \n        # Split into train_actual and validation for IC computation\n        unique_dates = sorted(train_df_clean['date'].unique())\n        if len(unique_dates) >= 3:\n            split_idx = int(len(unique_dates) * 2 / 3)\n            val_start_date = unique_dates[split_idx]\n            train_actual = train_df_clean[train_df_clean['date'] < val_start_date].reset_index(drop=True)\n            val_actual = train_df_clean[train_df_clean['date'] >= val_start_date].reset_index(drop=True)\n        else:\n            train_actual = train_df_clean\n            val_actual = train_df_clean\n        \n        # Compute IC on train_actual using this horizon's return column\n        train_ics = self.compute_alpha_ics(train_actual, alpha_cols, return_col)\n        \n        # Strategy filter: momentum only keeps positive IC alphas\n        if hasattr(self, \"strategy\") and self.strategy == \"momentum\":\n            train_ics = {k: v for k, v in train_ics.items() if v > 0.0}\n        \n        logger.info(f\"[P10] Horizon {horizon} train ICs: {train_ics}\")\n        \n        # Cost-aware alpha selection if enabled\n        if cost_aware:\n            adjusted_ics = self.adjust_alphas_for_cost(train_actual, alpha_cols, train_ics)\n            top_alphas = self.select_top_alphas(adjusted_ics)\n        else:\n            top_alphas = self.select_top_alphas(train_ics)\n        \n        # Research gate validation using validation set\n        gated_alphas, gate_results = self.validate_alpha_with_research_gate(\n            top_alphas=top_alphas,\n            train_ics=train_ics,\n            train_df_clean=val_actual,\n            return_col=return_col,\n        )\n        \n        # FIX 2: Check if research gate actually passed any alphas\n        # If all alphas failed gate (all verdict=False), exclude this horizon\n        # Use robust verdict checker to avoid truthiness bugs (P10 hotfix 2026-06-09)\n        gate_passed_count = sum(1 for res in gate_results.values() if _is_gate_verdict_pass(res.get('verdict')))\n        if gate_passed_count == 0:\n            logger.warning(\n                f\"[P10] Research gate failed all alphas for horizon {horizon} \"\n                f\"({len(gate_results)} alphas tested, 0 passed) - excluding horizon\"\n            )\n            return None, quality_metrics, [], gate_results\n        \n        if len(gated_alphas) == 0:\n            logger.warning(f\"[P10] No alphas passed gate for horizon {horizon}\")\n            return None, quality_metrics, [], gate_results\n        \n        # Compute raw portfolio signal (IC-weighted, no XGBoost for multi-horizon)\n        # XGBoost is disabled in multi-horizon mode to keep implementation simple\n        portfolio_signal = self.compute_portfolio_signal(test_df, gated_alphas, train_ics)\n        \n        # Z-score normalize signal (cross-sectional per date)\n        test_df_copy = test_df.copy()\n        test_df_copy['_signal'] = portfolio_signal\n        test_df_copy['_signal'] = test_df_copy.groupby('date')['_signal'].transform(\n            lambda x: (x - x.mean()) / (x.std() + 1e-9)\n        )\n        portfolio_signal = test_df_copy['_signal']\n        \n        # FIX 1 & 5: Compute comprehensive quality metrics\n        # Own-target train IC\n        train_signal = self.compute_portfolio_signal(train_actual, gated_alphas, train_ics)\n        own_target_train_ic = self.compute_ic(train_signal, train_actual[return_col]) if return_col in train_actual.columns else 0.0\n        \n        # Own-target validation IC\n        val_signal = self.compute_portfolio_signal(val_actual, gated_alphas, train_ics)\n        own_target_validation_ic = self.compute_ic(val_signal, val_actual[return_col]) if return_col in val_actual.columns else 0.0\n        \n        # Final objective train IC (contribution to final monetization target on train set)\n        final_objective_train_ic = 0.0\n        if final_objective_return_col in train_actual.columns:\n            final_objective_train_ic = self.compute_ic(train_signal, train_actual[final_objective_return_col])\n        \n        # Final objective validation IC (contribution to final monetization target)\n        final_objective_validation_ic = 0.0","lineStart":1,"lineEnd":1272,"totalLines":1273,"truncated":true}},"title":"src\\omega\\quant\\phase35_walk_forward.py","time":{"start":1781015371171,"end":1781015371185}},"id":"prt_eacc9db6a001VxH25riGqb5SMm","sessionID":"ses_153369dedffemeV7129OxwCDlM","messageID":"msg_eacc9c9bf0014qxtSotz1r1G5a"}}
