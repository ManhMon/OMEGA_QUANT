\n47:     bool\n48:         True if verdict is a pass, False otherwise.\n49:         \n50:     Notes\n51:     -----\n52:     Pass conditions:\n53:     - Boolean True\n54:     - String exactly matching \"PASS\" or \"APPROVED\" (case-insensitive)\n55:     \n56:     Fail conditions:\n57:     - Boolean False\n58:     - String starting with \"FAIL\", \"REJECT\", \"NEEDS_FIX\" (case-insensitive)\n59:     - None, empty string, or missing value\n60:     - Any other string not explicitly recognized as pass\n61:     \n62:     This prevents truthiness bugs where non-empty fail strings like\n63:     \"FAIL: insufficient samples\" are incorrectly treated as pass.\n64:     \"\"\"\n65:     # Boolean True is pass\n66:     if verdict is True:\n67:         return True\n68:     \n69:     # Boolean False, None, or missing is fail\n70:     if verdict is False or verdict is None:\n71:         return False\n72:     \n73:     # String verdict: check for explicit pass/fail markers\n74:     if isinstance(verdict, str):\n75:         verdict_upper = verdict.strip().upper()\n76:         \n77:         # Empty string is fail\n78:         if not verdict_upper:\n79:             return False\n80:         \n81:         # Explicit pass markers\n82:         if verdict_upper in (\"PASS\", \"APPROVED\"):\n83:             return True\n84:         \n85:         # Explicit fail markers\n86:         if verdict_upper.startswith((\"FAIL\", \"REJECT\", \"NEEDS_FIX\")):\n87:             return False\n88:         \n89:         # Any other string is treated as fail (conservative)\n90:         return False\n91:     \n92:     # Any other type is treated as fail\n93:     return False\n94: \n95: # ---------------------------------------------------------------------------\n96: # Stage 2: reuse sector-cap enforcement from alpha_pipeline (no duplication)\n97: # ---------------------------------------------------------------------------\n98: def _import_apply_sector_caps():\n99:     \"\"\"Lazy import of _apply_sector_caps from alpha_pipeline.\n100: \n\n(Showing lines 1-100 of 2160. Use offset=101 to continue.)\n</content>","metadata":{"preview":"\"\"\"Phase 3.5 Walk-Forward Backtest Engine.\n\nVersion: v21.38-Phase35-Stage3\nDate: 2026-05-22\n\nWalk-forward backtest for 7 Phase 3.4 microstructure alphas using real VN market data.\n\nCOMPLIANCE:\n  - PIT Safety: T-1 lag enforcement\n  - Vectorization: 100% Pandas/NumPy\n  - Error Handling: Graceful degradation\n  - Metrics: IC, Sharpe, Max DD per fold\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport sys\nimport os\nfrom dataclasses import dataclass, field\nfrom pathlib import Path","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\src\\omega\\quant\\phase35_walk_forward.py","text":"\"\"\"Phase 3.5 Walk-Forward Backtest Engine.\n\nVersion: v21.38-Phase35-Stage3\nDate: 2026-05-22\n\nWalk-forward backtest for 7 Phase 3.4 microstructure alphas using real VN market data.\n\nCOMPLIANCE:\n  - PIT Safety: T-1 lag enforcement\n  - Vectorization: 100% Pandas/NumPy\n  - Error Handling: Graceful degradation\n  - Metrics: IC, Sharpe, Max DD per fold\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport sys\nimport os\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import spearmanr\n\nfrom omega.quant.ml_gate_validator import validate_research_gate\nfrom omega.quant.alpha_ensemble_xgboost import XGBoostAlphaEnsemble\n\nwarnings.filterwarnings('ignore')\nlogger = logging.getLogger(__name__)\n\n# ---------------------------------------------------------------------------\n# Helper: Robust gate verdict evaluation (P10 truthiness hotfix 2026-06-09)\n# ---------------------------------------------------------------------------\ndef _is_gate_verdict_pass(verdict) -> bool:\n    \"\"\"Check if a gate verdict represents a pass.\n    \n    Parameters\n    ----------\n    verdict : any\n        Gate verdict value from validate_research_gate() result dict.\n        \n    Returns\n    -------\n    bool\n        True if verdict is a pass, False otherwise.\n        \n    Notes\n    -----\n    Pass conditions:\n    - Boolean True\n    - String exactly matching \"PASS\" or \"APPROVED\" (case-insensitive)\n    \n    Fail conditions:\n    - Boolean False\n    - String starting with \"FAIL\", \"REJECT\", \"NEEDS_FIX\" (case-insensitive)\n    - None, empty string, or missing value\n    - Any other string not explicitly recognized as pass\n    \n    This prevents truthiness bugs where non-empty fail strings like\n    \"FAIL: insufficient samples\" are incorrectly treated as pass.\n    \"\"\"\n    # Boolean True is pass\n    if verdict is True:\n        return True\n    \n    # Boolean False, None, or missing is fail\n    if verdict is False or verdict is None:\n        return False\n    \n    # String verdict: check for explicit pass/fail markers\n    if isinstance(verdict, str):\n        verdict_upper = verdict.strip().upper()\n        \n        # Empty string is fail\n        if not verdict_upper:\n            return False\n        \n        # Explicit pass markers\n        if verdict_upper in (\"PASS\", \"APPROVED\"):\n            return True\n        \n        # Explicit fail markers\n        if verdict_upper.startswith((\"FAIL\", \"REJECT\", \"NEEDS_FIX\")):\n            return False\n        \n        # Any other string is treated as fail (conservative)\n        return False\n    \n    # Any other type is treated as fail\n    return False\n\n# ---------------------------------------------------------------------------\n# Stage 2: reuse sector-cap enforcement from alpha_pipeline (no duplication)\n# ---------------------------------------------------------------------------\ndef _import_apply_sector_caps():\n    \"\"\"Lazy import of _apply_sector_caps from alpha_pipeline.\n","lineStart":1,"lineEnd"