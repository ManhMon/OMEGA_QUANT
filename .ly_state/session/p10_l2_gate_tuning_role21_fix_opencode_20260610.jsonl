phas}\")\n781:         return gated_alphas, gate_results\n782:     \n783:     def compute_portfolio_signal(\n784:         self,\n785:         df: pd.DataFrame,\n786:         alpha_cols: List[str],\n787:         alpha_ics: Dict[str, float],\n788:     ) -> pd.Series:\n789:         \"\"\"Compute IC-weighted portfolio signal.\n790:         \n791:         Parameters\n792:         ----------\n793:         df : pd.DataFrame\n794:             Data with alpha columns\n795:         alpha_cols : list of str\n796:             Alpha column names to combine\n797:         alpha_ics : dict\n798:             IC weights for each alpha\n799:         \n800:         Returns\n801:         -------\n802:         pd.Series\n803:             Combined portfolio signal\n804:         \"\"\"\n805:         # Extract IC weights\n806:         weights = np.array([alpha_ics.get(col, 0.0) for col in alpha_cols])\n807:         \n808:         # Normalize weights to sum to 1\n809:         weight_sum = np.abs(weights).sum()\n810:         if weight_sum > 0:\n811:             weights = weights / weight_sum\n812:         else:\n813:             weights = np.ones(len(weights)) / len(weights)\n814:         \n815:         # Per-alpha z-score normalization (cross-sectional per date) BEFORE blend\n816:         # Prevents high-scale alphas from dominating IC-weighted combination\n817:         df_norm = df[alpha_cols].copy()\n818:         for col in alpha_cols:\n819:             df_norm[col] = df.groupby('date')[col].transform(\n820:                 lambda x: (x - x.mean()) / (x.std() + 1e-9)\n821:             )\n822:         \n823:         # Compute weighted average on normalized alphas\n824:         alpha_matrix = df_norm[alpha_cols].values\n825:         portfolio_signal = alpha_matrix @ weights\n826:         \n827:         return pd.Series(portfolio_signal, index=df.index)\n828:     \n829:     def compute_sharpe_ratio(\n830:         self,\n831:         returns: pd.Series,\n832:         periods_per_year: int = 252,\n833:     ) -> float:\n834:         \"\"\"Compute annualized Sharpe ratio.\n835:         \n836:         Parameters\n837:         ----------\n838:         returns : pd.Series\n839:             Period returns\n840:         periods_per_year : int\n841:             Number of periods per year (252 for daily)\n842:         \n843:         Returns\n844:         -------\n845:         float\n846:             Annualized Sharpe ratio\n847:         \"\"\"\n848:         if len(returns) < 2:\n849:             return 0.0\n850:         \n851:         mean_return = returns.mean()\n852:         std_return = returns.std()\n853:         \n854:         if std_return == 0 or np.isnan(std_return):\n855:             return 0.0\n856:         \n857:         sharpe = (mean_return / std_return) * np.sqrt(periods_per_year)\n858:         \n859:         return sharpe if not np.isnan(sharpe) else 0.0\n860:     \n861:     def compute_max_drawdown(\n862:         self,\n863:         returns: pd.Series,\n864:     ) -> float:\n865:         \"\"\"Compute maximum drawdown.\n866:         \n867:         Parameters\n868:         ----------\n869:         returns : pd.Series\n870:             Period returns\n871:         \n872:         Returns\n873:         -------\n874:         float\n875:             Maximum drawdown (negative value)\n876:         \"\"\"\n877:         if len(returns) < 2:\n878:             return 0.0\n879:         \n880:         # Compute cumulative returns\n881:         cum_returns = (1 + returns).cumprod()\n882:         \n883:         # Compute running maximum\n884:         running_max = cum_returns.expanding().max()\n885:         \n886:         # Compute drawdown\n887:         drawdown = (cum_returns - running_max) / running_max\n888:         \n889:         # Return maximum drawdown (most negative)\n890:         max_dd = drawdown.min()\n891:         \n892:         return max_dd if not np.isnan(max_dd) else 0.0\n893:     \n894:     def _compute_sequential_dynamic_freq(\n895:         self,\n896:         train_df: pd.DataFrame,\n897:         available_test_df: pd.DataFrame,\n898:         base_freq: int = 7,\n899:     ) -> int:\n\n(Showing lines 750-899 of 2160. Use offset=900 to continue.)\n</content>","metadata":{"preview":"        for alpha in top_alphas:\n            if alpha in ic_df.columns:\n                daily_ics[alpha] = ic_df[alpha].reindex(dates)\n            else:\n                daily_ics[alpha] = pd.Series(dtype=float)\n\n        # Validate each alpha through Research Gate\n        gated_alphas: List[str] = []\n        for alpha in top_alphas:\n            val_ic = train_ics.get(alpha, 0.0)\n            raw_daily = daily_ics.get(alpha, pd.Series(dtype=float))\n            # Rolling mean IC series (drop NaN before rolling)\n            rolling_ic = raw_daily.dropna().rolling(window=rolling_window).mean().dropna()\n            result = validate_research_gate(val_ic, rolling_ic)\n            gate_results[alpha] = result\n            if result['passed']:\n                gated_alphas.append(alpha)\n            logger.info(\n                f\"Research Gate [{alpha}]: {result['verdict']} \"\n                f\"(val_ic={val_ic:.4f}, n_samples={result['n_samples']})\"","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\Users\\GHC\\repos\\OMEGA_QUANT\\src\\omega\\quant\\phase35_walk_forward.py","text":"        for alpha in top_alphas:\n            if alpha in ic_df.columns:\n                daily_ics[alpha] = ic_df[alpha].reindex(dates)\n            else:\n                daily_ics[alpha] = pd.Series(dtype=float)\n\n        # Validate each alpha through Research Gate\n        gated_alphas: List[str] = []\n        for alpha in top_alphas:\n            val_ic = train_ics.get(alpha, 0.0)\n            raw_daily = daily_ics.get(alpha, pd.Series(dtype=float))\n            # Rolling mean IC series (drop NaN before rolling)\n            rolling_ic = raw_daily.dropna().rolling(window=rolling_window).mean().dropna()\n            result = validate_research_gate(val_ic, rolling_ic)\n            gate_results[alpha] = result\n            if result['passed']:\n                gated_alphas.append(alpha)\n            logger.info(\n                f\"Research Gate [{alpha}]: {result['verdict']} \"\n                f\"(val_ic={val_ic:.4f}, n_samples={result['n_samples']})\"\n            )\n\n        # Fallback: if all alphas fail gate, use original top_alphas\n        if not gated_alphas:\n            logger.warning(\n                \"All alphas failed Research Gate — falling back to top_alphas \"\n                f\"({top_alphas})\"\n            )\n            gated_alphas = list(top_alphas)\n\n        logger.info(f\"Gated alphas ({len(gated_alphas)}/{len(top_alphas)}): {gated_alphas}\")\n        return gated_alphas, gate_results\n    \n    def compute_portfolio_signal(\n        self,\n        df: pd.DataFrame,\n        alpha_cols: List[str],\n        alpha_ics: Dict[str, float],\n    ) -> pd.Series:\n        \"\"\"Compute IC-weighted portfolio signal.\n        \n        Parameters\n        ----------\n        df : pd.DataFrame\n            Data with alpha columns\n        alpha_cols : list of str\n            Alpha column names to combine\n        alpha_ics : dict\n            IC weights for each alpha\n        \n        Returns\n        -------\n        pd.Series\n            Combined portfolio signal\n        \"\"\"\n        # Extract IC weights\n        weights = np.array([alpha_ics.get(col, 0.0) for col in alpha_cols])\n        \n        # Normalize weights to sum to 1\n        weight_sum = np.abs(weights).sum()\n        if weight_sum > 0:\n            weights = weights / weight_sum\n        else:\n            weights = np.ones(len(weights)) / len(weights)\n        \n        # Per-alpha z-score normalization (cross-sectional per date) BEFORE blend\n        # Prevents high-scale alphas from dominating IC-weighted combination\n        df_norm = df[alpha_cols].copy()\n        for col in alpha_cols:\n            df_norm[col] = df.groupby('date')[col].transform(\n                lambda x: (x - x.mean()) / (x.std() + 1e-9)\n            )\n        \n        # Compute weighted average on normalized alphas\n        alpha_matrix = df_norm[alpha_cols].values\n        portfolio_signal = alpha_matrix @ weights\n        \n        return pd.Series(portfolio_signal, index=df.index)\n    \n    def compute_sharpe_ratio(\n        self,\n        returns: pd.Series,\n        periods_per_year: int = 252,\n    ) -> float:\n        \"\"\"Compute annualized Sharpe ratio.\n        \n        Parameters\n        ----------\n        returns : pd.Series\n            Period returns\n        periods_per_year : int\n            Number of periods per year (252 for daily)\n        \n        Returns\n        -------\n        float\n            Annualized Sharpe ratio\n        \"\"\"\n        if len(returns) < 2:\n            return 0.0\n        \n        mean_return = returns.mean()\n        std_return = returns.std()\n        \n        if std_return == 0 or np.isnan(std_return):\n            return 0.0\n        \n        sharpe = (mean_return / std_return) * np.sqrt(periods_per_year)\n        \n        return sharpe if not np.isnan(sharpe) else 0.0\n    \n    def compute_max_drawdown(\n        self,\n        returns: pd.Series,\n    ) -> float:\n        \"\"\"Compute maximum drawdown.\n        \n        Parameters\n        ----------\n        returns : pd.Series\n            Period returns\n        \n        Returns\n        -------\n        float\n            Maximum drawdown (negative value)\n        \"\"\"\n        if len(returns) < 2:\n            return 0.0\n        \n        # Compute cumulative returns\n        cum_returns = (1 + returns).cumprod()\n        \n        # Compute running maximum\n        running_max = cum_returns.expanding().max()\n        \n        # Compute drawdown\n        drawdown = (cum_returns - running_max) / running_max\n        \n        # Return maximum drawdown (most negative)\n        max_dd = drawdown.min()\n        \n        return max_dd if not np.isnan(max_dd) else 0.0\n    \n    def _compute_sequential_dynamic_freq(\n        self,\n        train_df: pd.DataFrame,\n        available_test_df: pd.DataFrame,\n        base_freq: int = 7,\n    ) -> int:","lineStart":750,"lineEnd":899,"totalLines":2160,"truncated":true}},"title":"src\\omega\\quant\\phase35_walk_forward.py","time":{"start":1781046677089,"end":1781046677103}},"id":"prt_eaea78bd5001l0i0HIRrdcMr0n","sessionID":"ses_1515955d6ffegNRB71nAdam01t","messageID":"msg_eaea779f40012I3qLW9fnuay8v"}}
