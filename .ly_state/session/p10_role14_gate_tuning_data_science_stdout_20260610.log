tests/phase35/test_p10_multi_horizon_blend.py:709:                'train_ic': 0.2,  # Final objective train IC for h1 (low)
tests/phase35/test_p10_multi_horizon_blend.py:710:                'validation_ic': 0.15,  # Final objective validation IC for h1 (low)
tests/phase35/test_p10_multi_horizon_blend.py:711:                'final_objective_train_ic': 0.2,
tests/phase35/test_p10_multi_horizon_blend.py:712:                'final_objective_validation_ic': 0.15,
tests/phase35/test_p10_multi_horizon_blend.py:713:                'own_target_train_ic': 0.8,  # Own-target was high, but not used for weighting
tests/phase35/test_p10_multi_horizon_blend.py:714:                'own_target_validation_ic': 0.9,  # Own-target was high, but not used for weighting
tests/phase35/test_p10_multi_horizon_blend.py:717:                'train_ic': 0.7,  # Final objective train IC for h5 (high)
tests/phase35/test_p10_multi_horizon_blend.py:718:                'validation_ic': 0.85,  # Final objective validation IC for h5 (high)
tests/phase35/test_p10_multi_horizon_blend.py:719:                'final_objective_train_ic': 0.7,
tests/phase35/test_p10_multi_horizon_blend.py:720:                'final_objective_validation_ic': 0.85,
