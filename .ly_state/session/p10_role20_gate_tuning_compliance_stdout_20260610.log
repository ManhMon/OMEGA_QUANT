28: def serialize_fold_details(m):
29:     """
30:     Serialize a FoldMetrics object to a JSON-compatible dict.
31:     
32:     Includes gate_metadata and convenience aliases if present.
33:     
34:     Parameters
35:     ----------
36:     m : FoldMetrics
37:         The fold metrics object to serialize
38:         
39:     Returns
40:     -------
41:     dict
42:         JSON-serializable fold details with gate metadata if available
43:     """
44:     fold_dict = {
45:         "fold_id": m.fold_id,
46:         "train_start": m.train_start,
47:         "train_end": m.train_end,
48:         "test_start": m.test_start,
49:         "test_end": m.test_end,
50:         "portfolio_ic": m.portfolio_ic,
51:         "portfolio_sharpe": m.portfolio_sharpe,
52:         "portfolio_max_dd": m.portfolio_max_dd,
53:         "portfolio_total_return": m.portfolio_total_return,
54:         "portfolio_pnl_vnd": getattr(m, "portfolio_pnl_vnd", 0.0),
55:         "alpha_ics": m.alpha_ics,
56:         "n_train_samples": m.n_train_samples,
57:         "n_test_samples": m.n_test_samples,
58:     }
59:     
60:     # Add gate_metadata if present
61:     gate_meta = getattr(m, "gate_metadata", None)
62:     if gate_meta is not None:
63:         # Store the full gate_metadata dict
64:         fold_dict["gate_metadata"] = gate_meta
65:         
66:         # Add convenience aliases for easier access
67:         fold_dict["selection_source"] = gate_meta.get("selection_source")
68:         fold_dict["used_fallback_candidates"] = gate_meta.get("used_fallback_candidates")
69:         fold_dict["gate_passed_count"] = gate_meta.get("gate_passed_count")
70:         fold_dict["gate_total"] = gate_meta.get("gate_total")
71:         fold_dict["gate_required_passes"] = gate_meta.get("gate_required_passes")
72:         fold_dict["gate_mode"] = gate_meta.get("gate_mode")
73:         fold_dict["gate_passed_alphas"] = gate_meta.get("gate_passed_alphas")
74:     
75:     return fold_dict
