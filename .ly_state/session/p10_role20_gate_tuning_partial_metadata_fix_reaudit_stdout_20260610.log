   35: # Helper: Robust gate verdict evaluation (P10 truthiness hotfix 2026-06-09)
   36: # ---------------------------------------------------------------------------
   37: def _is_gate_verdict_pass(verdict) -> bool:
   38:     """Check if a gate verdict represents a pass.
   39:     
   40:     Parameters
   41:     ----------
   42:     verdict : any
   43:         Gate verdict value from validate_research_gate() result dict.
   44:         
   45:     Returns
   46:     -------
   47:     bool
   48:         True if verdict is a pass, False otherwise.
   49:         
   50:     Notes
   51:     -----
   52:     Pass conditions:
   53:     - Boolean True
   54:     - String exactly matching "PASS" or "APPROVED" (case-insensitive)
   55:     
   56:     Fail conditions:
   57:     - Boolean False
   58:     - String starting with "FAIL", "REJECT", "NEEDS_FIX" (case-insensitive)
   59:     - None, empty string, or missing value
   60:     - Any other string not explicitly recognized as pass
   61:     
   62:     This prevents truthiness bugs where non-empty fail strings like
   63:     "FAIL: insufficient samples" are incorrectly treated as pass.
   64:     """
   65:     # Boolean True is pass
   66:     if verdict is True:
   67:         return True
   68:     
   69:     # Boolean False, None, or missing is fail
   70:     if verdict is False or verdict is None:
   71:         return False
   72:     
   73:     # String verdict: check for explicit pass/fail markers
   74:     if isinstance(verdict, str):
   75:         verdict_upper = verdict.strip().upper()
   76:         
   77:         # Empty string is fail
   78:         if not verdict_upper:
   79:             return False
   80:         
   81:         # Explicit pass markers
   82:         if verdict_upper in ("PASS", "APPROVED"):
   83:             return True
   84:         
   85:         # Explicit fail markers
   86:         if verdict_upper.startswith(("FAIL", "REJECT", "NEEDS_FIX")):
   87:             return False
   88:         
   89:         # Any other string is treated as fail (conservative)
   90:         return False

