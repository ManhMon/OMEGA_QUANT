   55:     
   56:     Fail conditions:
   57:     - Boolean False
   58:     - String starting with "FAIL", "REJECT", "NEEDS_FIX" (case-insensitive)
   59:     - None, empty string, or missing value
   60:     - Any other string not explicitly recognized as pass
   61:     
   62:     This prevents truthiness bugs where non-empty fail strings like
   63:     "FAIL: insufficient samples" are incorrectly treated as pass.
   64:     """
   65:     # Boolean True is pass
   66:     if verdict is True:
   67:         return True
   68:     
   69:     # Boolean False, None, or missing is fail
   70:     if verdict is False or verdict is None:
   71:         return False
   72:     
   73:     # String verdict: check for explicit pass/fail markers
   74:     if isinstance(verdict, str):
   75:         verdict_upper = verdict.strip().upper()
   76:         
   77:         # Empty string is fail
   78:         if not verdict_upper:
   79:             return False
   80:         
   81:         # Explicit pass markers
