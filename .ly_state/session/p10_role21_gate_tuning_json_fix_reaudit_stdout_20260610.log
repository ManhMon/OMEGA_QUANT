  217:         cost_per_turnover : float
  218:             Stage 6.2: cost penalty multiplier per unit of turnover (default 0.0025)
  219:         drawdown_control : bool
  220:             Stage 6.3: if True, stop out to cash if max drawdown threshold is breached
  221:         drawdown_threshold : float
  222:             Stage 6.3: drawdown threshold to trigger stop-out (default 0.05)
  223:         strategy : str
