# OMEGA_QUANT Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
#
# Version: 1.0.0
# Last Updated: 2026-05-11

# ============================================================================
# GENERAL SETTINGS
# ============================================================================

# Environment (development, staging, production)
OMEGA_ENVIRONMENT=production

# Application settings
OMEGA_LOG_LEVEL=INFO
OMEGA_DEBUG=false

# ============================================================================
# DATA SOURCES
# ============================================================================

# Market data API credentials
MARKET_DATA_API_KEY=your_api_key_here
MARKET_DATA_API_SECRET=your_api_secret_here
MARKET_DATA_BASE_URL=https://api.marketdata.com/v1

# Alternative data sources
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
QUANDL_API_KEY=your_quandl_key
YAHOO_FINANCE_ENABLED=true

# Database connection (if using database for data storage)
DATABASE_URL=postgresql://user:password@localhost:5432/omega_quant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# BROKER / EXECUTION
# ============================================================================

# Broker selection (mock, interactive_brokers, alpaca, etc.)
OMEGA_BROKER=mock

# Interactive Brokers credentials (if using IB)
IB_ACCOUNT_ID=your_ib_account_id
IB_USERNAME=your_ib_username
IB_PASSWORD=your_ib_password
IB_TRADING_MODE=paper  # paper or live

# Alpaca credentials (if using Alpaca)
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets  # live trading

# ============================================================================
# RISK MANAGEMENT
# ============================================================================

# Risk limits (can override config/production.yaml)
OMEGA_MAX_PORTFOLIO_VOLATILITY=0.20
OMEGA_MAX_DRAWDOWN=0.15
OMEGA_MAX_LEVERAGE=1.0

# Stop-loss settings
OMEGA_STOP_LOSS_ENABLED=true
OMEGA_POSITION_STOP_LOSS=0.10
OMEGA_PORTFOLIO_STOP_LOSS=0.05

# ============================================================================
# MONITORING & ALERTS
# ============================================================================

# Email alerts
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_email_app_password
ALERT_EMAIL_FROM=omega_quant@yourdomain.com
ALERT_EMAIL_TO=alerts@yourdomain.com,trader@yourdomain.com

# Slack alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_SLACK_CHANNEL=#trading-alerts

# PagerDuty (for critical alerts)
PAGERDUTY_ENABLED=false
PAGERDUTY_API_KEY=your_pagerduty_key
PAGERDUTY_SERVICE_ID=your_service_id

# ============================================================================
# CLOUD STORAGE & BACKUPS
# ============================================================================

# AWS S3 (for backups and data storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=omega-quant-backups
AWS_S3_PREFIX=production

# Google Cloud Storage (alternative)
GCS_PROJECT_ID=your_gcs_project
GCS_BUCKET=omega-quant-backups
GCS_CREDENTIALS_PATH=/path/to/credentials.json

# ============================================================================
# SECURITY
# ============================================================================

# API security
OMEGA_API_KEY=your_secure_api_key_here
OMEGA_API_SECRET=your_secure_api_secret_here

# Encryption keys (for sensitive data)
OMEGA_ENCRYPTION_KEY=your_32_byte_encryption_key_base64_encoded

# JWT settings (if using authentication)
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# IP whitelist (comma-separated)
OMEGA_ALLOWED_IPS=127.0.0.1,192.168.1.0/24

# ============================================================================
# PERFORMANCE & SCALING
# ============================================================================

# Worker settings
OMEGA_NUM_WORKERS=4
OMEGA_MAX_MEMORY_GB=8.0
OMEGA_CACHE_SIZE_MB=512

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# Celery (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# COMPLIANCE & REPORTING
# ============================================================================

# Regulatory reporting
COMPLIANCE_REPORTING_ENABLED=true
COMPLIANCE_REPORT_EMAIL=compliance@yourdomain.com

# Audit trail
AUDIT_TRAIL_ENABLED=true
AUDIT_RETENTION_YEARS=7

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
OMEGA_FEATURE_ML_MODELS=false
OMEGA_FEATURE_OPTIONS_TRADING=false
OMEGA_FEATURE_CRYPTO_TRADING=false
OMEGA_FEATURE_ADVANCED_SIGNALS=true

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Testing settings (only for non-production)
OMEGA_DRY_RUN=true
OMEGA_PAPER_TRADING=true
OMEGA_MOCK_DATA=false

# Profiling
OMEGA_ENABLE_PROFILING=false
OMEGA_PROFILE_OUTPUT_DIR=data/profiles

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# News API (for sentiment analysis)
NEWS_API_KEY=your_news_api_key

# Twitter API (for social sentiment)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Generate secure random keys:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. For encryption key (32 bytes base64):
#    python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# 3. Test your configuration:
#    python scripts/health_check.py --config config/production.yaml
#
# 4. Validate environment variables:
#    python -c "from dotenv import load_dotenv; load_dotenv(); import os; print('Loaded:', len([k for k in os.environ if k.startswith('OMEGA_')]))"
#
